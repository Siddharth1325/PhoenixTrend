    private async Task LoadMarketSnapshot()
    {
        MarketSnapshot.Clear();
        var markets = new[]
        {
            (Name: "S&P 500", Symbol: "^GSPC"),
            (Name: "NASDAQ", Symbol: "^IXIC"),
            (Name: "DOW", Symbol: "^DJI"),
            (Name: "VIX", Symbol: "^VIX")
        };

        foreach (var market in markets)
        {
            try
            {
                var quote = await Api.Quote(market.Symbol);
                if (quote is null) continue;
                var price = PhoenixApi.Number(quote, "price", double.NaN);
                var change = PhoenixApi.Number(quote, "change_percent", double.NaN);
                if (double.IsNaN(change)) change = PhoenixApi.Number(quote, "change_pct", double.NaN);
                MarketSnapshot.Add(new MarketSnapshotView(
                    market.Name,
                    double.IsNaN(price) ? "—" : price.ToString("N2", System.Globalization.CultureInfo.InvariantCulture),
                    double.IsNaN(change) ? "—" : FormatPercent(change)));
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Trady AI market snapshot failed for {market.Symbol}: {ex.Message}");
            }
        }
    }

