    private static List<double> ExtractChartPoints(
        JsonElement? root)
    {
        var output =
            new List<double>();


        if (root is null)
        {
            return output;
        }


        JsonElement collection;


        if (root.Value.ValueKind ==
            JsonValueKind.Array)
        {
            collection =
                root.Value;
        }
        else if (
            root.Value.ValueKind ==
                JsonValueKind.Object &&
            root.Value.TryGetProperty(
                "data",
                out var data) &&
            data.ValueKind ==
                JsonValueKind.Array)
        {
            collection = data;
        }
        else if (
            root.Value.ValueKind ==
                JsonValueKind.Object &&
            root.Value.TryGetProperty(
                "candles",
                out var candles) &&
            candles.ValueKind ==
                JsonValueKind.Array)
        {
            collection = candles;
        }
        else if (
            root.Value.ValueKind ==
                JsonValueKind.Object &&
            root.Value.TryGetProperty(
                "bars",
                out var bars) &&
            bars.ValueKind ==
                JsonValueKind.Array)
        {
            collection = bars;
        }
        else
        {
            return output;
        }


        foreach (var item in
                 collection.EnumerateArray())
        {
            if (item.ValueKind !=
                JsonValueKind.Object)
            {
                continue;
            }


            var close =
                ReadNumber(
                    item,
                    "close"
                );


            if (double.IsNaN(close))
            {
                close =
                    ReadNumber(
                        item,
                        "price"
                    );
            }


            if (!double.IsNaN(close))
            {
                output.Add(close);
            }
        }


        return output;
    }


    private static string BuildPolyline(
        List<double> points)
    {
        if (points.Count < 2)
        {
            return string.Empty;
        }


        var min =
            points.Min();

        var max =
            points.Max();

        var range =
            max - min;


        if (range <= 0)
        {
            range = 1;
        }


        var values =
            new List<string>();


        for (var i = 0;
             i < points.Count;
             i++)
        {
            var x =
                i /
                (double)(points.Count - 1)
                * 1000;


            var normalized =
                (points[i] - min)
                / range;


            var y =
                390 -
                normalized * 350;


            values.Add(
                $"{x:0.##},{y:0.##}"
            );
        }


        return string.Join(
            " ",
            values
        );
    }


    private static string GetFallbackCandleStyle(
        int index)
    {
        var x =
            index * 1.78;

        var y =
            68 -
            index * .7 +
            index % 8 * 2;

        var height =
            16 +
            index % 5 * 5;


        return
            $"--x:{x}%;--y:{y}%;--h:{height}px";
    }


    // =========================================================
    // JSON HELPERS
    // =========================================================

    private static bool TryGetArray(
        JsonElement root,
        out JsonElement array)
    {
        if (root.ValueKind ==
            JsonValueKind.Array)
        {
            array = root;

            return true;
        }


        if (root.ValueKind ==
            JsonValueKind.Object)
        {
            var names =
                new[]
                {
                    "data",
                    "results",
                    "items",
                    "opportunities",
                    "discover",
                    "positions",
                    "news"
                };


            foreach (var name in names)
            {
                if (root.TryGetProperty(
                        name,
                        out var candidate) &&
                    candidate.ValueKind ==
                        JsonValueKind.Array)
                {
                    array = candidate;

                    return true;
                }
            }
        }


        array = default;

        return false;
    }


    private static double ReadNumber(
        JsonElement? root,
        string property)
    {
        if (root is null)
        {
            return double.NaN;
        }


        return ReadNumber(
            root.Value,
            property
        );
    }


    private static double ReadNumber(
        JsonElement root,
        string property)
    {
        if (root.ValueKind !=
                JsonValueKind.Object ||
            !root.TryGetProperty(
                property,
                out var value))
        {
            return double.NaN;
        }


        if (value.ValueKind ==
                JsonValueKind.Number &&
            value.TryGetDouble(
                out var number))
        {
            return number;
        }


        return double.TryParse(
            value.ToString(),
            out number)
                ? number
                : double.NaN;
    }


    private static string ReadString(
        JsonElement root,
        string property,
        string fallback)
    {
        if (root.ValueKind !=
                JsonValueKind.Object ||
            !root.TryGetProperty(
                property,
                out var value))
        {
            return fallback;
        }


        return value.ValueKind ==
               JsonValueKind.String
            ? value.GetString()
              ?? fallback
            : value.ToString();
    }


    private static string ReadContextPrice(
        JsonElement? root,
        string property)
    {
        return FormatPrice(
            ReadNumber(
                root,
                property
            )
        );
    }


    private static string ReadContextNumber(
        JsonElement? root,
        string property)
    {
        var value =
            ReadNumber(
                root,
                property
            );


        return double.IsNaN(value)
            ? "—"
            : value.ToString("0.00");
    }


    private static string ExtractPattern(
        JsonElement? result)
    {
        if (result is null)
        {
            return "—";
        }


        JsonElement items;


        if (result.Value.ValueKind ==
            JsonValueKind.Array)
        {
            items =
                result.Value;
        }
        else if (
            result.Value.ValueKind ==
                JsonValueKind.Object &&
            result.Value.TryGetProperty(
                "patterns",
                out var patterns) &&
            patterns.ValueKind ==
                JsonValueKind.Array)
        {
            items = patterns;
        }
        else
        {
            return "—";
        }


        foreach (var item in
                 items.EnumerateArray())
        {
            var name =
                ReadString(
                    item,
                    "name",
                    ""
                );


            if (string.IsNullOrWhiteSpace(
                name))
            {
                name =
                    ReadString(
                        item,
                        "pattern",
                        ""
                    );
            }


            if (!string.IsNullOrWhiteSpace(
                name))
            {
                return name;
            }
        }


        return "—";
    }


    private static string ExtractFirstHeadline(
        JsonElement? result)
    {
        if (result is null ||
            !TryGetArray(
                result.Value,
                out var items))
        {
            return string.Empty;
        }


        foreach (var item in
                 items.EnumerateArray())
        {
            var title =
                ReadString(
                    item,
                    "title",
                    ""
                );


            if (string.IsNullOrWhiteSpace(
                title))
            {
                title =
                    ReadString(
                        item,
                        "headline",
                        ""
                    );
            }


            if (!string.IsNullOrWhiteSpace(
                title))
            {
                return $"Latest news: {title}";
            }
        }


        return string.Empty;
    }


    private static int CountArrayItems(
        JsonElement? result)
    {
        if (result is null ||
            !TryGetArray(
                result.Value,
                out var items))
        {
            return 0;
        }


        return items
            .EnumerateArray()
            .Count();
    }


    private static double CalculateExposure(
        JsonElement? result)
    {
        if (result is null ||
            !TryGetArray(
                result.Value,
                out var items))
        {
            return 0;
        }


        double total = 0;


        foreach (var item in
                 items.EnumerateArray())
        {
            var value =
                ReadNumber(
                    item,
                    "market_value"
                );


            if (!double.IsNaN(value))
            {
                total +=
                    Math.Abs(value);
            }
        }


        return total;
    }


