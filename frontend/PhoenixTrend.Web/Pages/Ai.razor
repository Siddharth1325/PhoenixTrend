    private static string FormatMoney(
        double value)
    {
        return double.IsNaN(value)
            ? "—"
            : value.ToString(
                "$#,##0.00"
            );
    }


    private static string FormatSignedMoney(
        double value)
    {
        return double.IsNaN(value)
            ? "—"
            : value.ToString(
                "+$#,##0.00;-$#,##0.00;$0.00"
            );
    }


    private static string FormatPrice(
        double value)
    {
        return double.IsNaN(value)
            ? "—"
            : value.ToString(
                "$#,##0.00"
            );
    }


    private static string FormatPercent(
        double value)
    {
        return double.IsNaN(value)
            ? "—"
            : $"{value:+0.00;-0.00;0.00}%";
    }


    private static string FormatPercentAuto(
        double value)
    {
        if (double.IsNaN(value))
        {
            return "—";
        }


        if (Math.Abs(value) <= 1)
        {
            value *= 100;
        }


        return $"{value:+0.00;-0.00;0.00}%";
    }


    private static string FormatConfidence(
        double value)
    {
        if (double.IsNaN(value))
        {
            return "—";
        }


        if (Math.Abs(value) <= 1)
        {
            value *= 100;
        }


        return $"{value:0}%";
    }


    private static string FormatScore(
        double value)
    {
        if (double.IsNaN(value))
        {
            return "—";
        }


        if (Math.Abs(value) <= 1)
        {
            value *= 100;
        }


        return value.ToString("0");
    }


    private static string GetChangeClass(
        string value)
    {
        if (string.IsNullOrWhiteSpace(
                value) ||
            value == "—")
        {
            return "";
        }


        return value
            .TrimStart()
            .StartsWith("-")
                ? "red"
                : "green";
    }


    private static string GetSignalClass(
        string signal)
    {
        if (signal.Equals(
            "BUY",
            StringComparison.OrdinalIgnoreCase) ||
            signal.Equals(
                "BULLISH",
                StringComparison.OrdinalIgnoreCase))
        {
            return "pill green";
        }


        if (signal.Equals(
            "SELL",
            StringComparison.OrdinalIgnoreCase) ||
            signal.Equals(
                "BEARISH",
                StringComparison.OrdinalIgnoreCase))
        {
            return "pill red";
        }


        return "pill blue";
    }


    private static string GetSignalTextClass(
        string signal)
    {
        if (signal.Equals(
                "BUY",
                StringComparison.OrdinalIgnoreCase) ||
            signal.Equals(
                "BULLISH",
                StringComparison.OrdinalIgnoreCase))
        {
            return "green";
        }


        if (signal.Equals(
                "SELL",
                StringComparison.OrdinalIgnoreCase) ||
            signal.Equals(
                "BEARISH",
                StringComparison.OrdinalIgnoreCase))
        {
            return "red";
        }


        return "";
    }


