    private static string ExtractSymbol(
        string input)
    {
        var tokens =
            System.Text.RegularExpressions.Regex
                .Matches(
                    input.ToUpperInvariant(),
                    @"\b[A-Z]{1,5}\b"
                )
                .Select(
                    x => x.Value
                )
                .ToList();


        var ignored =
            new HashSet<string>
            {
                "I",
                "AI",
                "THE",
                "FOR",
                "AND",
                "WITH",
                "SHOW",
                "FIND",
                "BEST",
                "TRADE",
                "STOCK",
                "STOCKS",
                "ANALYZE",
                "ANALYSIS",
                "MARKET",
                "SWING",
                "ENTRY",
                "TARGET",
                "STOP",
                "LOSS",
                "RISK",
                "MY"
            };


        return tokens
            .FirstOrDefault(
                x => !ignored.Contains(x)
            )
            ?? string.Empty;
    }


