}


<!-- =========================================================
     RISK ANALYTICS
     ========================================================= -->

@if (ActiveTab == "Risk Analytics")
{
    <div class="dashboard-grid">

        <Panel Title="Risk Metrics">

            <div class="status-list">

                <div>
                    <span>Maximum Drawdown</span>
                    <b class="red">@MaxDrawdown</b>
                </div>

                <div>
                    <span>Sharpe Ratio</span>
                    <b>@SharpeRatio</b>
                </div>

                <div>
                    <span>Sortino Ratio</span>
                    <b>@SortinoRatio</b>
                </div>

                <div>
                    <span>Profit Factor</span>
                    <b>@ProfitFactor</b>
                </div>

                <div>
                    <span>Win Rate</span>
                    <b>@WinRate</b>
                </div>

            </div>

        </Panel>


        <Panel
            Title="Risk Performance"
            Class="span-2">

            <div class="performance-kpis">

                <span>
                    <b>@TotalReturn</b>
                    Total Return
                </span>

                <span>
                    <b>@TotalPnl</b>
                    Total P&amp;L
                </span>

                <span>
                    <b>@ProfitFactor</b>
                    Profit Factor
                </span>

                <span>
                    <b>@SharpeRatio</b>
                    Sharpe
                </span>

                <span>
                    <b class="red">@MaxDrawdown</b>
                    Drawdown
                </span>

            </div>

        </Panel>

