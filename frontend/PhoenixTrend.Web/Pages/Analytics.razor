@page "/analytics"
@page "/portfolio/analytics"

@inject PhoenixApi Api

<PageTitle>PhoenixTrend | Analytics</PageTitle>

<div class="pt-analytics">

<PortfolioTabs />


<PageHero
    Title="Analytics"
    Subtitle="Deep insights into your trading performance, strategies, risk, portfolio and opportunities."
    Action="Refresh"
    OnAction="Load" />


<!-- =========================================================
     TABS
     ========================================================= -->

<div class="tabbar">

    @foreach (var tab in Tabs)
    {
        <button
            class="@(ActiveTab == tab ? "active" : "")"
            @onclick="() => SelectTab(tab)">

            @tab

        </button>
    }

</div>


@if (Loading)
{
    <div class="connect-message">
        Loading analytics...
    </div>
}


@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="connect-message">
        @ErrorMessage
    </div>
}


<!-- =========================================================
     TOP METRICS
     ========================================================= -->

<div class="metric-grid five">

    <MetricCard
        Icon="ph ph-currency-dollar"
        Label="Total P&L"
        Value="@TotalPnl"
        Detail="@TotalReturn" />

    <MetricCard
        Icon="ph ph-target"
        Label="Win Rate"
        Value="@WinRate"
        Detail="@($"{WinningTrades} winning trades")" />

    <MetricCard
        Icon="ph ph-chart-bar"
        Label="Total Trades"
        Value="@TotalTrades"
        Detail="@($"{LosingTrades} losing trades")"
        Tone="purple" />

    <MetricCard
        Icon="ph ph-trend-up"
        Label="Profit Factor"
        Value="@ProfitFactor"
        Detail="Trading performance"
        Tone="blue" />

    <MetricCard
        Icon="ph ph-trend-down"
        Label="Max Drawdown"
        Value="@MaxDrawdown"
        Detail="Portfolio drawdown"
        Tone="negative" />

</div>


<!-- =========================================================
     PERFORMANCE
     ========================================================= -->

@if (ActiveTab == "Performance")
{
    <div class="analytics-layout">

        <Panel
            Title="Equity Curve"
            Subtitle="Portfolio performance from available analytics data"
            Class="span-2">

            <div class="hero-chart">

                <div class="chart-grid"></div>

                @if (EquityPoints.Count > 1)
                {
                    <svg
                        viewBox="0 0 900 260"
                        preserveAspectRatio="none">

                        <polyline
                            class="line"
                            points="@BuildPolyline(EquityPoints, 900, 260)" />

                    </svg>
                }
                else
                {
                    <div class="connect-message">
                        Historical equity-series data is not currently available.
                    </div>
                }

            </div>

        </Panel>


        <Panel Title="Performance Metrics">

            <div class="metrics-columns">

                <div>

                    <span>
                        Total Return
                        <b>@TotalReturn</b>
                    </span>

                    <span>
                        Annualized Return
                        <b>@AnnualizedReturn</b>
                    </span>

                    <span>
                        Sharpe Ratio
                        <b>@SharpeRatio</b>
                    </span>

                    <span>
                        Sortino Ratio
                        <b>@SortinoRatio</b>
                    </span>

                    <span>
                        Profit Factor
                        <b>@ProfitFactor</b>
                    </span>

                </div>


                <div>

                    <span>
                        Total Trades
                        <b>@TotalTrades</b>
                    </span>

                    <span>
                        Winning Trades
                        <b>@WinningTrades</b>
                    </span>

                    <span>
                        Losing Trades
                        <b>@LosingTrades</b>
                    </span>

                    <span>
                        Average Win
                        <b>@AverageWin</b>
                    </span>

                    <span>
                        Max Drawdown
                        <b class="red">@MaxDrawdown</b>
                    </span>

                </div>

            </div>

        </Panel>


        <Panel
            Title="Strategy Performance"
            Class="span-2">

            <table class="data-table">
                <thead>
                    <tr>
                        <th>Strategy</th>
                        <th>Trades</th>
                        <th>Win Rate</th>
                        <th>P&amp;L</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Strategies.Count == 0)
                    {
                        <tr>
                            <td colspan="4">
                                No strategy performance data is available.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var strategy in Strategies)
                        {
                            <tr>
                                <td>
                                    <strong>@strategy.Strategy</strong>
                                </td>

                                <td>@strategy.Trades</td>

                                <td>@strategy.WinRate</td>

                                <td class="@GetValueClass(strategy.Pnl)">
                                    @strategy.Pnl
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </Panel>


        <Panel Title="Trade Distribution">

            <div class="donut">

                <div>

                    <b>
                        @TotalTrades
                    </b>

                    <small>
                        Trades
                    </small>

                </div>

            </div>


            <div class="legend">

                <span>

                    <i class="c1"></i>

                    Winning

                    <b>
                        @WinningTrades
                    </b>

                </span>


                <span>

                    <i class="c4"></i>

                    Losing

                    <b>
                        @LosingTrades
                    </b>

                </span>

            </div>

        </Panel>


        <Panel
            Title="Recent Trade P&L"
            Class="span-2">

            <table class="data-table">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Symbol</th>
                        <th>Side</th>
                        <th>Strategy</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>P&amp;L</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Trades.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                No executed trade data is available.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var trade in Trades.Take(50))
                        {
                            <tr>
                                <td>@trade.Time</td>

                                <td>
                                    <strong>@trade.Symbol</strong>
                                </td>

                                <td class="@GetSideClass(trade.Side)">
                                    @trade.Side
                                </td>

                                <td>@trade.Strategy</td>

                                <td>@trade.Quantity</td>

                                <td>@trade.Price</td>

                                <td class="@GetValueClass(trade.Pnl)">
                                    @trade.Pnl
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </Panel>

    </div>
}


<!-- =========================================================
     STRATEGY ANALYTICS
     ========================================================= -->

@if (ActiveTab == "Strategy Analytics")
{
    <Panel
        Title="Strategy Analytics"
        Subtitle="Performance grouped by strategy from available activity records">

        <table class="data-table">
            <thead>
                <tr>
                    <th>Strategy</th>
                    <th>Trades</th>
                    <th>Win Rate</th>
                    <th>P&amp;L</th>
                </tr>
            </thead>

            <tbody>
                @if (Strategies.Count == 0)
                {
                    <tr>
                        <td colspan="4">
                            No strategy performance data is available.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var strategy in Strategies)
                    {
                        <tr>
                            <td>
                                <strong>@strategy.Strategy</strong>
                            </td>

                            <td>@strategy.Trades</td>

                            <td>@strategy.WinRate</td>

                            <td class="@GetValueClass(strategy.Pnl)">
                                @strategy.Pnl
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

    </Panel>
}


<!-- =========================================================
     TRADE ANALYSIS
     ========================================================= -->

@if (ActiveTab == "Trade Analysis")
{
    <div class="dashboard-grid">

        <Panel Title="Trade Statistics">

            <div class="status-list">

                <div>
                    <span>Total Trades</span>
                    <b>@TotalTrades</b>
                </div>

