    private async Task ToggleSection(string assetClass)

    {

        if (string.IsNullOrWhiteSpace(assetClass))

            return;



        var state = SectionFor(assetClass);



        if (state?.Supported != true)

        {

            ErrorMessage = state?.Reason

                ?? $"{DisplayAsset(assetClass)} automation is unavailable.";

            return;

        }



        if (SectionBusy is not null)

            return;



        SectionBusy = assetClass;

        ClearMessages();



        try

        {

            if (state.Enabled)

            {

                await Api.DisableAutomationAssetSection(assetClass);

                SuccessMessage = $"{DisplayAsset(assetClass)} automation disabled.";

            }

            else

            {

                await Api.EnableAutomationAssetSection(assetClass);

                SuccessMessage = $"{DisplayAsset(assetClass)} automation enabled.";

            }



            await LoadData();

        }

        catch (Exception ex)

        {

            ErrorMessage = ex.Message;

        }

        finally

        {

            SectionBusy = null;

        }

    }



