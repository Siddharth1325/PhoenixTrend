        return "ph ph-minus-circle";
    }

    private static string ActionClass(string? action)
    {
        var value = (action ?? string.Empty).Trim().ToUpperInvariant();

        if (value.Contains("BUY"))
            return "auto-runtime-action buy";

        if (value.Contains("SELL"))
            return "auto-runtime-action sell";

        if (value.Contains("HOLD") || value.Contains("WAIT"))
            return "auto-runtime-action hold";

        return "auto-runtime-action neutral";
    }

    private static string DisplayActivityState(string? state)
    {
        var value = (state ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(value))
            return "MONITORING";

        var upper = value.ToUpperInvariant();

        if (upper.Contains("CHAIN") && upper.Contains("FAIL"))
            return "CHAIN FAILED";

        if (upper.Contains("EXEC"))
            return "EXECUTING";

        if (upper.Contains("DECISION"))
            return "DECISION";

        if (upper.Contains("SCAN") && upper.Contains("COMP"))
            return "SCAN COMPLETE";

        if (upper.Contains("SCAN"))
            return "SCANNING";

        if (upper.Contains("RISK"))
            return "RISK CHECK";

        if (upper.Contains("ORDER") && upper.Contains("SUBMIT"))
            return "ORDER SUBMITTED";

        if (upper.Contains("ERROR") || upper.Contains("FAIL"))
            return "FAILED";

        return upper.Replace('_', ' ');
    }

    private static string StateClass(string? state)
    {
        var value = (state ?? string.Empty).Trim().ToUpperInvariant();

        if (value.Contains("FAIL") || value.Contains("ERROR"))
            return "failed";

        if (value.Contains("EXEC") || value.Contains("ORDER"))
            return "executing";

        if (value.Contains("DECISION"))
            return "decision";

        if (value.Contains("SCAN"))
            return "scanning";

        if (value.Contains("RISK"))
            return "risk";

        return "monitoring";
    }

