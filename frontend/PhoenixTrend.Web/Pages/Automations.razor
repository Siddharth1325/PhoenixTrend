@page "/automations"



@using System.Globalization

@using System.Text.Json

@implements IAsyncDisposable



@inject PhoenixTrend.Web.Services.PhoenixApi Api

@inject IJSRuntime JS

@inject NavigationManager Navigation



<PageTitle>Automations | PhoenixTrend</PageTitle>



<div class="pt-automations">



    <section class="auto-hero">

        <div class="auto-hero-content">



            <div class="auto-hero-copy">

                <div class="auto-eyebrow">

                    <i class="ph ph-cpu"></i>

                    PHOENIXTREND AUTOMATIC TRADING ENGINE

                </div>



                <h1>Automations</h1>



                <p>

                    Configure, launch and monitor automated trading strategies

                    across multiple asset classes with enterprise-grade reliability.

                </p>



                <div class="auto-hero-pills">

                    <span class="auto-pill">

                        <i></i>

                        Engine @EngineState

                    </span>



                    <span class="auto-pill">

                        @EnabledSectionCount Sections On

                    </span>



                    <span class="auto-pill">

                        @RunningCount Running

                    </span>



                    <span class="auto-pill">

                        @TotalOrders Orders

                    </span>

                </div>

            </div>







        </div>

    </section>



    @if (!string.IsNullOrWhiteSpace(ErrorMessage))

    {

        <div class="auto-alert error">

            <span>@ErrorMessage</span>



            <button type="button"

                    @onclick="ClearMessages">

                ×

            </button>

        </div>

    }



    @if (!string.IsNullOrWhiteSpace(SuccessMessage))

    {

        <div class="auto-alert success">

            <span>@SuccessMessage</span>



            <button type="button"

                    @onclick="ClearMessages">

                ×

            </button>

        </div>

    }



    <nav class="auto-section-nav"

         aria-label="Automation sections">



        @foreach (var navItem in NavigationSections)

        {

            var sectionKey = navItem.Key;

            var assetClass = navItem.AssetClass;



            <button type="button"

                    class="@NavClass(sectionKey)"

                    data-auto-section="@JsSectionName(sectionKey)"

                    @onclick="() => OpenSection(sectionKey)">



                <span class="auto-nav-icon">

                    <i class="@navItem.Icon"></i>

                </span>



                <span>@navItem.Label</span>



                @if (assetClass is not null)

                {

                    <i class="@CapabilityDotClass(assetClass)"

                       title="@CapabilityText(assetClass)">

                    </i>

                }



            </button>

        }



    </nav>



    @if (Loading)

    {

        <section class="auto-loading-panel">

            <div class="auto-loader"></div>



            <strong>

                Loading automatic trading engine

            </strong>

        </section>

    }

    else if (ActiveSection == "ENGINE")

    {

        <section class="auto-section">



            <div class="auto-engine-shell">



                <div class="auto-engine-main">



                    <div class="auto-engine-command">



                        <div class="auto-engine-command-copy">

                            <span>MASTER CONTROL CENTER</span>



                            <strong>

                                Automatic Trading Engine

                            </strong>



                            <small>

                                Each asset section runs independently.

                                Turning a section ON starts its automations automatically.

                                Turning it OFF stops new automated activity.

                            </small>

                        </div>



                        <div class="auto-master-action">



                            <div class="auto-master-state">



                                <i class="ph @(EngineState == "RUNNING"

                                    ? "ph-check-circle"

                                    : "ph-warning-octagon")">

                                </i>



                                <span>

                                    <b>ENGINE @EngineState</b>

                                    <small>@EngineDescription</small>

                                </span>



                            </div>



                            @if (EngineState == "RUNNING")

                            {

                                <button type="button"

                                        class="auto-start-btn stop"

                                        disabled="@EngineBusy"

                                        @onclick="StopEngine">



                                    <i class="ph ph-stop"></i>

                                    Stop Engine



                                </button>

                            }

                            else if (EngineState == "EMERGENCY_STOP")

                            {

                                <button type="button"

                                        class="auto-start-btn"

                                        disabled>



                                    <i class="ph ph-warning-octagon"></i>

                                    Emergency Stop Active



                                </button>

                            }

                            else

                            {

                                <button type="button"

                                        class="auto-start-btn"

                                        disabled="@EngineBusy"

                                        @onclick="StartEngine">



                                    <i class="ph ph-play"></i>

                                    Start Engine



                                </button>

                            }



                        </div>

                    </div>



                    <div class="auto-engine-metrics">



                        <article>

                            <span class="auto-metric-icon">

                                <i class="ph ph-plugs-connected"></i>

                            </span>



                            <span class="auto-metric-copy">

                                <span>Broker Connection</span>



                                <strong class="@(BrokerConnected ? "good" : "bad")">

                                    @(BrokerConnected

                                        ? "CONNECTED"

                                        : "DISCONNECTED")

                                </strong>

                            </span>

                        </article>



                        <article>

                            <span class="auto-metric-icon">

                                <i class="ph ph-chart-line-up"></i>

                            </span>



                            <span class="auto-metric-copy">

                                <span>Sections On</span>

                                <strong>@EnabledSectionCount</strong>

                            </span>

                        </article>



                        <article>

                            <span class="auto-metric-icon">

                                <i class="ph ph-play-circle"></i>

                            </span>



                            <span class="auto-metric-copy">

                                <span>Running</span>

                                <strong>@RunningCount</strong>

                            </span>

                        </article>



                        <article>

                            <span class="auto-metric-icon">

                                <i class="ph ph-gear-six"></i>

                            </span>



                            <span class="auto-metric-copy">

                                <span>Automations</span>

                                <strong>@AutomationItems.Count</strong>

                            </span>

                        </article>



                        <article>

                            <span class="auto-metric-icon">

                                <i class="ph ph-file-text"></i>

                            </span>



                            <span class="auto-metric-copy">

                                <span>Orders</span>

                                <strong>@TotalOrders</strong>

                            </span>

                        </article>



                    </div>



                    <div class="auto-engine-layout">



                        <article class="auto-panel">



                            <header class="auto-panel-header">

                                <div>

                                    <h3>Asset Engines</h3>



                                    <span>

                                        Enable or disable each asset class.

                                        Each section runs independently.

                                    </span>

                                </div>



                                <small>

                                    @EnabledSectionCount enabled

                                </small>

                            </header>



                            <div class="auto-engine-assets">



                                @foreach (var asset in AssetNavigation)

                                {

                                    var cls = asset.AssetClass!;

                                    var state = SectionFor(cls);

                                    var supported = IsSupported(cls);

                                    var enabled = state?.Enabled == true;

                                    var running = state?.RunningAutomations > 0;

                                    var key = asset.Key;



                                    <div class="@EngineAssetClass(enabled, running)"

                                         data-asset-section="@JsSectionName(cls)"

                                         data-section-enabled="@(enabled ? "true" : "false")">



                                        <button type="button"

                                                class="auto-engine-asset-main"

                                                @onclick="() => OpenSection(key)">



                                            <span class="auto-engine-asset-icon">

                                                <i class="@asset.Icon"></i>

                                            </span>



                                            <span class="auto-engine-asset-copy">

                                                <strong>@asset.Label</strong>

                                                <small>@SectionDescription(cls)</small>

                                            </span>



                                        </button>



                                        <div class="auto-section-toggle-wrap">



                                            <span class="auto-section-toggle-label">

                                                @(!supported

                                                    ? "UNAVAILABLE"

                                                    : enabled

                                                        ? "ON"

                                                        : "OFF")

                                            </span>



                                            <button type="button"

                                                    class="@SwitchClass(enabled)"

                                                    role="switch"

                                                    aria-checked="@enabled"

                                                    aria-label="@($"{asset.Label} automation section")"

                                                    disabled="@(!supported || SectionBusy == cls)"

                                                    @onclick="() => ToggleSection(cls)">



                                                <span></span>



                                            </button>



                                        </div>



                                    </div>

                                }



                            </div>



                        </article>



                        <article class="auto-panel">



                            <header class="auto-panel-header">

                                <div>

                                    <h3>Engine Activity</h3>



                                    <span>

                                        Current runtime status and active automations.

                                    </span>

                                </div>



                                <small>

                                    View All Activity →

                                </small>

                            </header>



                            <div class="auto-runtime-table">



                                <div class="auto-runtime-row head">

                                    <span>Automation</span>

                                    <span>Asset</span>

                                    <span>Symbol</span>

                                    <span>Strategy</span>

                                    <span>Action</span>

                                    <span>State</span>

                                    <span>Runtime</span>

                                </div>



                                @if (AssetActivityItems.Count == 0)

                                {

                                    <div class="auto-empty-runtime">

                                        <i class="ph ph-activity"></i>

                                        <strong>@(RunningCount > 0 ? "Asset engines are running and waiting for the next market event." : "No asset automation runtime is active.")</strong>

                                        <span>@(RunningCount > 0 ? "Live scan, decision, risk and execution events will appear here automatically." : "Enable an asset section and start the engine.")</span>

                                    </div>

                                }

                                else

                                {

                                    @foreach (var activity in AssetActivityItems.Take(20))

                                    {

                                        <div class="auto-runtime-row" data-runtime-state="@activity.RuntimeState">

                                            <span class="auto-runtime-automation">
                                                <i class="@AssetIconClass(activity.AssetClass)"></i>
                                                <span>@($"{DisplayAsset(activity.AssetClass)} Engine")</span>
                                            </span>

                                            <span>@DisplayAsset(activity.AssetClass)</span>

                                            <span class="auto-runtime-symbol">
                                                @if (!string.IsNullOrWhiteSpace(activity.Symbol))
                                                {
                                                    <StockLogo Symbol="@activity.Symbol" Size="small" />
                                                    <strong>@activity.Symbol</strong>
                                                }
                                                else
                                                {
                                                    <span class="auto-runtime-dash">—</span>
                                                }
                                            </span>

                                            <span>@Dash(activity.Strategy)</span>

                                            <span class="@ActionClass(activity.Action)">
                                                <i class="@ActionIconClass(activity.Action)"></i>
                                                @Dash(activity.Action)
                                            </span>

                                            <span>
                                                <b class="auto-state-badge @StateClass(activity.State)">
                                                    @DisplayActivityState(activity.State)
                                                </b>
                                            </span>

                                            <span>
                                                <b class="auto-runtime-badge">@activity.RuntimeState</b>
                                            </span>

                                        </div>

                                    }

                                }

                            </div>



                        </article>



                    </div>



                </div>



                <aside class="auto-side-stack">



                    <section class="auto-side-card emergency">



                        <div class="auto-side-title">

                            Emergency Controls

                        </div>



                        <div class="auto-emergency-body">



                            <div class="auto-emergency-head">

                                <i class="ph ph-warning-octagon"></i>



                                <span>

                                    <b>Emergency Stop</b>



                                    <small>

                                        Immediately stop all automation runtimes

                                        across all asset sections.

                                    </small>

                                </span>

                            </div>



                            @if (EngineState == "EMERGENCY_STOP")

                            {

                                <button type="button"

                                        class="auto-emergency-btn reset"

                                        disabled="@EngineBusy"

                                        @onclick="ClearEmergencyStop">



                                    <i class="ph ph-arrow-counter-clockwise"></i>

                                    Reset Emergency Stop



                                </button>

                            }

                            else

                            {

                                <button type="button"

                                        class="auto-emergency-btn"

                                        disabled="@EngineBusy"

                                        @onclick="EmergencyStop">



                                    <i class="ph ph-stop-fill"></i>

                                    Stop All Automations



                                </button>

                            }



                        </div>



                    </section>



                    <section class="auto-side-card">



                        <div class="auto-side-title auto-system-head">

                            <span>System Status</span>



                            <span class="auto-live">

                                <i class="ph ph-circle-fill"></i>

                                Live

                            </span>

                        </div>



                        <div class="auto-status-row">

                            <span class="auto-status-label">

                                <i class="ph ph-flask"></i>

                                Engine State

                            </span>



                            <b class="@(EngineState == "RUNNING" ? "good" : "bad")">

                                @EngineState

                            </b>

                        </div>



                        <div class="auto-status-row">

                            <span class="auto-status-label">

                                <i class="ph ph-compass"></i>

                                Broker Connection

                            </span>



                            <b class="@(BrokerConnected ? "good" : "bad")">

                                @(BrokerConnected

                                    ? "Connected"

                                    : "Disconnected")

                            </b>

                        </div>



                        <div class="auto-status-row">

                            <span class="auto-status-label">

                                <i class="ph ph-chart-line-up"></i>

                                Active Sections

                            </span>



                            <b>

                                @EnabledSectionCount / @AssetNavigation.Count()

                            </b>

                        </div>



                        <div class="auto-status-row">

                            <span class="auto-status-label">

                                <i class="ph ph-flow-arrow"></i>

                                Running Automations

                            </span>



                            <b>@RunningCount</b>

                        </div>



                        <div class="auto-status-row">

                            <span class="auto-status-label">

                                <i class="ph ph-record"></i>

                                Open Orders

                            </span>



                            <b>@TotalOrders</b>

                        </div>



                    </section>



                </aside>



            </div>



        </section>

    }

    else if (ActiveSection == "ACTIVITY")

    {

        <section class="auto-section">

            <div class="auto-section-header">

                <div>

                    <span>LIVE AUTOMATION MONITOR</span>

                    <h2>Automation Activity</h2>

                    <p>Runtime state, latest symbols, strategy decisions and submitted order requests.</p>

                </div>

                <span class="auto-live-indicator"><i class="ph ph-broadcast"></i> Live</span>

            </div>



            <div class="auto-panel">

                <div class="auto-runtime-table">

                    <div class="auto-runtime-row head">

                        <span>Automation</span><span>Asset</span><span>Symbol</span><span>Strategy</span><span>Action</span><span>State</span><span>Orders</span>

                    </div>

                    @if (AssetActivityItems.Count == 0)

                    {

                        <div class="auto-empty"><i class="ph ph-activity"></i><strong>@(RunningCount > 0 ? "Asset engines are running and waiting for market activity." : "No asset runtime activity yet.")</strong><span>Live backend events appear here automatically.</span></div>

                    }

                    else

                    {

                        @foreach (var activity in AssetActivityItems)

                        {

                            <div class="auto-runtime-row" data-runtime-state="@activity.RuntimeState">

                                <span class="auto-runtime-automation">
                                    <i class="@AssetIconClass(activity.AssetClass)"></i>
                                    <span>@($"{DisplayAsset(activity.AssetClass)} Engine")</span>
                                </span>

                                <span>@DisplayAsset(activity.AssetClass)</span>

                                <span class="auto-runtime-symbol">
                                    @if (!string.IsNullOrWhiteSpace(activity.Symbol))
                                    {
                                        <StockLogo Symbol="@activity.Symbol" Size="small" />
                                        <strong>@activity.Symbol</strong>
                                    }
                                    else
                                    {
                                        <span class="auto-runtime-dash">—</span>
                                    }
                                </span>

                                <span>@Dash(activity.Strategy)</span>

                                <span class="@ActionClass(activity.Action)">
                                    <i class="@ActionIconClass(activity.Action)"></i>
                                    @Dash(activity.Action)
                                </span>

                                <span>
                                    <b class="auto-state-badge @StateClass(activity.State)">
                                        @DisplayActivityState(activity.State)
                                    </b>
                                </span>

                                <span>
                                    <b class="auto-runtime-badge">@activity.RuntimeState</b>
                                </span>

                            </div>

                        }

                    }

                </div>

            </div>

        </section>

    }

    else

    {

        var nav = NavigationSections.FirstOrDefault(x =>

            string.Equals(x.Key, ActiveSection, StringComparison.OrdinalIgnoreCase));

        var assetClass = nav?.AssetClass ?? string.Empty;

        var section = SectionFor(assetClass);

        var assetAutomations = AutomationsFor(assetClass).ToList();



        <section class="auto-section">

            <div class="auto-section-header">

                <div>

                    <span>@(DisplayAsset(assetClass).ToUpperInvariant()) AUTOMATION</span>

                    <h2>@DisplayAsset(assetClass) Automation Engine</h2>

                    <p>@SectionDescription(assetClass)</p>

                </div>

                @if (section is not null)

                {

                    <button type="button"

                            class="@SwitchClass(section.Enabled)"

                            disabled="@(!section.Supported || SectionBusy is not null)"

                            title="@CapabilityText(assetClass)"

                            @onclick="() => ToggleSection(assetClass)">

                        <span></span>

                    </button>

                }

            </div>



            @if (section is null || !section.Supported)

            {

                <div class="auto-capability-warning">

                    <i class="ph ph-warning-circle"></i>

                    <div>

                        <strong>@DisplayAsset(assetClass) automation is unavailable.</strong>

                        <p>@(section?.Reason ?? "The connected backend/broker does not currently expose this asset automation capability.")</p>

                    </div>

                </div>

            }



            <div class="auto-asset-status-grid">

                <article><span>Section</span><strong class="@(section?.Enabled == true ? "good" : "")">@(section?.Enabled == true ? "ENABLED" : "DISABLED")</strong></article>

                <article><span>Broker</span><strong class="@(BrokerConnected ? "good" : "bad")">@(BrokerConnected ? "CONNECTED" : "DISCONNECTED")</strong></article>

                <article><span>Automations</span><strong>@assetAutomations.Count</strong></article>

                <article><span>Running</span><strong>@(section?.RunningAutomations ?? 0)</strong></article>

            </div>



            <div class="auto-panel">

                <div class="auto-panel-header">

                    <div>

                        <span>CONFIGURED AUTOMATIONS</span>

                        <h3>@DisplayAsset(assetClass) Strategies</h3>

                        <small>Enable and run configured automation strategies for this asset class.</small>

                    </div>

                </div>



                @if (assetAutomations.Count == 0)

                {

                    <div class="auto-empty">

                        <i class="ph ph-robot"></i>

                        @if (section?.Enabled == true && section.RunningAutomations > 0)

                        {

                            <strong>@DisplayAsset(assetClass) automatic runtime is active.</strong>

                            <span>PhoenixTrend is automatically discovering, analyzing, waiting for actionable signals, applying risk controls, and managing execution for this asset class.</span>

                        }

                        else

                        {

                            <strong>@DisplayAsset(assetClass) automation is not running.</strong>

                            <span>Enable this asset section while the master engine is running to start its automatic backend runtime.</span>

                        }

                    </div>

                }

                else

                {

                    @foreach (var automation in assetAutomations)

                    {

                        var runtime = RuntimeFor(automation.Id);

                        var runtimeState = RuntimeState(runtime);

                        <div class="auto-automation-row" data-runtime-state="@runtimeState">

                            <div>

                                <strong>@automation.Name</strong>

                                <small>@DisplayAsset(automation.AssetClass) · @(automation.AutoSelectStrategy ? "Automatic strategy selection" : Dash(automation.Strategy))</small>

                                @if (automation.Symbols.Count > 0)

                                {

                                    <div class="auto-symbol-strip">

                                        @foreach (var symbol in automation.Symbols)

                                        {

                                            <span class="auto-symbol-chip">
                                                <StockLogo Symbol="@symbol" Size="small" />
                                                <span>@symbol</span>
                                            </span>

                                        }

                                    </div>

                                }

                            </div>

                            <div style="display:flex;align-items:center;gap:8px;">

                                <span class="auto-runtime-badge">@runtimeState</span>

                                @if (IsRuntimeActive(runtime))

                                {

                                    <button type="button" class="auto-btn" disabled="@Busy" @onclick="() => StopRuntime(automation.Id)">Stop</button>

                                }

                                else if (!automation.Enabled)

                                {

                                    <button type="button" class="auto-btn" disabled="@Busy" @onclick="() => EnableAndStartRuntime(automation.Id)">Enable &amp; Start</button>

                                }

                                else

                                {

                                    <button type="button" class="auto-btn" disabled="@Busy" @onclick="() => StartRuntime(automation.Id)">Start</button>

                                }

                            </div>

                        </div>

                    }

                }

            </div>

        </section>

    }



</div>



@code {

    private bool Loading = true;

    private bool Busy;

    private bool EngineBusy;

    private bool _renderSyncPending = true;



    private string? SectionBusy;

    private string ActiveSection = "ENGINE";

    private string EngineState = "STOPPED";



    private string? ErrorMessage;

    private string? SuccessMessage;



    private bool BrokerConnected;



    private readonly List<NavigationItem> NavigationSections = new()

    {

        new("ENGINE", "Engine", "ph ph-cpu"),

        new("STOCK", "Stocks", "ph ph-chart-line-up", "stocks"),

        new("OPTIONS", "Options", "ph ph-stack", "options"),

        new("CRYPTO", "Crypto", "ph ph-currency-btc", "crypto"),

        new("FUTURES", "Futures", "ph ph-trend-up", "futures"),

        new("ETF", "ETFs", "ph ph-chart-pie-slice", "etfs"),

        new("FOREX", "Forex", "ph ph-currency-circle-dollar", "forex"),

        new("BONDS", "Bonds", "ph ph-bank", "bonds"),

        new("ACTIVITY", "Activity", "ph ph-activity")

    };



    private IEnumerable<NavigationItem> AssetNavigation =>

        NavigationSections.Where(x => x.AssetClass is not null);



    private readonly List<SectionState> SectionStates = new();

    private readonly List<AutomationItem> AutomationItems = new();

    private readonly List<RuntimeItem> RuntimeItems = new();

    private readonly List<AssetActivityItem> AssetActivityItems = new();

    private readonly CancellationTokenSource _liveRefreshCts = new();

    private Task? _liveRefreshTask;



    private int EnabledSectionCount =>

        SectionStates.Count(x => x.Enabled);



    private int RunningCount =>

        Math.Max(

            RuntimeItems.Count(x =>

                string.Equals(

                    x.State,

                    "RUNNING",

                    StringComparison.OrdinalIgnoreCase) ||

                string.Equals(

                    x.State,

                    "STARTING",

                    StringComparison.OrdinalIgnoreCase)),

            SectionStates.Count(x => x.RunningAutomations > 0));



    private int TotalOrders =>

        RuntimeItems.Sum(x => x.Orders);



    private string EngineDescription =>

        EngineState switch

        {

            "RUNNING" => "Automation engine is armed and running.",

            "EMERGENCY_STOP" => "Emergency stop is active.",

            "STARTING" => "Automation engine is starting.",

            "STOPPING" => "Automation engine is stopping.",

            _ => "Engine is stopped."

        };



    protected override async Task OnInitializedAsync()

    {

        await LoadData();

        _liveRefreshTask = RunLiveRefreshAsync(_liveRefreshCts.Token);

    }



    private async Task RunLiveRefreshAsync(CancellationToken token)

    {

        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        try

        {

            while (await timer.WaitForNextTickAsync(token))

            {

                if (Busy || EngineBusy) continue;

                await InvokeAsync(async () =>

                {

                    await LoadData();

                    StateHasChanged();

                });

            }

        }

        catch (OperationCanceledException) { }

    }



    protected override async Task OnAfterRenderAsync(bool firstRender)

    {

        if (!firstRender && !_renderSyncPending)

            return;



        _renderSyncPending = false;



        try

        {

            await JS.InvokeVoidAsync(

                "PhoenixAutomations.initialize");



            await JS.InvokeVoidAsync(

                "PhoenixAutomations.setActiveSection",

                JsSectionName(ActiveSection));



            await JS.InvokeVoidAsync(

                "PhoenixAutomations.setEngineState",

                EngineState);



            foreach (var section in SectionStates)

            {

                await JS.InvokeVoidAsync(

                    "PhoenixAutomations.setSectionState",

                    JsSectionName(section.AssetClass),

                    section.Enabled);



                await JS.InvokeVoidAsync(

                    "PhoenixAutomations.setSectionRunning",

                    JsSectionName(section.AssetClass),

                    section.RunningAutomations > 0);

            }



            foreach (var runtime in RuntimeItems)

            {

                await JS.InvokeVoidAsync(

                    "PhoenixAutomations.setRuntimeState",

                    runtime.AutomationId,

                    runtime.State);

            }

        }

        catch

        {

            // Visual synchronization is optional. Blazor remains authoritative.

        }

    }



    private async Task RefreshAsync()

    {

        if (Busy)

            return;



        Busy = true;

        ClearMessages();



        try

        {

            await LoadData();

            SuccessMessage = "Automation data refreshed.";

        }

        catch (Exception ex)

        {

            ErrorMessage = ex.Message;

        }

        finally

        {

            Busy = false;

        }

    }



    private async Task LoadData()

    {

        Loading = true;



        try

        {

            var engineTask = Api.AutomationEngineStatus();

            var sectionsTask = Api.AutomationAssetSections();

            var automationsTask = Api.Automations();

            var runtimesTask = Api.AutomationRuntimes();

            var assetActivityTask = Api.AutomationAssetActivity();

            var brokerTask = Api.BrokerStatus();



            await Task.WhenAll(

                engineTask,

                sectionsTask,

                automationsTask,

                runtimesTask,

                assetActivityTask,

                brokerTask);



            ParseEngineStatus(await engineTask);

            ParseSections(await sectionsTask);

            ParseAutomations(await automationsTask);

            ParseRuntimes(await runtimesTask);

            ParseAssetActivity(await assetActivityTask);

            ParseBrokerStatus(await brokerTask);



            EnsureNavigationSections();

            _renderSyncPending = true;

        }

        finally

        {

            Loading = false;

        }

    }



    private void ParseEngineStatus(JsonElement? payload)

    {

        if (payload is not { } root ||

            root.ValueKind != JsonValueKind.Object)

            return;



        var state = GetString(root, "state");



        if (!string.IsNullOrWhiteSpace(state))

            EngineState = state.ToUpperInvariant();



        var brokerConnected = GetBool(root, "broker_connected");

        if (brokerConnected.HasValue)

            BrokerConnected = brokerConnected.Value;

    }



    private void ParseSections(JsonElement? payload)

    {

        SectionStates.Clear();



        if (payload is not { } root ||

            root.ValueKind != JsonValueKind.Array)

            return;



        foreach (var item in root.EnumerateArray())

        {

            if (item.ValueKind != JsonValueKind.Object)

                continue;



            var assetClass = GetString(item, "asset_class");

            if (string.IsNullOrWhiteSpace(assetClass))

                continue;



            SectionStates.Add(new SectionState

            {

                AssetClass = assetClass,

                Enabled = GetBool(item, "enabled") ?? false,

                Supported = GetBool(item, "supported") ?? false,

                RunningAutomations = GetInt(item, "running_automations"),

                AutomationCount = GetInt(item, "automation_count"),

                Reason = GetString(item, "reason")

            });

        }

    }



    private void ParseAutomations(JsonElement? payload)

    {

        AutomationItems.Clear();



        if (payload is not { } root ||

            root.ValueKind != JsonValueKind.Array)

            return;



        foreach (var item in root.EnumerateArray())

        {

            if (item.ValueKind != JsonValueKind.Object)

                continue;



            var id = GetString(item, "id");

            if (string.IsNullOrWhiteSpace(id))

                continue;



            var symbols = new List<string>();

            if (item.TryGetProperty("symbols", out var symbolArray) &&

                symbolArray.ValueKind == JsonValueKind.Array)

            {

                foreach (var symbol in symbolArray.EnumerateArray())

                {

                    if (symbol.ValueKind == JsonValueKind.String &&

                        !string.IsNullOrWhiteSpace(symbol.GetString()))

                    {

                        symbols.Add(symbol.GetString()!.Trim().ToUpperInvariant());

                    }

                }

            }



            AutomationItems.Add(new AutomationItem

            {

                Id = id,

                Name = GetString(item, "name") ?? "Automation",

                AssetClass = GetString(item, "asset_class") ?? string.Empty,

                Enabled = GetBool(item, "enabled") ?? false,

                AutoSelectStrategy = GetBool(item, "auto_select_strategy") ?? true,

                Strategy = GetString(item, "strategy"),

                Symbols = symbols

            });

        }

    }



    private void ParseRuntimes(JsonElement? payload)

    {

        RuntimeItems.Clear();



        if (payload is not { } root ||

            root.ValueKind != JsonValueKind.Array)

            return;



        foreach (var item in root.EnumerateArray())

        {

            if (item.ValueKind != JsonValueKind.Object)

                continue;



            var automationId = GetString(item, "automation_id");

            if (string.IsNullOrWhiteSpace(automationId))

                continue;



            RuntimeItems.Add(new RuntimeItem

            {

                AutomationId = automationId,

                State = GetString(item, "state") ?? "STOPPED",

                LastSymbol = GetString(item, "last_symbol"),

                LastStrategy = GetString(item, "last_strategy"),

                LastAction = GetString(item, "last_action"),

                Orders = GetInt(item, "orders_requested")

            });

        }

    }



    private void ParseAssetActivity(JsonElement? payload)

    {

        AssetActivityItems.Clear();

        if (payload is not { } root || root.ValueKind != JsonValueKind.Array)

            return;



        foreach (var item in root.EnumerateArray())

        {

            if (item.ValueKind != JsonValueKind.Object) continue;

            AssetActivityItems.Add(new AssetActivityItem

            {

                AssetClass = GetString(item, "asset_class") ?? string.Empty,

                Symbol = GetString(item, "symbol"),

                Strategy = GetString(item, "strategy"),

                Action = GetString(item, "action"),

                State = GetString(item, "state") ?? "MONITORING",

                RuntimeState = GetString(item, "runtime_state") ?? "RUNNING",

                Message = GetString(item, "message"),

                Timestamp = GetString(item, "timestamp")

            });

        }

    }



    private void ParseBrokerStatus(JsonElement? payload)

    {

        if (payload is not { } root ||

            root.ValueKind != JsonValueKind.Object)

            return;



        BrokerConnected =

            GetBool(root, "connected") ?? BrokerConnected;

    }



    private void EnsureNavigationSections()

    {

        foreach (var asset in AssetNavigation)

        {

            var cls = asset.AssetClass!;



            if (SectionStates.Any(x =>

                    string.Equals(

                        x.AssetClass,

                        cls,

                        StringComparison.OrdinalIgnoreCase)))

            {

                continue;

            }



            SectionStates.Add(new SectionState

            {

                AssetClass = cls,

                Enabled = false,

                RunningAutomations = 0,

                AutomationCount = 0,

                Supported = false,

                Reason = "This asset class is not available from the connected automation backend."

            });

        }

    }



