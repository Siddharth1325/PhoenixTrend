    private void ApplyQuote(
        JsonElement? root
    )
    {
        if (root is null)
        {
            return;
        }

        Price =
            ReadNumberRecursive(
                root.Value,
                "price",
                "regularMarketPrice",
                "current_price",
                "close"
            ) ?? Price;

        ChangePercent =
            ReadNumberRecursive(
                root.Value,
                "change_percent",
                "changePercent",
                "regularMarketChangePercent",
                "percent_change"
            );

        SymbolName =
            ReadStringRecursive(
                root.Value,
                "name",
                "shortName",
                "longName",
                "company_name"
            ) ?? Symbol;

        var source =
            ReadStringRecursive(
                root.Value,
                "source"
            );

        var providerMode =
            ReadStringRecursive(
                root.Value,
                "provider_mode"
            );

        if (
            !LiveMode &&
            !string.IsNullOrWhiteSpace(
                source
            )
        )
        {
            ProviderStatus =
                source.Contains(
                    "yahoo",
                    StringComparison.OrdinalIgnoreCase
                )
                    ? "Yahoo Finance · provider polling"
                    : $"{source} · {providerMode ?? "provider data"}";
        }
    }

    private void ApplyContext(
        JsonElement? root
    )
    {
        if (root is null)
        {
            return;
        }

        Rsi =
            FormatNumber(
                ReadNumberRecursive(
                    root.Value,
                    "rsi",
                    "rsi14"
                ),
                "0.00"
            );

        Ema20 =
            FormatNumber(
                ReadNumberRecursive(
                    root.Value,
                    "ema20",
                    "ema_20"
                ),
                "0.00"
            );

        Ema50 =
            FormatNumber(
                ReadNumberRecursive(
                    root.Value,
                    "ema50",
                    "ema_50"
                ),
                "0.00"
            );

        Vwap =
            FormatNumber(
                ReadNumberRecursive(
                    root.Value,
                    "vwap"
                ),
                "0.00"
            );

        VolumeRatio =
            FormatRatio(
                ReadNumberRecursive(
                    root.Value,
                    "volume_ratio",
                    "volumeRatio"
                )
            );

        MarketRegime =
            ReadStringRecursive(
                root.Value,
                "market_regime",
                "regime",
                "trend"
            ) ?? "—";

        Insights.Clear();

        if (
            MarketRegime != "—"
        )
        {
            Insights.Add(
                $"{Symbol} market regime is {MarketRegime.ToLowerInvariant()}."
            );
        }

        var rsi =
            ReadNumberRecursive(
                root.Value,
                "rsi",
                "rsi14"
            );

        if (rsi.HasValue)
        {
            Insights.Add(
                $"RSI 14 is {rsi.Value:0.0}."
            );
        }

        var ema20 =
            ReadNumberRecursive(
                root.Value,
                "ema20",
                "ema_20"
            );

        var ema50 =
            ReadNumberRecursive(
                root.Value,
                "ema50",
                "ema_50"
            );

        if (
            Price.HasValue &&
            ema20.HasValue &&
            ema50.HasValue
        )
        {
            if (
                Price.Value > ema20.Value &&
                ema20.Value > ema50.Value
            )
            {
                Insights.Add(
                    "Price is trading above EMA 20 and EMA 50."
                );
            }
            else if (
                Price.Value < ema20.Value &&
                ema20.Value < ema50.Value
            )
            {
                Insights.Add(
                    "Price is trading below EMA 20 and EMA 50."
                );
            }
            else
            {
                Insights.Add(
                    "Moving averages are mixed."
                );
            }
        }

        var dayHigh =
            ReadNumberRecursive(
                root.Value,
                "day_high",
                "dayHigh"
            );

        var dayLow =
            ReadNumberRecursive(
                root.Value,
                "day_low",
                "dayLow"
            );

        if (
            dayHigh.HasValue &&
            dayLow.HasValue
        )
        {
            Insights.Add(
                $"Session reference range: {dayLow.Value:0.00} – {dayHigh.Value:0.00}."
            );
        }
    }

    private void ApplyPatterns(
        JsonElement? root
    )
    {
        if (root is null)
        {
            return;
        }

        var array =
            FindArray(
                root.Value,
                "patterns",
                "results",
                "items",
                "data"
            );

        if (!array.HasValue)
        {
            return;
        }

        foreach (
            var pattern
            in array.Value.EnumerateArray()
        )
        {
            var name =
                FirstString(
                    pattern,
                    "name",
                    "pattern",
                    "type"
                );

            if (
                !string.IsNullOrWhiteSpace(
                    name
                )
            )
            {
                Insights.Add(
                    $"Pattern intelligence detected {name}."
                );
            }
        }
    }

    private void ApplyLevels(
        JsonElement? root
    )
    {
        SupportLevels.Clear();
        ResistanceLevels.Clear();

        if (root is null)
        {
            return;
        }

        ExtractLevelArray(
            root.Value,
            SupportLevels,
            "support",
            "supports"
        );

        ExtractLevelArray(
            root.Value,
            ResistanceLevels,
            "resistance",
            "resistances"
        );
    }

    private static void ExtractLevelArray(
        JsonElement root,
        List<double> destination,
        params string[] names
    )
    {
        if (
            root.ValueKind !=
            JsonValueKind.Object
        )
        {
            return;
        }

        foreach (var name in names)
        {
            if (
                !root.TryGetProperty(
                    name,
                    out var value
                )
            )
            {
                continue;
            }

            if (
                value.ValueKind ==
                JsonValueKind.Number &&
                value.TryGetDouble(
                    out var single
                )
            )
            {
                destination.Add(
                    single
                );

                continue;
            }

            if (
                value.ValueKind !=
                JsonValueKind.Array
            )
            {
                continue;
            }

            foreach (
                var item
                in value.EnumerateArray()
            )
            {
                if (
                    item.ValueKind ==
                        JsonValueKind.Number &&
                    item.TryGetDouble(
                        out var number
                    )
                )
                {
                    destination.Add(
                        number
                    );

                    continue;
                }

                if (
                    item.ValueKind ==
                    JsonValueKind.Object
                )
                {
                    var price =
                        FirstNumber(
                            item,
                            "price",
                            "value",
                            "level"
                        );

                    if (price.HasValue)
                    {
                        destination.Add(
                            price.Value
                        );
                    }
                }
            }
        }

        destination.Sort();
    }

    private void ApplyAnalysis(
        JsonElement? root
    )
    {
        TradeLevels =
            new TradeLevelView();

        if (root is null)
        {
            return;
        }

        TradeLevels.Entry =
            ReadNumberRecursive(
                root.Value,
                "entry",
                "entry_price",
                "entryPrice"
            );

        TradeLevels.Stop =
            ReadNumberRecursive(
                root.Value,
                "stop",
                "stop_loss",
                "stop_price",
                "stopLoss"
            );

        TradeLevels.Target =
            ReadNumberRecursive(
                root.Value,
                "target",
                "target_price",
                "take_profit",
                "takeProfit"
            );

        TradeLevels.Exit =
            ReadNumberRecursive(
                root.Value,
                "exit",
                "exit_price",
                "exitPrice"
            );

        var action =
            ReadStringRecursive(
                root.Value,
                "action",
                "signal",
                "decision"
            );

        var confidence =
            ReadNumberRecursive(
                root.Value,
                "confidence",
                "score",
                "probability"
            );

        if (
            !string.IsNullOrWhiteSpace(
                action
            )
        )
        {
            var message =
                $"Phoenix analysis action: {action}";

            if (confidence.HasValue)
            {
                message +=
                    $" ({confidence.Value:0.##})";
            }

            message += ".";

            Insights.Add(
                message
            );
        }
    }

    private void ApplyEvents(
        JsonElement? root
    )
    {
        ChartEvents.Clear();

        if (root is null)
        {
            return;
        }

        var array =
            FindArray(
                root.Value,
                "events",
                "items",
                "results",
                "data"
            );

        if (!array.HasValue)
        {
            return;
        }

        foreach (
            var item
            in array.Value.EnumerateArray()
        )
        {
            if (
                item.ValueKind !=
                JsonValueKind.Object
            )
            {
                continue;
            }

            var time =
                FirstString(
                    item,
                    "timestamp",
                    "time",
                    "date",
                    "datetime"
                );

            if (
                string.IsNullOrWhiteSpace(
                    time
                )
            )
            {
                continue;
            }

            var type =
                FirstString(
                    item,
                    "type",
                    "event_type",
                    "eventType"
                ) ?? "event";

            var title =
                FirstString(
                    item,
                    "title",
                    "label",
                    "name"
                ) ?? type;

            ChartEvents.Add(
                new ChartEventView(
                    time,
                    type,
                    title
                )
            );
        }
    }

    private void ApplyBroker(
        JsonElement? root
    )
    {
        if (root is null)
        {
            return;
        }

        var connected =
            ReadStringRecursive(
                root.Value,
                "connected"
            );

        BrokerConnected =
            string.Equals(
                connected,
                "true",
                StringComparison.OrdinalIgnoreCase
            );

        if (
            !BrokerConnected &&
            root.Value.ValueKind ==
                JsonValueKind.Object &&
            root.Value.TryGetProperty(
                "connected",
                out var property
            ) &&
            (
                property.ValueKind ==
                    JsonValueKind.True ||
                property.ValueKind ==
                    JsonValueKind.False
            )
        )
        {
            BrokerConnected =
                property.GetBoolean();
        }
    }

    private void ApplyPositions(
        JsonElement? root
    )
    {
        Positions.Clear();

        if (root is null)
        {
            return;
        }

        var array =
            root.Value.ValueKind ==
                JsonValueKind.Array
                ? root.Value
                : FindArray(
                    root.Value,
                    "positions",
                    "data",
                    "items"
                ) ?? default;

        if (
            array.ValueKind !=
            JsonValueKind.Array
        )
        {
            return;
        }

        foreach (
            var position
            in array.EnumerateArray()
        )
        {
            var symbol =
                FirstString(
                    position,
                    "symbol"
                ) ?? "";

            if (
                string.IsNullOrWhiteSpace(
                    symbol
                )
            )
            {
                continue;
            }

            Positions.Add(
                new PositionView(
                    symbol,

                    FirstNumber(
                        position,
                        "qty",
                        "quantity"
                    )
                    ?.ToString(
                        "0.####",
                        CultureInfo.InvariantCulture
                    ) ?? "—",

                    FirstNumber(
                        position,
                        "avg_entry_price",
                        "entry_price",
                        "average_entry_price"
                    ),

                    FirstNumber(
                        position,
                        "current_price",
                        "price"
                    ),

                    FirstNumber(
                        position,
                        "unrealized_pl",
                        "pnl",
                        "profit_loss"
                    )
                )
            );
        }
    }

    private static (
        string Range,
        string Timeframe
    ) NormalizeRangeTimeframe(
        string range,
        string timeframe
    )
    {
        return range switch
        {
            "1D" =>
                (
                    "1D",
                    timeframe is
                        "1m" or
                        "2m" or
                        "5m" or
                        "15m" or
                        "30m" or
                        "1h"
                            ? timeframe
                            : "5m"
                ),

            "5D" =>
                (
                    "5D",
                    timeframe is
                        "1m" or
                        "2m" or
                        "5m" or
                        "15m" or
                        "30m" or
                        "1h"
                            ? timeframe
                            : "15m"
                ),

            "1M" =>
                (
                    "1M",
                    timeframe is
                        "5m" or
                        "15m" or
                        "30m" or
                        "1h"
                            ? timeframe
                            : "30m"
                ),

            "3M" =>
                (
                    "3M",
                    timeframe is
                        "1h" or
                        "1d"
                            ? timeframe
                            : "1h"
                ),

            "6M" =>
                (
                    "6M",
                    "1d"
                ),

            "1Y" =>
                (
                    "1Y",
                    "1d"
                ),

            "5Y" =>
                (
                    "5Y",
                    "1d"
                ),

            "MAX" =>
                (
                    "MAX",
                    "1wk"
                ),

            _ =>
                (
                    range,
                    timeframe
                )
        };
    }

    private static string DefaultRangeFor(
        string timeframe
    )
    {
        return timeframe switch
        {
            "1m" =>
                "1D",

            "5m" =>
                "5D",

            "15m" =>
                "5D",

            "30m" =>
                "1M",

            "1h" =>
                "3M",

            "1d" =>
                "1Y",

            "1wk" =>
                "5Y",

            _ =>
                "5D"
        };
    }

    private static JsonElement? FindArray(
        JsonElement root,
        params string[] names
    )
    {
        if (
            root.ValueKind ==
            JsonValueKind.Array
        )
        {
            return root;
        }

        if (
            root.ValueKind ==
            JsonValueKind.Object
        )
        {
            foreach (var name in names)
            {
                if (
                    root.TryGetProperty(
                        name,
                        out var value
                    ) &&
                    value.ValueKind ==
                        JsonValueKind.Array
                )
                {
                    return value;
                }
            }

            foreach (
                var property
                in root.EnumerateObject()
            )
            {
                var nested =
                    FindArray(
                        property.Value,
                        names
                    );

                if (nested.HasValue)
                {
                    return nested;
                }
            }
        }

        return null;
    }

    private static double? FirstNumber(
        JsonElement root,
        params string[] names
    )
    {
        if (
            root.ValueKind !=
            JsonValueKind.Object
        )
        {
            return null;
        }

        foreach (var name in names)
        {
            if (
                !root.TryGetProperty(
                    name,
                    out var value
                )
            )
            {
                continue;
            }

            if (
                value.ValueKind ==
                    JsonValueKind.Number &&
                value.TryGetDouble(
                    out var number
                )
            )
            {
                return number;
            }

            if (
                value.ValueKind ==
                    JsonValueKind.String &&
                double.TryParse(
                    value.GetString(),
                    NumberStyles.Float |
                    NumberStyles.AllowThousands,
                    CultureInfo.InvariantCulture,
                    out number
                )
            )
            {
                return number;
            }
        }

        return null;
    }

    private static string? FirstString(
        JsonElement root,
        params string[] names
    )
    {
        if (
            root.ValueKind !=
            JsonValueKind.Object
        )
        {
            return null;
        }

        foreach (var name in names)
        {
            if (
                !root.TryGetProperty(
                    name,
                    out var value
                )
            )
            {
                continue;
            }

            if (
                value.ValueKind ==
                JsonValueKind.String
            )
            {
                return value.GetString();
            }

            if (
                value.ValueKind ==
                JsonValueKind.Number
            )
            {
                return value.ToString();
            }
        }

        return null;
    }

    private static double? ReadNumberRecursive(
        JsonElement root,
        params string[] names
    )
    {
        var direct =
            FirstNumber(
                root,
                names
            );

        if (direct.HasValue)
        {
            return direct;
        }

        if (
            root.ValueKind ==
            JsonValueKind.Object
        )
        {
            foreach (
                var property
                in root.EnumerateObject()
            )
            {
                var nested =
                    ReadNumberRecursive(
                        property.Value,
                        names
                    );

                if (nested.HasValue)
                {
                    return nested;
                }
            }
        }

        if (
            root.ValueKind ==
            JsonValueKind.Array
        )
        {
            foreach (
                var item
                in root.EnumerateArray()
            )
            {
                var nested =
                    ReadNumberRecursive(
                        item,
                        names
                    );

                if (nested.HasValue)
                {
                    return nested;
                }
            }
        }

        return null;
    }

    private static string? ReadStringRecursive(
        JsonElement root,
        params string[] names
    )
    {
        var direct =
            FirstString(
                root,
                names
            );

        if (
            !string.IsNullOrWhiteSpace(
                direct
            )
        )
        {
            return direct;
        }

        if (
            root.ValueKind ==
            JsonValueKind.Object
        )
        {
            foreach (
                var property
                in root.EnumerateObject()
            )
            {
                var nested =
                    ReadStringRecursive(
                        property.Value,
                        names
                    );

                if (
                    !string.IsNullOrWhiteSpace(
                        nested
                    )
                )
                {
                    return nested;
                }
            }
        }

        if (
            root.ValueKind ==
            JsonValueKind.Array
        )
        {
            foreach (
                var item
                in root.EnumerateArray()
            )
            {
                var nested =
                    ReadStringRecursive(
                        item,
                        names
                    );

                if (
                    !string.IsNullOrWhiteSpace(
                        nested
                    )
                )
                {
                    return nested;
                }
            }
        }

        return null;
    }

    private static string FormatPrice(
        double? value
    )
    {
        return value.HasValue
            ? value.Value.ToString(
                "N2",
                CultureInfo.InvariantCulture
            )
            : "—";
    }

    private static string FormatMoney(
        double? value
    )
    {
        return value.HasValue
            ? value.Value.ToString(
                "C2",
                CultureInfo.GetCultureInfo(
                    "en-US"
                )
            )
            : "—";
    }

    private static string FormatNumber(
        double? value,
        string format
    )
    {
        return value.HasValue
            ? value.Value.ToString(
                format,
                CultureInfo.InvariantCulture
            )
            : "—";
    }

    private static string FormatRatio(
        double? value
    )
    {
        return value.HasValue
            ? $"{value.Value:0.00}x"
            : "—";
    }

    private static string FormatPercent(
        double? value
    )
    {
        return value.HasValue
            ? $"{(value.Value >= 0 ? "+" : "")}{value.Value:0.00}%"
            : "—";
    }

    private static string ChangeClass(
        double? value
    )
    {
        if (!value.HasValue)
        {
            return "";
        }

        return value.Value >= 0
            ? "positive"
            : "negative";
    }

    private static string FormatVolume(
        double? value
    )
    {
        if (!value.HasValue)
        {
            return "—";
        }

        var number =
            value.Value;

        if (Math.Abs(number) >= 1_000_000_000)
        {
            return
                $"{number / 1_000_000_000:0.00}B";
        }

        if (Math.Abs(number) >= 1_000_000)
        {
            return
                $"{number / 1_000_000:0.00}M";
        }

        if (Math.Abs(number) >= 1_000)
        {
            return
                $"{number / 1_000:0.0}K";
        }

        return number.ToString(
            "N0",
            CultureInfo.InvariantCulture
        );
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed =
            true;

        try
        {
            await JS.InvokeVoidAsync(
                "PhoenixChart.destroy"
            );
        }
        catch
        {
        }
    }

