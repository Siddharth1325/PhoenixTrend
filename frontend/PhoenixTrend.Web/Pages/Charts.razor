@* ============================================================
   PHOENIXTREND CHARTS
   Pages/Charts.razor

   Professional provider-backed chart workstation.

   - Real OHLCV only
   - No generated candles
   - 5Y historical chart support
   - Genuine Alpaca LIVE trade streaming
   - EMA 9 / 20 / 50 / 200
   - RSI 14
   - MACD
   - Support / Resistance
   - Provider-backed candle updates
   - Corporate/news event markers
   - Strategy levels only when backend provides them
   - Time/price anchored drawings
   ============================================================ *@

@page "/charts"

@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop

@implements IAsyncDisposable

@inject PhoenixApi Api
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>PhoenixTrend | TradeDesk</PageTitle>

<div class="pt-charts">

    @* ========================================================
       HERO
       ======================================================== *@

    <section class="charts-hero">
        <div class="charts-hero-copy">
            <h1>TradeDesk</h1>
            <p>Professional charting, market analysis and broker-backed manual execution</p>
        </div>

        <!-- <div class="charts-hero-status">
            <span class="status-dot @(Bars.Count > 0 ? "online" : "")"></span>

            <div>
                <strong>@Symbol</strong>
                <small>@ProviderStatus</small>
            </div>
        </div> -->
    </section>

    @* ========================================================
       QUICK TICKERS
       ======================================================== *@

    <section class="ticker-strip">

        <div class="tradedesk-symbol-search">
            <i class="ph ph-magnifying-glass"></i>
            <input value="@SymbolSearch"
                   @oninput="SymbolSearchChanged"
                   @onkeydown="SymbolSearchKeyDown"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="Search symbol — AAPL, NVDA, TSLA, MSFT, SPY..." />
            <button type="button" @onclick="LoadSearchedSymbol" disabled="@Loading">
                <i class="ph ph-arrow-right"></i>
            </button>
        </div>

        @foreach (var ticker in Tickers)
        {
            <button class="ticker-card @(ticker.Symbol == Symbol ? "active" : "")"
                    @onclick="() => SelectSymbol(ticker.Symbol)">

                <StockLogo Symbol="@ticker.Symbol" Size="28" />

                <span class="ticker-copy">
                    <strong>@ticker.Symbol</strong>
                    <small>@FormatPrice(ticker.Price)</small>
                </span>

                <span class="ticker-change @ChangeClass(ticker.ChangePercent)">
                    @FormatPercent(ticker.ChangePercent)
                </span>

                <span class="ticker-spark @ChangeClass(ticker.ChangePercent)">
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                </span>

            </button>
        }

    </section>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="chart-alert">
            <i class="ph ph-warning-circle"></i>
            @ErrorMessage
        </div>
    }

    @* ========================================================
       WORKSPACE
       ======================================================== *@

    <section class="charts-workspace">

        <div class="chart-column">

            <div class="chart-shell">

                @* ====================================================
                   COMMAND BAR
                   ==================================================== *@

                <header class="chart-commandbar">

                    <div class="symbol-command">
                        <StockLogo Symbol="@Symbol" Size="30" />

                        <div>
                            <strong>@Symbol</strong>
                            <small>@SymbolName</small>
                        </div>
                    </div>

                    <div class="timeframe-group">

                        <button class="@(LiveMode ? "active live-active" : "live-button")"
                                disabled="@Loading"
                                title="Stream genuine Alpaca market trades"
                                @onclick="EnableLiveMode">
                            <span class="live-dot"></span>
                            LIVE
                        </button>

                        @foreach (var tf in Timeframes)
                        {
                            <button class="@(!LiveMode && SelectedTimeframe == tf.Key ? "active" : "")"
                                    disabled="@Loading"
                                    @onclick="() => ChangeTimeframe(tf.Key)">
                                @tf.Label
                            </button>
                        }

                    </div>

                    <div class="chart-actions">

                        <button class="icon-btn @(ShowIndicators ? "active" : "")"
                                title="Indicators"
                                @onclick="ToggleIndicators">

                            <i class="ph ph-function"></i>

                        </button>

                        <button class="command-btn"
                                title="Fit chart"
                                @onclick="FitChart">

                            <i class="ph ph-arrows-out-line-horizontal"></i>
                            Fit

                        </button>

                        <button class="command-btn"
                                title="Return to latest candle"
                                @onclick="ScrollToRealtime">

                            <i class="ph ph-skip-forward"></i>

                        </button>

                        <button class="command-btn"
                                title="Screenshot"
                                @onclick="TakeScreenshot">

                            <i class="ph ph-camera"></i>

                        </button>

                        <button class="command-btn"
                                title="Fullscreen"
                                @onclick="ToggleFullscreen">

                            <i class="ph ph-corners-out"></i>

                        </button>

                    </div>

                </header>

                @* ====================================================
                   OHLC HEADER
                   ==================================================== *@

                <div class="ohlc-strip">

                    <strong>
                        @Symbol · @(LiveMode ? $"LIVE · {SelectedTimeframe}" : SelectedTimeframe)
                    </strong>

                    <span>
                        O
                        <b>@FormatPrice(DisplayBar?.Open)</b>
                    </span>

                    <span>
                        H
                        <b>@FormatPrice(DisplayBar?.High)</b>
                    </span>

                    <span>
                        L
                        <b>@FormatPrice(DisplayBar?.Low)</b>
                    </span>

                    <span>
                        C
                        <b>@FormatPrice(DisplayBar?.Close)</b>
                    </span>

                    <span>
                        Vol
                        <b>@FormatVolume(DisplayBar?.Volume)</b>
                    </span>

                    <span class="@ChangeClass(DisplayChangePercent)">
                        @FormatPercent(DisplayChangePercent)
                    </span>

                    <span class="provider-label">
                        <span class="live-dot"></span>
                        @ProviderStatus
                    </span>

                </div>

                @* ====================================================
                   CHART STAGE
                   ==================================================== *@

                <div class="chart-stage">

                    <aside class="drawing-rail">

                        @foreach (var tool in DrawingTools)
                        {
                            <button class="@(SelectedDrawingTool == tool.Id ? "active" : "")"
                                    title="@tool.Label"
                                    @onclick="() => SelectDrawingTool(tool.Id)">

                                <i class="@tool.Icon"></i>

                            </button>
                        }

                    </aside>

                    <div class="chart-area">

                        @if (Loading)
                        {
                            <div class="chart-loading">
                                <span></span>

                                Loading real @SelectedRange / @SelectedTimeframe
                                candles for @Symbol...
                            </div>
                        }

                        <div id="phoenix-main-chart"
                             class="phoenix-main-chart">
                        </div>

                        @if (ShowIndicators && Bars.Count > 0)
                        {
                            <div class="indicator-pane rsi-pane">

                                <div class="indicator-pane-title">
                                    <strong>RSI 14</strong>

                                    <span>
                                        @Rsi
                                    </span>
                                </div>

                                <div id="phoenix-rsi-chart"
                                     class="phoenix-indicator-chart">
                                </div>

                            </div>

                            <div class="indicator-pane macd-pane">

                                <div class="indicator-pane-title">
                                    <strong>MACD 12 26 9</strong>
                                </div>

                                <div id="phoenix-macd-chart"
                                     class="phoenix-indicator-chart">
                                </div>

                            </div>
                        }

                        @if (!Loading && Bars.Count == 0)
                        {
                            <div class="chart-no-data">

                                <i class="ph ph-chart-line-down"></i>

                                <strong>
                                    Market data unavailable
                                </strong>

                                <span>
                                    PhoenixTrend will not generate replacement candles.
                                </span>

                            </div>
                        }

                    </div>

                </div>

                @* ====================================================
                   RANGE / STATUS BAR
                   ==================================================== *@

                <footer class="chart-footer">

                    <div class="range-group">

                        @foreach (var range in Ranges)
                        {
                            <button class="@(SelectedRange == range ? "active" : "")"
                                    disabled="@Loading"
                                    @onclick="() => ChangeRange(range)">

                                @range

                            </button>
                        }

                    </div>

                    <div class="chart-status">

                        <span class="live-dot"></span>

                        <span>
                            @LastProviderUpdate
                        </span>

                        <button @onclick="ResetPriceScale">
                            %
                        </button>

                        <button @onclick="FitChart">
                            auto
                        </button>

                    </div>

                </footer>

            </div>

            @* ========================================================
               MARKET LEVELS
               ======================================================== *@

            <section class="chart-levels-grid">

                <article class="chart-level-card support">

                    <header>
                        <span>
                            <i class="ph ph-arrow-down-left"></i>
                            Support
                        </span>
                    </header>

                    @if (SupportLevels.Count == 0)
                    {
                        <strong>—</strong>
                        <small>No confirmed level available</small>
                    }
                    else
                    {
                        <strong>@FormatPrice(SupportLevels.FirstOrDefault())</strong>

                        <small>
                            @string.Join(" · ", SupportLevels.Take(3).Select(x => FormatPrice(x)))
                        </small>
                    }

                </article>

                <article class="chart-level-card resistance">

                    <header>
                        <span>
                            <i class="ph ph-arrow-up-right"></i>
                            Resistance
                        </span>
                    </header>

                    @if (ResistanceLevels.Count == 0)
                    {
                        <strong>—</strong>
                        <small>No confirmed level available</small>
                    }
                    else
                    {
                        <strong>@FormatPrice(ResistanceLevels.FirstOrDefault())</strong>

                        <small>
                            @string.Join(" · ", ResistanceLevels.Take(3).Select(x => FormatPrice(x)))
                        </small>
                    }

                </article>

                <article class="chart-level-card entry">

                    <header>
                        <span>
                            <i class="ph ph-sign-in"></i>
                            Entry
                        </span>
                    </header>

                    <strong>@FormatPrice(TradeLevels.Entry)</strong>

                    <small>
                        @(TradeLevels.Entry.HasValue
                            ? "Phoenix analysis level"
                            : "No backend entry signal")
                    </small>

                </article>

                <article class="chart-level-card target">

                    <header>
                        <span>
                            <i class="ph ph-target"></i>
                            Target / Exit
                        </span>
                    </header>

                    <strong>
                        @FormatPrice(TradeLevels.Target ?? TradeLevels.Exit)
                    </strong>

                    <small>
                        @if (TradeLevels.Stop.HasValue)
                        {
                            <span>
                                Stop @FormatPrice(TradeLevels.Stop)
                            </span>
                        }
                        else
                        {
                            <span>
                                No backend target/stop signal
                            </span>
                        }
                    </small>

                </article>

            </section>

            @* ========================================================
               LOWER INFORMATION PANELS
               ======================================================== *@

            <section class="bottom-grid">

                <article class="data-panel">

                    <header>

                        <strong>
                            Open Positions
                        </strong>

                        <button @onclick='() => Navigation.NavigateTo("/portfolio")'>
                            View All
                        </button>

                    </header>

                    <div class="mini-table">

                        <div class="mini-table-head position-cols">
                            <span>Symbol</span>
                            <span>Qty</span>
                            <span>Entry</span>
                            <span>Current</span>
                            <span>P&amp;L</span>
                        </div>

                        @if (Positions.Count == 0)
                        {
                            <div class="panel-empty">
                                Connect Alpaca to show your real open positions.
                            </div>
                        }
                        else
                        {
                            @foreach (var p in Positions.Take(5))
                            {
                                <button class="mini-table-row position-cols"
                                        @onclick="() => SelectSymbol(p.Symbol)">

                                    <span class="symbol-cell">

                                        <StockLogo Symbol="@p.Symbol"
                                                   Size="20" />

                                        <b>@p.Symbol</b>

                                    </span>

                                    <span>
                                        @p.Qty
                                    </span>

                                    <span>
                                        @FormatPrice(p.EntryPrice)
                                    </span>

                                    <span>
                                        @FormatPrice(p.CurrentPrice)
                                    </span>

                                    <span class="@ChangeClass(p.Pnl)">
                                        @FormatMoney(p.Pnl)
                                    </span>

                                </button>
                            }
                        }

                    </div>

                </article>

                <article class="data-panel">

                    <header>

                        <strong>
                            Market Context
                        </strong>

                        <button @onclick="Refresh">
                            Refresh
                        </button>

                    </header>

                    <div class="context-grid">

                        <div>
                            <span>RSI 14</span>
                            <strong>@Rsi</strong>
                        </div>

                        <div>
                            <span>EMA 20</span>
                            <strong>@Ema20</strong>
                        </div>

                        <div>
                            <span>EMA 50</span>
                            <strong>@Ema50</strong>
                        </div>

                        <div>
                            <span>VWAP</span>
                            <strong>@Vwap</strong>
                        </div>

                        <div>
                            <span>Volume Ratio</span>
                            <strong>@VolumeRatio</strong>
                        </div>

                        <div>
                            <span>Regime</span>
                            <strong>@MarketRegime</strong>
                        </div>

                    </div>

                </article>

                <article class="data-panel ai-panel">

                    <header>

                        <strong>
                            <i class="ph ph-sparkle"></i>
                            Chart Insights (Trady AI)
                        </strong>

                    </header>

                    <div class="ai-insights">

                        @if (Insights.Count == 0)
                        {
                            <div class="panel-empty">
                                Phoenix intelligence is waiting for market context.
                            </div>
                        }
                        else
                        {
                            @foreach (var insight in Insights.Take(6))
                            {
                                <p>
                                    <i class="ph ph-dot-outline-fill"></i>
                                    @insight
                                </p>
                            }
                        }

                    </div>

                </article>

            </section>

        </div>

        @* ============================================================
           RIGHT COLUMN
           ============================================================ *@

        <aside class="right-column">

            <section class="side-panel trade-panel">

                <header>
                    <strong>Trade</strong>
                </header>

                <div class="buy-sell-tabs">

                    <button class="@((OrderSide == "buy") ? "buy active" : "")"
                            @onclick='() => OrderSide = "buy"'>

                        Buy

                    </button>

                    <button class="@((OrderSide == "sell") ? "sell active" : "")"
                            @onclick='() => OrderSide = "sell"'>

                        Sell

                    </button>

                </div>

                <div class="order-type-tabs">

                    @foreach (var type in OrderTypes)
                    {
                        <button class="@(OrderType == type ? "active" : "")"
                                @onclick="() => OrderType = type">

                            @type

                        </button>
                    }

                </div>

                <label>
                    Symbol
                </label>

                <div class="trade-input symbol-input">

                    <StockLogo Symbol="@Symbol"
                               Size="20" />

                    <input value="@Symbol"
                           readonly />

                </div>

                <label>
                    Quantity
                </label>

                <div class="trade-input">

                    <input type="number"
                           min="1"
                           @bind="OrderQuantity" />

                </div>

                <div class="order-value">

                    <span>
                        Estimated value
                    </span>

                    <strong>
                        @FormatMoney((Price ?? 0) * OrderQuantity)
                    </strong>

                </div>

                <div class="quick-qty">

                    @foreach (var qty in QuickQuantities)
                    {
                        <button class="@(OrderQuantity == qty ? "active" : "")"
                                @onclick="() => OrderQuantity = qty">

                            @qty

                        </button>
                    }

                </div>

                @if (OrderType is "Limit" or "Stop Limit")
                {
                    <label>Limit price</label>
                    <div class="trade-input">
                        <input type="number" min="0" step="0.01" @bind="OrderLimitPrice" />
                    </div>
                }

                @if (OrderType is "Stop" or "Stop Limit")
                {
                    <label>Stop price</label>
                    <div class="trade-input">
                        <input type="number" min="0" step="0.01" @bind="OrderStopPrice" />
                    </div>
                }

                <button class="trade-submit @(OrderSide)"
                        disabled="@(!BrokerConnected || OrderBusy || OrderQuantity <= 0)"
                        @onclick="SubmitManualOrder">

                    @if (OrderBusy)
                    {
                        <i class="ph ph-spinner-gap ph-spin"></i>
                        <span>Submitting...</span>
                    }
                    else
                    {
                        @(BrokerConnected
                            ? $"{CultureInfo.InvariantCulture.TextInfo.ToTitleCase(OrderSide)} {Symbol}"
                            : "Connect broker to trade")
                    }

                </button>

                @if (!string.IsNullOrWhiteSpace(OrderMessage))
                {
                    <small class="trade-note @OrderMessageClass">@OrderMessage</small>
                }
                else
                {
                    <small class="trade-note">
                        Orders are analyzed, confirmed and submitted through the connected broker.
                    </small>
                }

            </section>

            <section class="side-panel watchlist-panel">

                <header>

                    <strong>
                        Watchlist
                    </strong>

                    <button class="outline-action"
                            @onclick="AddCurrentToWatchlist">

                        <i class="ph ph-plus"></i>
                        Add

                    </button>

                </header>

                <div class="watch-head">
                    <span>Symbol</span>
                    <span>Last</span>
                    <span>%</span>
                </div>

                @foreach (var item in Watchlist)
                {
                    <button class="watch-row @(item.Symbol == Symbol ? "active" : "")"
                            @onclick="() => SelectSymbol(item.Symbol)">

                        <span class="symbol-cell">

                            <StockLogo Symbol="@item.Symbol"
                                       Size="20" />

                            <b>
                                @item.Symbol
                            </b>

                        </span>

                        <span>
                            @FormatPrice(item.Price)
                        </span>

                        <span class="@ChangeClass(item.ChangePercent)">
                            @FormatPercent(item.ChangePercent)
                        </span>

                    </button>
                }

            </section>

            <section class="side-panel tools-panel">

                <header>
                    <strong>
                        Chart Tools
                    </strong>
                </header>

                <div class="tool-grid">

                    @foreach (var tool in DrawingTools.Take(8))
                    {
                        <button class="@(SelectedDrawingTool == tool.Id ? "active" : "")"
                                @onclick="() => SelectDrawingTool(tool.Id)">

                            <i class="@tool.Icon"></i>

                            <span>
                                @tool.Label
                            </span>

                        </button>
                    }

                </div>

                <div class="tool-secondary-actions">

                    <button @onclick="UndoDrawing">
                        <i class="ph ph-arrow-counter-clockwise"></i>
                        Undo
                    </button>

                    <button @onclick="ClearDrawings">
                        <i class="ph ph-trash"></i>
                        Clear
                    </button>

                </div>

            </section>

            <section class="side-panel market-data-panel">

                <header>
                    <strong>Market Data</strong>
                </header>

                <div class="market-data-status">

                    <div>
                        <span>Provider</span>
                        <strong>@(LiveMode ? "Alpaca" : "Yahoo Finance")</strong>
                    </div>

                    <div>
                        <span>Mode</span>
                        <strong>@(LiveMode ? "LIVE stream" : "Provider polling")</strong>
                    </div>

                    <div>
                        <span>Range</span>
                        <strong>@SelectedRange</strong>
                    </div>

                    <div>
                        <span>Interval</span>
                        <strong>@(LiveMode ? $"{SelectedTimeframe} LIVE" : SelectedTimeframe)</strong>
                    </div>

                    <div>
                        <span>Candles</span>
                        <strong>@Bars.Count.ToString("N0")</strong>
                    </div>

                </div>

            </section>

        </aside>

    </section>

</div>

@code {

    [SupplyParameterFromQuery(Name = "symbol")]
    public string? QuerySymbol { get; set; }

    private string Symbol = "AAPL";
    private string SymbolName = "Apple Inc.";

    private string SelectedTimeframe = "15m";
    private string SelectedRange = "5D";
    private string SelectedDrawingTool = "crosshair";

    private string OrderSide = "buy";
    private string OrderType = "Market";

    private int OrderQuantity = 100;
    private double? OrderLimitPrice;
    private double? OrderStopPrice;
    private bool OrderBusy;
    private string OrderMessage = string.Empty;
    private string OrderMessageClass = string.Empty;
    private string SymbolSearch = string.Empty;

    private bool Loading = true;
    private bool ShowIndicators = true;
    private bool BrokerConnected;
    private bool LiveMode;

    private string ErrorMessage = "";

    private string ProviderStatus =
        "Yahoo Finance · provider polling";

    private string LastProviderUpdate =
        "Waiting for provider";

    private double? Price;
    private double? ChangePercent;

    private string Rsi = "—";
    private string Ema20 = "—";
    private string Ema50 = "—";
    private string Vwap = "—";
    private string VolumeRatio = "—";
    private string MarketRegime = "—";

    private readonly List<BarView> Bars = new();
    private readonly List<TickerView> Tickers = new();
    private readonly List<TickerView> Watchlist = new();
    private readonly List<PositionView> Positions = new();
    private readonly List<string> Insights = new();
    private readonly List<double> SupportLevels = new();
    private readonly List<double> ResistanceLevels = new();
    private readonly List<ChartEventView> ChartEvents = new();

    private TradeLevelView TradeLevels = new();

    private BarView? CrosshairBar;
    private double? CrosshairChangePercent;

    private bool _chartReady;
    private bool _disposed;

    private BarView? LastBar =>
        Bars.Count == 0
            ? null
            : Bars[^1];

    private BarView? DisplayBar =>
        CrosshairBar ?? LastBar;

    private double? DisplayChangePercent =>
        CrosshairBar is not null
            ? CrosshairChangePercent
            : ChangePercent;

    private readonly TimeframeView[] Timeframes =
    {
        new("1m", "1m"),
        new("5m", "5m"),
        new("15m", "15m"),
        new("30m", "30m"),
        new("1h", "1h"),
        new("1d", "D"),
        new("1wk", "W")
    };

    private readonly string[] Ranges =
    {
        "1D",
        "5D",
        "1M",
        "3M",
        "6M",
        "1Y",
        "5Y",
        "MAX"
    };

    private readonly string[] OrderTypes =
    {
        "Market",
        "Limit",
        "Stop",
        "Stop Limit"
    };

    private readonly int[] QuickQuantities =
    {
        25,
        50,
        100,
        250
    };

    private readonly DrawingToolView[] DrawingTools =
    {
        new(
            "crosshair",
            "Crosshair",
            "ph ph-crosshair"
        ),

        new(
            "trend",
            "Trend Line",
            "ph ph-trend-up"
        ),

        new(
            "horizontal",
            "Horizontal",
            "ph ph-minus"
        ),

        new(
            "vertical",
            "Vertical",
            "ph ph-line-vertical"
        ),

        new(
            "fib",
            "Fibonacci",
            "ph ph-list-dashes"
        ),

        new(
            "rectangle",
            "Rectangle",
            "ph ph-rectangle"
        ),

        new(
            "text",
            "Text",
            "ph ph-text-t"
        ),

        new(
            "arrow",
            "Arrow",
            "ph ph-arrow-up-right"
        ),

        new(
            "measure",
            "Measure",
            "ph ph-ruler"
        ),

        new(
            "clear",
            "Clear Drawings",
            "ph ph-trash"
        )
    };

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(QuerySymbol))
        {
            Symbol =
                QuerySymbol
                    .Trim()
                    .ToUpperInvariant();
        }

        SeedWatchlist();

        await LoadWorkspace();
    }

    private async Task LoadWorkspace()
    {
        Loading = true;
        ErrorMessage = "";

        CrosshairBar = null;
        CrosshairChangePercent = null;

        try
        {
            var quoteTask =
                Api.Quote(Symbol);

            var contextTask =
                Api.Context(Symbol);

            var patternsTask =
                Api.Patterns(Symbol);

            var brokerTask =
                Api.BrokerStatus();

            var positionsTask =
                Api.BrokerPositions();

            var analysisTask =
                Api.Analyze(Symbol);

            var levelsTask =
                Api.ChartLevels(
                    Symbol,
                    SelectedRange,
                    SelectedTimeframe,
                    120
                );

            var eventsTask =
                Api.ChartEvents(
                    Symbol,
                    SelectedRange
                );

            await LoadChartData();

            await Task.WhenAll(
                quoteTask,
                contextTask,
                patternsTask,
                brokerTask,
                positionsTask,
                analysisTask,
                levelsTask,
                eventsTask
            );

            ApplyQuote(
                await quoteTask
            );

            ApplyContext(
                await contextTask
            );

            ApplyPatterns(
                await patternsTask
            );

            ApplyBroker(
                await brokerTask
            );

            ApplyPositions(
                await positionsTask
            );

            ApplyAnalysis(
                await analysisTask
            );

            ApplyLevels(
                await levelsTask
            );

            ApplyEvents(
                await eventsTask
            );

            await LoadTickerQuotes();

            await LoadWatchlistQuotes();

            Loading = false;

            await InvokeAsync(
                StateHasChanged
            );

            await RenderChart(
                true
            );
        }
        catch (Exception ex)
        {
            Loading = false;

            ErrorMessage =
                $"Unable to load {Symbol} chart data: {ex.Message}";
        }
    }

    private async Task LoadChartData()
    {
        Bars.Clear();

        var normalized =
            NormalizeRangeTimeframe(
                SelectedRange,
                SelectedTimeframe
            );

        SelectedRange =
            normalized.Range;

        SelectedTimeframe =
            normalized.Timeframe;

        var root =
            await Api.ChartRange(
                Symbol,
                normalized.Range,
                normalized.Timeframe
            );

        if (root is null)
        {
            LastProviderUpdate =
                "Market data unavailable";

            return;
        }

        var array =
            FindArray(
                root.Value,
                "bars",
                "candles",
                "history",
                "results",
                "items",
                "data"
            );

        if (!array.HasValue)
        {
            LastProviderUpdate =
                "Market data unavailable";

            return;
        }

        foreach (
            var item
            in array.Value.EnumerateArray()
        )
        {
            if (
                item.ValueKind !=
                JsonValueKind.Object
            )
            {
                continue;
            }

            var time =
                FirstString(
                    item,
                    "timestamp",
                    "time",
                    "datetime",
                    "date"
                );

            var open =
                FirstNumber(
                    item,
                    "open",
                    "o"
                );

            var high =
                FirstNumber(
                    item,
                    "high",
                    "h"
                );

            var low =
                FirstNumber(
                    item,
                    "low",
                    "l"
                );

            var close =
                FirstNumber(
                    item,
                    "close",
                    "c"
                );

            var volume =
                FirstNumber(
                    item,
                    "volume",
                    "v"
                );

            if (
                string.IsNullOrWhiteSpace(time) ||
                !open.HasValue ||
                !high.HasValue ||
                !low.HasValue ||
                !close.HasValue
            )
            {
                continue;
            }

            Bars.Add(
                new BarView(
                    time,
                    open.Value,
                    high.Value,
                    low.Value,
                    close.Value,
                    volume
                )
            );
        }

        if (Bars.Count > 0)
        {
            Price =
                Bars[^1].Close;

            LastProviderUpdate =
                $"Provider data {DateTime.Now:h:mm:ss tt}";
        }
        else
        {
            LastProviderUpdate =
                "Market data unavailable";
        }
    }

    private async Task RenderChart(
        bool fit
    )
    {
        if (
            Bars.Count == 0 ||
            _disposed
        )
        {
            return;
        }

        var payload =
            Bars
                .Select(
                    x => new
                    {
                        time =
                            x.Time,

                        open =
                            x.Open,

                        high =
                            x.High,

                        low =
                            x.Low,

                        close =
                            x.Close,

                        volume =
                            x.Volume
                    }
                )
                .ToArray();

        var levels =
            new
            {
                support =
                    SupportLevels.ToArray(),

                resistance =
                    ResistanceLevels.ToArray()
            };

        var tradeLevels =
            new
            {
                entry =
                    TradeLevels.Entry,

                stop =
                    TradeLevels.Stop,

                target =
                    TradeLevels.Target,

                exit =
                    TradeLevels.Exit
            };

        var events =
            ChartEvents
                .Select(
                    x => new
                    {
                        time =
                            x.Time,

                        type =
                            x.Type,

                        title =
                            x.Title
                    }
                )
                .ToArray();

        var escapedSymbol =
            Uri.EscapeDataString(
                Symbol
            );

        var escapedTimeframe =
            Uri.EscapeDataString(
                SelectedTimeframe
            );

        var currentUri =
            new Uri(
                Navigation.Uri
            );

        var wsScheme =
            currentUri.Scheme.Equals(
                "https",
                StringComparison.OrdinalIgnoreCase
            )
                ? "wss"
                : "ws";

        var wsUrl =
            $"{wsScheme}://{currentUri.Host}:8000" +
            $"/ws/chart/{escapedSymbol}" +
            $"?timeframe={escapedTimeframe}" +
            (LiveMode ? "&live=true" : "");

        var pollUrl =
            $"/api/chart/{escapedSymbol}/latest" +
            $"?timeframe={escapedTimeframe}";

        await JS.InvokeVoidAsync(
            "PhoenixChart.render",
            "phoenix-main-chart",
            payload,
            new
            {
                symbol =
                    Symbol,

                timeframe =
                    SelectedTimeframe,

                range =
                    SelectedRange,

                indicators =
                    ShowIndicators,

                fitContent =
                    fit,

                levels,

                tradeLevels,

                events,

                rsiContainerId =
                    ShowIndicators
                        ? "phoenix-rsi-chart"
                        : null,

                macdContainerId =
                    ShowIndicators
                        ? "phoenix-macd-chart"
                        : null,

                wsUrl,

                pollUrl,

                pollInterval =
                    2000
            }
        );

        await JS.InvokeVoidAsync(
            "PhoenixChart.setDrawingTool",
            SelectedDrawingTool
        );

        _chartReady = true;
    }

    private async Task ReloadChartOnly()
    {
        Loading = true;
        ErrorMessage = "";

        CrosshairBar = null;
        CrosshairChangePercent = null;

        try
        {
            var levelsTask =
                Api.ChartLevels(
                    Symbol,
                    SelectedRange,
                    SelectedTimeframe,
                    120
                );

            var eventsTask =
                Api.ChartEvents(
                    Symbol,
                    SelectedRange
                );

            var analysisTask =
                Api.Analyze(Symbol);

            await LoadChartData();

            await Task.WhenAll(
                levelsTask,
                eventsTask,
                analysisTask
            );

            ApplyLevels(
                await levelsTask
            );

            ApplyEvents(
                await eventsTask
            );

            ApplyAnalysis(
                await analysisTask
            );

            Loading = false;

            await InvokeAsync(
                StateHasChanged
            );

            await RenderChart(
                true
            );
        }
        catch (Exception ex)
        {
            Loading = false;

            ErrorMessage =
                $"Unable to load {SelectedRange} chart history: {ex.Message}";
        }
    }

    private async Task EnableLiveMode()
    {
        if (Loading)
        {
            return;
        }

        if (!BrokerConnected)
        {
            ErrorMessage =
                "Connect Alpaca before starting LIVE chart mode.";

            ProviderStatus =
                "LIVE unavailable · Alpaca not connected";

            return;
        }

        if (
            SelectedTimeframe is not
                ("1m" or "5m" or "15m" or "30m" or "1h")
        )
        {
            SelectedTimeframe =
                "1m";
        }

        LiveMode =
            true;

        SelectedRange =
            DefaultRangeFor(
                SelectedTimeframe
            );

        ErrorMessage =
            "";

        ProviderStatus =
            "Alpaca · LIVE stream requested";

        LastProviderUpdate =
            "Connecting to Alpaca LIVE";

        await ReloadChartOnly();

        await ScrollToRealtime();
    }

    private async Task ChangeTimeframe(
        string timeframe
    )
    {
        if (Loading)
        {
            return;
        }

        if (
            LiveMode &&
            timeframe is
                "1m" or
                "5m" or
                "15m" or
                "30m" or
                "1h"
        )
        {
            SelectedTimeframe =
                timeframe;

            SelectedRange =
                DefaultRangeFor(
                    timeframe
                );

            ProviderStatus =
                "Alpaca · LIVE stream requested";

            await ReloadChartOnly();

            await ScrollToRealtime();

            return;
        }

        if (
            !LiveMode &&
            SelectedTimeframe == timeframe
        )
        {
            return;
        }

        LiveMode =
            false;

        ProviderStatus =
            "Yahoo Finance · provider polling";

        SelectedTimeframe =
            timeframe;

        SelectedRange =
            DefaultRangeFor(
                timeframe
            );

        await ReloadChartOnly();
    }

    private async Task ChangeRange(
        string range
    )
    {
        if (
            Loading ||
            SelectedRange == range
        )
        {
            return;
        }

        LiveMode =
            false;

        ProviderStatus =
            "Yahoo Finance · provider polling";

        SelectedRange =
            range;

        var normalized =
            NormalizeRangeTimeframe(
                SelectedRange,
                SelectedTimeframe
            );

        SelectedRange =
            normalized.Range;

        SelectedTimeframe =
            normalized.Timeframe;

        await ReloadChartOnly();
    }

