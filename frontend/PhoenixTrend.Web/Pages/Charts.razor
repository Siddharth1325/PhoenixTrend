    private async Task SubmitManualOrder()
    {
        if (OrderBusy)
            return;

        OrderMessage = string.Empty;
        OrderMessageClass = string.Empty;

        if (!BrokerConnected)
        {
            OrderMessage = "Connect the broker before submitting an order.";
            OrderMessageClass = "error";
            return;
        }

        if (OrderQuantity <= 0)
        {
            OrderMessage = "Quantity must be greater than zero.";
            OrderMessageClass = "error";
            return;
        }

        if ((OrderType is "Limit" or "Stop Limit") &&
            (!OrderLimitPrice.HasValue || OrderLimitPrice.Value <= 0))
        {
            OrderMessage = "Enter a valid limit price.";
            OrderMessageClass = "error";
            return;
        }

        if ((OrderType is "Stop" or "Stop Limit") &&
            (!OrderStopPrice.HasValue || OrderStopPrice.Value <= 0))
        {
            OrderMessage = "Enter a valid stop price.";
            OrderMessageClass = "error";
            return;
        }

        try
        {
            OrderBusy = true;

            // Keep the existing intelligence pipeline in front of manual execution.
            var analysis = await Api.ManualAnalyze(Symbol);
            if (analysis is null)
                throw new InvalidOperationException("PhoenixTrend analysis is unavailable for this symbol.");

            var estimated = (Price ?? 0d) * OrderQuantity;
            var sideText = CultureInfo.InvariantCulture.TextInfo.ToTitleCase(OrderSide);
            var typeText = OrderType;
            var priceText = estimated > 0
                ? FormatMoney(estimated)
                : "the current market value";

            var confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                $"Confirm {sideText} {OrderQuantity} {Symbol} as a {typeText} order? Estimated value: {priceText}.");

            if (!confirmed)
            {
                OrderMessage = "Order cancelled.";
                OrderMessageClass = "";
                return;
            }

            var normalizedType = OrderType switch
            {
                "Limit" => "limit",
                "Stop" => "stop",
                "Stop Limit" => "stop_limit",
                _ => "market"
            };

            var result = await Api.ManualOrder(
                Symbol,
                OrderSide,
                OrderQuantity,
                normalizedType,
                normalizedType is "limit" or "stop_limit" ? OrderLimitPrice : null,
                normalizedType is "stop" or "stop_limit" ? OrderStopPrice : null,
                "day");

            if (result is null)
                throw new InvalidOperationException("The broker did not confirm the order.");

            var executionState = PhoenixApi.Text(result, "state", "").Trim().ToUpperInvariant();
            var executionError = PhoenixApi.Text(result, "error", "");
            var hasBrokerOrder = result.Value.ValueKind == JsonValueKind.Object &&
                result.Value.TryGetProperty("order", out var brokerOrder) &&
                brokerOrder.ValueKind == JsonValueKind.Object;

            if (!hasBrokerOrder)
            {
                throw new InvalidOperationException(
                    !string.IsNullOrWhiteSpace(executionError)
                        ? executionError
                        : string.IsNullOrWhiteSpace(executionState)
                            ? "The broker did not confirm the order."
                            : $"Order was not submitted. Execution state: {executionState}.");
            }

            OrderMessage = $"{sideText} order submitted successfully ({executionState}).";
            OrderMessageClass = "success";

            var brokerTask = Api.BrokerStatus();
            var positionsTask = Api.BrokerPositions();
            await Task.WhenAll(brokerTask, positionsTask);
            ApplyBroker(await brokerTask);
            ApplyPositions(await positionsTask);
        }
        catch (Exception ex)
        {
            OrderMessage = ex.Message;
            OrderMessageClass = "error";
        }
        finally
        {
            OrderBusy = false;
        }
    }

