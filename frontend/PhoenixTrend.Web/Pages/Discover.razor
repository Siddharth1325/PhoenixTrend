    private RenderFragment OpportunityTable() => builder =>

    {

        var seq = 0;

        builder.OpenElement(seq++, "div");

        builder.AddAttribute(seq++, "class", "table-wrap");

        builder.OpenElement(seq++, "table");

        builder.AddAttribute(seq++, "class", "discover-table");

        builder.AddMarkupContent(seq++, "<thead><tr><th>Symbol</th><th>Price</th><th>Change</th><th>AI Score</th><th>Signal</th><th>Pattern</th></tr></thead>");

