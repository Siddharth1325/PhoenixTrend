    private static bool TryGetArray(JsonElement root, out JsonElement array)

    {

        if (root.ValueKind == JsonValueKind.Array)

        {

            array = root;

            return true;

        }

        if (root.ValueKind == JsonValueKind.Object)

        {

            foreach (var name in new[] { "opportunities", "results", "data", "items", "discover" })

            {

                if (root.TryGetProperty(name, out var candidate) && candidate.ValueKind == JsonValueKind.Array)

                {

                    array = candidate;

                    return true;

                }

            }

        }

        array = default;

        return false;

    }

    private static bool TryGetPatternArray(JsonElement root, out JsonElement array)

    {

        if (root.ValueKind == JsonValueKind.Array)

        {

            array = root;

            return true;

        }

        if (root.ValueKind == JsonValueKind.Object &&

            root.TryGetProperty("patterns", out var patterns) &&

            patterns.ValueKind == JsonValueKind.Array)

        {

            array = patterns;

            return true;

        }

        array = default;

        return false;

    }

    private static string ExtractFirstPatternName(JsonElement? root)

    {

        if (root is null || !TryGetPatternArray(root.Value, out var patterns)) return "—";

        foreach (var item in patterns.EnumerateArray())

        {

            if (item.ValueKind != JsonValueKind.Object) continue;

            var name = ReadString(item, "name", "");

            if (string.IsNullOrWhiteSpace(name)) name = ReadString(item, "pattern", "");

            if (!string.IsNullOrWhiteSpace(name)) return name;

        }

        return "—";

    }

    private static double ReadFirstNumberRecursive(
        JsonElement? root,
        params string[] properties)
    {
        if (root is null) return double.NaN;
        return ReadFirstNumberRecursive(root.Value, properties);
    }

    private static double ReadFirstNumberRecursive(
        JsonElement element,
        params string[] properties)
    {
        if (element.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in properties)
            {
                if (!element.TryGetProperty(property, out var value)) continue;

                if (value.ValueKind == JsonValueKind.Number &&
                    value.TryGetDouble(out var number))
                    return number;

                if (value.ValueKind == JsonValueKind.String &&
                    double.TryParse(
                        value.GetString(),
                        System.Globalization.NumberStyles.Any,
                        System.Globalization.CultureInfo.InvariantCulture,
                        out number))
                    return number;
            }

            foreach (var child in element.EnumerateObject())
            {
                var nested = ReadFirstNumberRecursive(child.Value, properties);
                if (!double.IsNaN(nested)) return nested;
            }
        }
        else if (element.ValueKind == JsonValueKind.Array)
        {
            foreach (var child in element.EnumerateArray())
            {
                var nested = ReadFirstNumberRecursive(child, properties);
                if (!double.IsNaN(nested)) return nested;
            }
        }

        return double.NaN;
    }

    private static string ReadFirstStringRecursive(
        JsonElement? root,
        params string[] properties)
    {
        if (root is null) return string.Empty;
        return ReadFirstStringRecursive(root.Value, properties);
    }

    private static string ReadFirstStringRecursive(
        JsonElement element,
        params string[] properties)
    {
        if (element.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in properties)
            {
                if (!element.TryGetProperty(property, out var value)) continue;

                if (value.ValueKind == JsonValueKind.String)
                {
                    var text = value.GetString();
                    if (!string.IsNullOrWhiteSpace(text)) return text;
                }
            }

            foreach (var child in element.EnumerateObject())
            {
                var nested = ReadFirstStringRecursive(child.Value, properties);
                if (!string.IsNullOrWhiteSpace(nested)) return nested;
            }
        }
        else if (element.ValueKind == JsonValueKind.Array)
        {
            foreach (var child in element.EnumerateArray())
            {
                var nested = ReadFirstStringRecursive(child, properties);
                if (!string.IsNullOrWhiteSpace(nested)) return nested;
            }
        }

        return string.Empty;
    }

    private static double ReadNumberFromNullable(JsonElement? root, string property) =>

        root is null || root.Value.ValueKind != JsonValueKind.Object

            ? double.NaN

            : ReadDouble(root.Value, property);

    private static string ReadString(JsonElement element, string property, string fallback)

    {

        if (!element.TryGetProperty(property, out var value)) return fallback;

        return value.ValueKind == JsonValueKind.String ? value.GetString() ?? fallback : value.ToString();

    }

    private static double ReadDouble(JsonElement element, string property)

    {

        if (!element.TryGetProperty(property, out var value)) return double.NaN;

        if (value.ValueKind == JsonValueKind.Number && value.TryGetDouble(out var number)) return number;

        return double.TryParse(value.ToString(), out number) ? number : double.NaN;

    }

    private static string FormatPrice(double value) =>

        double.IsNaN(value) ? "—" : value.ToString("$#,##0.00");

    private static string FormatPercent(double value) =>

        double.IsNaN(value) ? "—" : value.ToString("+0.00;-0.00;0.00") + "%";

    private static string FormatScore(double value)

    {

        if (double.IsNaN(value)) return "—";

        if (value <= 1) value *= 100;

        return value.ToString("0");

    }

    private static string FormatConfidence(double value)

    {

        if (double.IsNaN(value)) return "—";

        if (value <= 1) value *= 100;

        return $"{value:0}%";

    }

    private static string FormatSignedPercent(double value) =>

        value.ToString("+0.00;-0.00;0.00") + "%";

    private static string GetChangeClass(string change) =>

        string.IsNullOrWhiteSpace(change) || change == "—"

            ? ""

            : change.StartsWith("-") ? "red" : "green";

    private static string GetSignalClass(string signal) =>

        signal.Equals("SELL", StringComparison.OrdinalIgnoreCase)

            ? "signal-pill sell"

            : signal.Equals("BUY", StringComparison.OrdinalIgnoreCase)

                ? "signal-pill buy"

                : "signal-pill watch";

