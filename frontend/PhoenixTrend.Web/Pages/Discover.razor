        foreach (var row in Rows)

        {

            builder.OpenElement(seq++, "tr");

            Cell(builder, ref seq, row.Symbol);

            Cell(builder, ref seq, row.Price);

            Cell(builder, ref seq, row.Change, GetChangeClass(row.Change));

            Cell(builder, ref seq, row.Score);

            Cell(builder, ref seq, row.Signal);

            Cell(builder, ref seq, row.Pattern);

            builder.CloseElement();

        }

        builder.CloseElement();

        builder.CloseElement();

        builder.CloseElement();

    };

    private static void Cell(RenderTreeBuilder builder, ref int seq, string text, string? css = null)

    {

        builder.OpenElement(seq++, "td");

        if (!string.IsNullOrWhiteSpace(css)) builder.AddAttribute(seq++, "class", css);

        builder.AddContent(seq++, text);

        builder.CloseElement();

    }

