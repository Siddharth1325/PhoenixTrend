    private static double? FirstNumber(
        JsonElement? root,
        params string[] properties)
    {
        if (root is null ||
            root.Value.ValueKind != JsonValueKind.Object)
        {
            return null;
        }

        foreach (var property in properties)
        {
            if (!root.Value.TryGetProperty(
                    property,
                    out var value))
            {
                continue;
            }

            if (value.ValueKind == JsonValueKind.Number &&
                value.TryGetDouble(out var number))
            {
                return number;
            }

            if (double.TryParse(
                    value.ToString(),
                    NumberStyles.Any,
                    CultureInfo.InvariantCulture,
                    out number))
            {
                return number;
            }
        }

        return null;
    }

    private static double? FirstNumber(
        JsonElement root,
        params string[] properties)
    {
        return FirstNumber(
            (JsonElement?)root,
            properties);
    }

    private static double? FirstNumberDeep(
        JsonElement? root,
        params string[] properties)
    {
        if (root is null)
            return null;

        return FirstNumberDeep(
            root.Value,
            properties,
            0);
    }

    private static double? FirstNumberDeep(
        JsonElement element,
        string[] properties,
        int depth)
    {
        if (depth > 5)
            return null;

        if (element.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in properties)
            {
                if (!element.TryGetProperty(property, out var value))
                    continue;

                if (value.ValueKind == JsonValueKind.Number &&
                    value.TryGetDouble(out var number))
                {
                    return number;
                }

                if (double.TryParse(
                        value.ToString(),
                        NumberStyles.Any,
                        CultureInfo.InvariantCulture,
                        out number))
                {
                    return number;
                }
            }

            foreach (var child in element.EnumerateObject())
            {
                var result = FirstNumberDeep(
                    child.Value,
                    properties,
                    depth + 1);

                if (result.HasValue)
                    return result;
            }
        }
        else if (element.ValueKind == JsonValueKind.Array)
        {
            foreach (var child in element.EnumerateArray())
            {
                var result = FirstNumberDeep(
                    child,
                    properties,
                    depth + 1);

                if (result.HasValue)
                    return result;
            }
        }

        return null;
    }

    private static string FirstString(
        JsonElement root,
        params string[] properties)
    {
        foreach (var property in properties)
        {
            if (!root.TryGetProperty(
                    property,
                    out var value))
            {
                continue;
            }

            var text =
                value.ValueKind == JsonValueKind.String
                    ? value.GetString()
                    : value.ToString();

            if (!string.IsNullOrWhiteSpace(text))
                return text!;
        }

        return string.Empty;
    }

    private static JsonElement? FindArray(
        JsonElement root,
        params string[] names)
    {
        if (root.ValueKind == JsonValueKind.Array)
            return root;

        if (root.ValueKind != JsonValueKind.Object)
            return null;

        foreach (var name in names)
        {
            if (root.TryGetProperty(name, out var value) &&
                value.ValueKind == JsonValueKind.Array)
            {
                return value;
            }
        }

        foreach (var wrapper in new[] { "data", "result", "payload" })
        {
            if (!root.TryGetProperty(
                    wrapper,
                    out var nested) ||
                nested.ValueKind != JsonValueKind.Object)
            {
                continue;
            }

            foreach (var name in names)
            {
                if (nested.TryGetProperty(
                        name,
                        out var value) &&
                    value.ValueKind == JsonValueKind.Array)
                {
                    return value;
                }
            }
        }

        return null;
    }

    private static string ToneClass(double value)
    {
        if (double.IsNaN(value))
            return "ptm-neutral";

        return value < 0
            ? "ptm-negative"
            : "ptm-positive";
    }

    private static string FormatPercent(double value)
    {
        return value.ToString(
                   "+0.00;-0.00;0.00",
                   CultureInfo.InvariantCulture) +
               "%";
    }

    private static string FormatSigned(double? value)
    {
        if (!value.HasValue ||
            double.IsNaN(value.Value))
        {
            return "—";
        }

        return value.Value.ToString(
            "+0.00;-0.00;0.00",
            CultureInfo.InvariantCulture);
    }

    private static string FormatPrice(double? value)
    {
        return value.HasValue
            ? value.Value.ToString(
                "$#,##0.00",
                CultureInfo.InvariantCulture)
            : "—";
    }

    private string FormatMarketPrice(double? value)
    {
        if (!value.HasValue ||
            double.IsNaN(value.Value) ||
            double.IsInfinity(value.Value))
        {
            return "—";
        }

        var number = value.Value;

        var decimals = ActiveAsset switch
        {
            "Crypto" when Math.Abs(number) < 1d => 4,
            "Forex" => 5,
            "Bonds" => 3,
            _ => 2
        };

        return "$" + number.ToString(
            $"N{decimals}",
            CultureInfo.InvariantCulture);
    }

    private static string FormatMarketCap(double? value)
    {
        if (!value.HasValue ||
            value.Value <= 0 ||
            double.IsNaN(value.Value))
        {
            return "—";
        }

        var number = value.Value;

        if (number >= 1_000_000_000_000d)
            return "$" +
                   (number / 1_000_000_000_000d)
                   .ToString("0.00", CultureInfo.InvariantCulture) +
                   "T";

        if (number >= 1_000_000_000d)
            return "$" +
                   (number / 1_000_000_000d)
                   .ToString("0.00", CultureInfo.InvariantCulture) +
                   "B";

        if (number >= 1_000_000d)
            return "$" +
                   (number / 1_000_000d)
                   .ToString("0.00", CultureInfo.InvariantCulture) +
                   "M";

        return "$" + number.ToString(
            "#,##0",
            CultureInfo.InvariantCulture);
    }

    private static string FormatRatio(double? value)
    {
        return value.HasValue &&
               value.Value > 0 &&
               !double.IsNaN(value.Value)
            ? value.Value.ToString(
                "0.00",
                CultureInfo.InvariantCulture)
            : "—";
    }

    private string FormatCandleTime(double unixSeconds)
    {
        if (unixSeconds <= 0)
            return SelectedTimeframe;

        try
        {
            var local = DateTimeOffset
                .FromUnixTimeSeconds((long)unixSeconds)
                .ToLocalTime();

            return SelectedTimeframe switch
            {
                "1D" or "1W" or "1M" =>
                    local.ToString(
                        "MMM d, yyyy • h:mm tt",
                        CultureInfo.InvariantCulture),

                _ =>
                    local.ToString(
                        "MMM d, yyyy",
                        CultureInfo.InvariantCulture)
            };
        }
        catch
        {
            return SelectedTimeframe;
        }
    }

    private static string FormatVolume(double value)
    {
        if (value <= 0 ||
            double.IsNaN(value))
        {
            return "—";
        }

        if (value >= 1_000_000_000)
            return (value / 1_000_000_000d)
                       .ToString("0.0", CultureInfo.InvariantCulture) +
                   "B";

        if (value >= 1_000_000)
            return (value / 1_000_000d)
                       .ToString("0.0", CultureInfo.InvariantCulture) +
                   "M";

        if (value >= 1_000)
            return (value / 1_000d)
                       .ToString("0.0", CultureInfo.InvariantCulture) +
                   "K";

        return value.ToString(
            "#,##0",
            CultureInfo.InvariantCulture);
    }

    private static string SparklinePoints(
        string symbol,
        double change)
    {
        var seed = symbol.Aggregate(
            17,
            (current, character) =>
                unchecked(current * 31 + character));

        var positive = double.IsNaN(change) || change >= 0;
        var values = new List<double>(14);

        for (var i = 0; i < 14; i++)
        {
            var noise = Math.Abs((seed >> (i % 12)) % 13);
            var trend = positive
                ? 30d + i * 3.4d
                : 72d - i * 3.4d;

            values.Add(Math.Clamp(trend + noise - 6d, 12d, 90d));
        }

        var min = values.Min();
        var max = values.Max();
        var span = Math.Max(max - min, .001d);

        var points = new List<string>(values.Count);

        for (var i = 0; i < values.Count; i++)
        {
            var x = 2d + 96d * i / (values.Count - 1d);
            var y = 31d - ((values[i] - min) / span * 27d);

            points.Add(
                $"{x.ToString("0.#", CultureInfo.InvariantCulture)},{y.ToString("0.#", CultureInfo.InvariantCulture)}");
        }

        return string.Join(" ", points);
    }

