            "regularMarketCap");

        SelectedPeRatio = FirstNumberDeep(
            SelectedContext,
            "pe_ratio",
            "peRatio",
            "trailingPE",
            "forwardPE");

        Selected52WeekHigh ??= FirstNumberDeep(
            SelectedContext,
            "fifty_two_week_high",
            "fiftyTwoWeekHigh",
            "52_week_high");

        Selected52WeekLow ??= FirstNumberDeep(
            SelectedContext,
            "fifty_two_week_low",
            "fiftyTwoWeekLow",
            "52_week_low");
    }

    private async Task LoadStatisticsHistory()
    {
        var root = await Api.ChartRange(
            SelectedSymbol,
            "1Y",
            "1D");

        if (root is null)
            return;

        // Prefer provider metadata if the chart endpoint exposes it.
        SelectedMarketCap ??= FirstNumberDeep(
            root,
            "market_cap",
            "marketCap",
            "regularMarketCap");

        SelectedPeRatio ??= FirstNumberDeep(
            root,
            "pe_ratio",
            "peRatio",
            "trailingPE",
            "forwardPE");

        Selected52WeekHigh ??= FirstNumberDeep(
            root,
            "fifty_two_week_high",
            "fiftyTwoWeekHigh",
            "52_week_high");

        Selected52WeekLow ??= FirstNumberDeep(
            root,
            "fifty_two_week_low",
            "fiftyTwoWeekLow",
            "52_week_low");

        var array = FindArray(
            root.Value,
            "value",
            "candles",
            "bars",
            "history",
            "results",
            "items",
            "data");

        if (!array.HasValue)
            return;

        var highs = new List<double>();
        var lows = new List<double>();
        double latestVolume = 0d;

        foreach (var item in array.Value.EnumerateArray())
        {
            if (item.ValueKind != JsonValueKind.Object)
                continue;

            var high = FirstNumber(item, "high", "h");
            var low = FirstNumber(item, "low", "l");
            var volume = FirstNumber(item, "volume", "v");

            if (high.HasValue)
                highs.Add(high.Value);

            if (low.HasValue)
                lows.Add(low.Value);

            if (volume is > 0)
                latestVolume = volume.Value;
        }

        // These are derived from the provider's real 1Y daily candles.
        if (highs.Count > 0)
            Selected52WeekHigh ??= highs.Max();

        if (lows.Count > 0)
            Selected52WeekLow ??= lows.Min();

        if (latestVolume > 0)
            SelectedHistoryVolume = latestVolume;
    }

    private void ResetSelectedStatistics()
    {
        SelectedContext = null;
        SelectedMarketCap = null;
        SelectedPeRatio = null;
        Selected52WeekHigh = null;
        Selected52WeekLow = null;
        SelectedHistoryVolume = 0d;
    }

    private async Task LoadNews()
    {
        var requestedSymbol = SelectedSymbol;
        var root = await Api.News(requestedSymbol);

        if (root is null)
            return;

        var array = FindArray(
            root.Value,
            "news",
            "results",
            "items",
            "data");

        if (!array.HasValue)
            return;

        var fresh = new List<NewsRow>();
        var seenUrls = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var item in array.Value.EnumerateArray())
        {
            if (item.ValueKind != JsonValueKind.Object)
                continue;

            var title = FirstString(
                item,
                "headline",
                "title",
                "summary");

            if (string.IsNullOrWhiteSpace(title))
                continue;

            var source = FirstString(
                item,
                "publisher",
                "source",
                "provider");

            if (string.IsNullOrWhiteSpace(source))
                source = "Market";

            var articleUrl = FirstString(
                item,
                "article_url",
                "link",
                "url");

            if (string.IsNullOrWhiteSpace(articleUrl) ||
                !Uri.TryCreate(articleUrl, UriKind.Absolute, out var parsedUrl) ||
                (parsedUrl.Scheme != Uri.UriSchemeHttp &&
                 parsedUrl.Scheme != Uri.UriSchemeHttps))
            {
                continue;
            }

            if (!seenUrls.Add(articleUrl))
                continue;

            var imageUrl = FirstString(
                item,
                "image_url",
                "thumbnail",
                "image");

            var publishedAtRaw = FirstString(
                item,
                "published_at",
                "publishedAt",
                "publish_time");

            DateTimeOffset? publishedAt = null;

            if (DateTimeOffset.TryParse(
                    publishedAtRaw,
                    CultureInfo.InvariantCulture,
                    DateTimeStyles.AssumeUniversal |
                    DateTimeStyles.AdjustToUniversal,
                    out var parsedPublishedAt))
            {
                publishedAt = parsedPublishedAt;
            }

            var symbol = FirstString(
                item,
                "symbol",
                "ticker");

            if (string.IsNullOrWhiteSpace(symbol))
                symbol = requestedSymbol;

            fresh.Add(
                new NewsRow(
                    title,
                    source,
                    articleUrl,
                    imageUrl,
                    publishedAt,
                    symbol));
        }

        fresh = fresh
            .OrderByDescending(x => x.PublishedAt ?? DateTimeOffset.MinValue)
            .Take(20)
            .ToList();

        // The selected symbol may have changed while the HTTP request was in flight.
        if (!string.Equals(
                requestedSymbol,
                SelectedSymbol,
                StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        NewsItems.Clear();
        NewsItems.AddRange(fresh);
    }

    private async Task RunNewsRefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(NewsRefreshInterval);

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    try
                    {
                        await LoadNews();
                        StateHasChanged();
                    }
                    catch (Exception ex)
                    {
                        Console.Error.WriteLine(
                            $"Market news refresh failed: {ex.Message}");
                    }
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private static string FormatNewsAge(DateTimeOffset? publishedAt)
    {
        if (!publishedAt.HasValue)
            return "Latest";

        var age = DateTimeOffset.UtcNow - publishedAt.Value.ToUniversalTime();

        if (age < TimeSpan.Zero)
            age = TimeSpan.Zero;

        if (age.TotalMinutes < 1)
            return "Just now";

        if (age.TotalMinutes < 60)
            return $"{Math.Max(1, (int)age.TotalMinutes)}m ago";

        if (age.TotalHours < 24)
            return $"{Math.Max(1, (int)age.TotalHours)}h ago";

        if (age.TotalDays < 7)
            return $"{Math.Max(1, (int)age.TotalDays)}d ago";

        return publishedAt.Value
            .ToLocalTime()
            .ToString("MMM d", CultureInfo.InvariantCulture);
    }

