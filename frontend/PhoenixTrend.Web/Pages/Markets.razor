    private static string BuildPolyline(
        IReadOnlyList<double> values,
        double width,
        double height,
        double padding)
    {
        if (values.Count < 2)
            return string.Empty;

        var min = values.Min();
        var max = values.Max();
        var span = Math.Max(max - min, 0.000001d);
        var usableWidth = width - padding * 2d;
        var usableHeight = height - padding * 2d;

        var points = new List<string>(values.Count);

        for (var i = 0; i < values.Count; i++)
        {
            var x = padding + (usableWidth * i / (values.Count - 1d));
            var normalized = (values[i] - min) / span;
            var y = padding + usableHeight * (1d - normalized);

            points.Add(
                $"{x.ToString("0.##", CultureInfo.InvariantCulture)},{y.ToString("0.##", CultureInfo.InvariantCulture)}");
        }

        return string.Join(" ", points);
    }

