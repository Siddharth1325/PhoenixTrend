@page "/markets"
@implements IAsyncDisposable

@using System.Globalization
@using System.Text.Json
@using System.Linq

@inject PhoenixApi Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>PhoenixTrend | Markets</PageTitle>

<div class="ptm-page">

    <section class="ptm-hero">
        <div class="ptm-hero-copy">
            <h1>Markets</h1>
            <p>Real-time market data, intelligence and opportunities</p>
        </div>

        <button class="ptm-refresh" type="button" @onclick="LoadAll" disabled="@Loading">
            <i class="ph ph-arrows-clockwise"></i>
            @(Loading ? "Refreshing" : "Refresh")
        </button>
    </section>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="ptm-message ptm-message-error">
            <i class="ph ph-warning-circle"></i>
            @ErrorMessage
        </div>
    }

    <section class="ptm-index-grid">
        @foreach (var item in Indices)
        {
            <article class="ptm-index-card @(item.ChangeValue < 0 ? "ptm-index-negative" : "ptm-index-positive")">
                <div class="ptm-index-copy">
                    <span>@item.Name</span>
                    <strong>@item.Price</strong>
                    <small class="@ToneClass(item.ChangeValue)">
                        @FormatSigned(item.ChangeAmount)
                        <b>@item.Change</b>
                    </small>
                </div>

                <div class="ptm-mini-spark @ToneClass(item.ChangeValue)" aria-hidden="true">
                    <svg viewBox="0 0 100 34" preserveAspectRatio="none">
                        <polyline points="@SparklinePoints(item.Symbol, item.ChangeValue)" />
                    </svg>
                </div>
            </article>
        }
    </section>

    <section class="ptm-controls">
        <div class="ptm-asset-tabs">
            @foreach (var asset in AssetTabs)
            {
                <button type="button"
                        class="@(ActiveAsset == asset ? "ptm-active" : "")"
                        @onclick="() => ChangeAsset(asset)">
                    @asset
                </button>
            }
        </div>

        <div class="ptm-search">
            <i class="ph ph-magnifying-glass"></i>
            <input id="ptm-symbol-search"
                   placeholder="Search symbols..."
                   @bind="SearchText"
                   @bind:event="oninput"
                   @onkeydown="HandleSearchKey" />
        </div>

        <select class="ptm-segment" @bind="Segment">
            <option>All Segments</option>
            <option>Gainers</option>
            <option>Losers</option>
        </select>

        <button type="button" class="ptm-filter" title="Filter">
            <i class="ph ph-funnel"></i>
        </button>
    </section>
<section class="ptm-main-grid">

        <article class="ptm-card ptm-watchlist-card">
            <header class="ptm-card-head">
                <div>
                    <h2>Market Watchlist</h2>
                    <span>Live market quotes</span>
                </div>

                <div class="ptm-watch-tools">
                    <button type="button">
                        My Watchlist
                        <i class="ph ph-caret-down"></i>
                    </button>

                    <button type="button" class="ptm-add" @onclick="FocusSearch">
                        <i class="ph ph-plus"></i>
                        Add Symbol
                    </button>
                </div>
            </header>

            <div class="ptm-table-scroll">
                <table class="ptm-watch-table">
                    <thead>
                        <tr>
                            <th class="ptm-check-column"></th>
                            <th>Symbol</th>
                            <th>Name</th>
                            <th>Price</th>
                            <th>Change</th>
                            <th>% Change</th>
                            <th>Volume</th>
                            <th>Chart</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var row in FilteredWatchlist)
                        {
                            <tr class="@(SelectedSymbol == row.Symbol ? "ptm-selected-row" : "")"
                                @onclick="() => SelectSymbol(row.Symbol)">

                                <td class="ptm-check-column">
                                    <span class="ptm-checkbox"></span>
                                </td>

                                <td>
                                    <div class="ptm-symbol">
                                        <StockLogo Symbol="@row.Symbol" Size="small" AssetType="@AssetTypeForActiveTab" />
                                        <strong>@row.Symbol</strong>
                                    </div>
                                </td>

                                <td class="ptm-company">@CompanyName(row.Symbol)</td>
                                <td class="ptm-price">@row.Price</td>
                                <td class="@ToneClass(row.ChangeValue)">@FormatSigned(row.ChangeAmount)</td>
                                <td class="@ToneClass(row.ChangeValue)">@row.Change</td>
                                <td>@FormatVolume(row.Volume)</td>

                                <td>
                                    <div class="ptm-row-spark @ToneClass(row.ChangeValue)" aria-hidden="true">
                                        <svg viewBox="0 0 100 28" preserveAspectRatio="none">
                                            <polyline points="@SparklinePoints(row.Symbol, row.ChangeValue)" />
                                        </svg>
                                    </div>
                                </td>

                                <td>
                                    <div class="ptm-row-actions">
                                        <button type="button" title="Watch" @onclick:stopPropagation="true">
                                            <i class="ph ph-star"></i>
                                        </button>
                                        <button type="button" title="Alert" @onclick:stopPropagation="true">
                                            <i class="ph ph-bell"></i>
                                        </button>
                                        <button type="button"
                                                title="Chart"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => OpenChart(row.Symbol)">
                                            <i class="ph ph-chart-line-up"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>

        <article class="ptm-card ptm-detail-card">
            <header class="ptm-detail-head">
                <div class="ptm-detail-symbol">
                    <StockLogo Symbol="@SelectedSymbol" Size="large" AssetType="@AssetTypeForActiveTab" />
                    <div>
                        <h2>@SelectedSymbol</h2>
                        <span>@CompanyName(SelectedSymbol)</span>
                    </div>
                </div>

                <div class="ptm-detail-actions">
                    <button type="button">
                        <i class="ph ph-star"></i>
                        Watchlist
                    </button>
                    <button type="button" class="ptm-trade" @onclick="OpenTrade">Trade</button>
                </div>
            </header>

            <div class="ptm-selected-price">
                <strong>@(SelectedQuote?.Price ?? "—")</strong>
                <span class="@ToneClass(SelectedQuote?.ChangeValue ?? double.NaN)">
                    @FormatSigned(SelectedQuote?.ChangeAmount)
                    @if (SelectedQuote is not null)
                    {
                        <b>(@SelectedQuote.Change)</b>
                    }
                </span>
            </div>

            <div class="ptm-timeframes">
                @foreach (var timeframe in Timeframes)
                {
                    <button type="button"
                            class="@(SelectedTimeframe == timeframe ? "ptm-active" : "")"
                            @onclick="() => ChangeTimeframe(timeframe)">
                        @timeframe
                    </button>
                }
            </div>

            <div class="ptm-chart-shell"
                 @onmouseleave="ClearChartHover">

                @if (ChartPoints.Count >= 2)
                {
                    var displayCandle = DisplayCandle;

                    <div class="ptm-chart-data-strip">
                        <div class="ptm-chart-data-symbol">
                            <StockLogo Symbol="@SelectedSymbol"
                                       Size="small"
                                       AssetType="@AssetTypeForActiveTab" />

                            <div>
                                <strong>@SelectedSymbol</strong>
                                <span>@(HoveredCandle is not null ? FormatCandleTime(displayCandle?.Time ?? 0) : "Latest market bar")</span>
                            </div>
                        </div>

                        <div class="ptm-chart-data-values">
                            <div>
                                <span>Open</span>
                                <strong>@FormatMarketPrice(displayCandle?.Open)</strong>
                            </div>

                            <div>
                                <span>High</span>
                                <strong class="ptm-positive">@FormatMarketPrice(displayCandle?.High)</strong>
                            </div>

                            <div>
                                <span>Low</span>
                                <strong class="ptm-negative">@FormatMarketPrice(displayCandle?.Low)</strong>
                            </div>

                            <div>
                                <span>Close</span>
                                <strong>@FormatMarketPrice(displayCandle?.Close)</strong>
                            </div>

                            <div class="ptm-chart-data-volume">
                                <span>Volume</span>
                                <strong>@FormatVolume(displayCandle?.Volume ?? 0)</strong>
                            </div>
                        </div>
                    </div>

                    <div class="ptm-chart">
                        <div class="ptm-chart-grid">
                            <i></i><i></i><i></i><i></i>
                        </div>

                        <svg class="ptm-price-chart"
                             viewBox="0 0 1000 300"
                             preserveAspectRatio="none"
                             role="img"
                             aria-label="@($"{SelectedSymbol} {SelectedTimeframe} interactive price chart")">

                            <defs>
                                <linearGradient id="ptmChartFill" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="currentColor" stop-opacity=".30" />
                                    <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
                                </linearGradient>
                            </defs>

                            <path class="ptm-chart-area @ChartToneClass"
                                  d="@ChartAreaPath" />

                            <polyline class="ptm-chart-line @ChartToneClass"
                                      points="@ChartPolylinePoints" />

                            @if (HoveredCandle is not null)
                            {
                                <line class="ptm-chart-crosshair"
                                      x1="@Svg(HoverX)"
                                      x2="@Svg(HoverX)"
                                      y1="0"
                                      y2="300" />

                                <line class="ptm-chart-crosshair-horizontal"
                                      x1="0"
                                      x2="1000"
                                      y1="@Svg(HoverY)"
                                      y2="@Svg(HoverY)" />

                                <circle class="ptm-chart-hover-ring @ChartToneClass"
                                        cx="@Svg(HoverX)"
                                        cy="@Svg(HoverY)"
                                        r="10" />

                                <circle class="ptm-chart-hover-dot @ChartToneClass"
                                        cx="@Svg(HoverX)"
                                        cy="@Svg(HoverY)"
                                        r="5" />
                            }

                            @for (var i = 0; i < ChartCandles.Count; i++)
                            {
                                var candleIndex = i;

                                <rect class="ptm-chart-hit"
                                      x="@Svg(HitRectX(candleIndex))"
                                      y="0"
                                      width="@Svg(HitRectWidth)"
                                      height="300"
                                      @onmouseenter="() => SetChartHover(candleIndex)" />
                            }
                        </svg>

                        @if (HoveredCandle is not null)
                        {
                            <div class="ptm-chart-price-tag"
                                 style="@($"top:{HoverYPercent.ToString("0.###", CultureInfo.InvariantCulture)}%;")">
                                @FormatMarketPrice(HoveredCandle.Close)
                            </div>
                        }

                        <div class="ptm-chart-range">
                            <span>@FormatMarketPrice(ChartPoints.Min())</span>
                            <span>@FormatMarketPrice(ChartPoints.Max())</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ptm-chart">
                        <div class="ptm-chart-empty">
                            <i class="ph ph-chart-line-up"></i>
                            <strong>Chart data unavailable</strong>
                            <span>No historical candles were returned for @SelectedSymbol.</span>
                        </div>
                    </div>
                }
            </div>

            <div class="ptm-stats">
                <div><span>Price</span><strong>@(SelectedQuote?.Price ?? "—")</strong></div>
                <div><span>Previous Close</span><strong>@FormatMarketPrice(SelectedQuote?.PreviousClose)</strong></div>
                <div><span>Change</span><strong class="@ToneClass(SelectedQuote?.ChangeValue ?? double.NaN)">@FormatSigned(SelectedQuote?.ChangeAmount)</strong></div>
                <div><span>Volume</span><strong>@FormatVolume(SelectedVolume)</strong></div>
                <div><span>Market Cap</span><strong>@FormatMarketCap(SelectedMarketCap)</strong></div>
                <div><span>P/E Ratio</span><strong>@FormatRatio(SelectedPeRatio)</strong></div>
                <div><span>52W High</span><strong>@FormatMarketPrice(Selected52WeekHigh)</strong></div>
                <div><span>52W Low</span><strong>@FormatMarketPrice(Selected52WeekLow)</strong></div>
            </div>
        </article>

    </section>

    <section class="ptm-bottom-grid">

        <article class="ptm-card ptm-heatmap-card">
            <header class="ptm-card-head ptm-compact-head">
                <div>
                    <h2>Market Heatmap</h2>
                    <span>Discovery and live market movement</span>
                </div>

                <div class="ptm-small-tabs">
                    <button type="button"
                            class="@(HeatmapTab == "Market" ? "ptm-active" : "")"
                            @onclick='() => ChangeHeatmapTab("Market")'>
                        Market
                    </button>
                    <button type="button"
                            class="@(HeatmapTab == "Discovery" ? "ptm-active" : "")"
                            @onclick='() => ChangeHeatmapTab("Discovery")'>
                        Discovery
                    </button>
                </div>
            </header>

            <div class="ptm-heatmap">
                @foreach (var item in HeatmapItems)
                {
                    <button type="button"
                            class="@ToneClass(item.ChangeValue)"
                            @onclick="() => SelectSymbol(item.Symbol)">
                        <StockLogo Symbol="@item.Symbol" Size="small" AssetType="@AssetTypeForActiveTab" />
                        <strong>@item.Symbol</strong>
                        <span>@item.Change</span>
                        <small>@item.Signal</small>
                    </button>
                }
            </div>
        </article>

        <article class="ptm-card ptm-movers-card">
            <header class="ptm-mover-tabs">
                @foreach (var tab in MoverTabs)
                {
                    <button type="button"
                            class="@(MoverTab == tab ? "ptm-active" : "")"
                            @onclick="() => MoverTab = tab">
                        @tab
                    </button>
                }
            </header>

            <div class="ptm-movers-scroll">
                <table class="ptm-movers-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Symbol</th>
                            <th>Price</th>
                            <th>% Change</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            var rank = 1;
                        }

                        @foreach (var row in CurrentMovers)
                        {
                            <tr @onclick="() => SelectSymbol(row.Symbol)">
                                <td>@rank</td>
                                <td><strong>@row.Symbol</strong></td>
                                <td>@row.Price</td>
                                <td class="@ToneClass(row.ChangeValue)">@row.Change</td>
                            </tr>

                            rank++;
                        }
                    </tbody>
                </table>
            </div>
        </article>

        <article class="ptm-card ptm-news-card" id="ptm-news">
            <header class="ptm-card-head ptm-compact-head ptm-news-head">
                <div>
                    <h2>Market News</h2>
                    <span>Latest news for @SelectedSymbol · auto-refreshing</span>
                </div>

                <div class="ptm-news-live" title="Live news feed">
                    <i></i>
                    LIVE
                </div>
            </header>

            <div class="ptm-news-viewport"
                 aria-label="@($"Live market news for {SelectedSymbol}")">
                @if (NewsItems.Count > 0)
                {
                    <div class="ptm-news-track">
                        @foreach (var news in NewsItems)
                        {
                            <a class="ptm-news-item"
                               href="@news.ArticleUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               title="Open original article">
                                <div class="ptm-news-media">
                                    @if (!string.IsNullOrWhiteSpace(news.ImageUrl))
                                    {
                                        <img src="@news.ImageUrl"
                                             alt=""
                                             loading="lazy"
                                             referrerpolicy="no-referrer" />
                                    }
                                    else
                                    {
                                        <div class="ptm-news-image-fallback">
                                            <i class="ph ph-newspaper"></i>
                                        </div>
                                    }
                                </div>

                                <div class="ptm-news-copy">
                                    <div class="ptm-news-meta">
                                        <strong>@news.Source</strong>
                                        <span>@FormatNewsAge(news.PublishedAt)</span>
                                    </div>

                                    <div class="ptm-news-title">@news.Title</div>

                                    <div class="ptm-news-footer">
                                        <span>@news.Symbol</span>
                                        <small>
                                            Original article
                                            <i class="ph ph-arrow-square-out"></i>
                                        </small>
                                    </div>
                                </div>
                            </a>
                        }

                        @* Duplicate the feed so the CSS animation loops without a visible jump. *@
                        @foreach (var news in NewsItems)
                        {
                            <a class="ptm-news-item"
                               href="@news.ArticleUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               aria-hidden="true"
                               tabindex="-1">
                                <div class="ptm-news-media">
                                    @if (!string.IsNullOrWhiteSpace(news.ImageUrl))
                                    {
                                        <img src="@news.ImageUrl"
                                             alt=""
                                             loading="lazy"
                                             referrerpolicy="no-referrer" />
                                    }
                                    else
                                    {
                                        <div class="ptm-news-image-fallback">
                                            <i class="ph ph-newspaper"></i>
                                        </div>
                                    }
                                </div>

                                <div class="ptm-news-copy">
                                    <div class="ptm-news-meta">
                                        <strong>@news.Source</strong>
                                        <span>@FormatNewsAge(news.PublishedAt)</span>
                                    </div>

                                    <div class="ptm-news-title">@news.Title</div>

                                    <div class="ptm-news-footer">
                                        <span>@news.Symbol</span>
                                        <small>
                                            Original article
                                            <i class="ph ph-arrow-square-out"></i>
                                        </small>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="ptm-news-empty">
                        <i class="ph ph-newspaper"></i>
                        <span>No market news returned by the API.</span>
                    </div>
                }
            </div>
        </article>

    </section>

</div>

@code {
    private bool Loading;
    private string ErrorMessage = string.Empty;

    private string ActiveAsset = "Stocks";
    private string SearchText = string.Empty;
    private string Segment = "All Segments";
    private string SelectedSymbol = "AAPL";
    private string SelectedTimeframe = "1D";
    private string MoverTab = "Top Gainers";
    private string HeatmapTab = "Market";

    private readonly string[] AssetTabs =
        ["Stocks", "Options", "ETFs", "Crypto", "Futures", "Forex", "Commodities", "Bonds"];

    private readonly string[] Timeframes =
        ["1D", "1W", "1M", "3M", "1Y", "5Y"];

    private readonly string[] MoverTabs =
        ["Top Gainers", "Top Losers", "Active"];

    private static readonly IReadOnlyDictionary<string, string[]> AssetUniverses =
        new Dictionary<string, string[]>(StringComparer.OrdinalIgnoreCase)
        {
            ["Stocks"] =
                ["AAPL", "TSLA", "NVDA", "MSFT", "AMZN", "GOOGL", "META", "AMD", "NFLX", "COIN"],

            ["ETFs"] =
                ["SPY", "QQQ", "VOO", "IWM", "DIA", "XLK", "XLF", "XLE", "TLT", "IEF"],

            ["Crypto"] =
                ["BTCUSD", "ETHUSD", "SOLUSD", "XRPUSD", "DOGEUSD", "ADAUSD", "AVAXUSD"],

            ["Futures"] =
                ["ES", "NQ", "YM", "RTY"],

            ["Forex"] =
                ["EURUSD", "GBPUSD", "USDJPY", "AUDUSD", "USDCAD", "USDCHF", "NZDUSD"],

            ["Commodities"] =
                ["GOLD", "SILVER", "OIL", "NATGAS", "COPPER"],

            ["Bonds"] =
                ["^TNX", "^FVX", "^TYX", "TLT", "IEF", "SHY"],

            // Options require an options-chain endpoint. Until that endpoint
            // is added, this tab uses optionable underlyings for navigation
            // but does not fabricate option-contract prices.
            ["Options"] =
                ["AAPL", "TSLA", "NVDA", "MSFT", "AMZN", "SPY", "QQQ"]
        };

    private IEnumerable<string> CurrentSymbols =>
        AssetUniverses.TryGetValue(ActiveAsset, out var symbols)
            ? symbols
            : AssetUniverses["Stocks"];

    private string AssetTypeForActiveTab =>
        ActiveAsset switch
        {
            "ETFs" => "etf",
            "Crypto" => "crypto",
            "Futures" => "future",
            "Forex" => "forex",
            "Commodities" => "commodity",
            "Bonds" => "bond",
            "Options" => "option",
            _ => "equity"
        };

    private readonly List<QuoteRow> Watchlist = new();
    private readonly List<IndexRow> Indices = new();
    private readonly List<DiscoveryRow> Discovery = new();
    private readonly List<NewsRow> NewsItems = new();
    private readonly CancellationTokenSource NewsRefreshCts = new();
    private Task? NewsRefreshTask;
    private static readonly TimeSpan NewsRefreshInterval = TimeSpan.FromMinutes(2);
    private readonly List<double> ChartPoints = new();
    private readonly List<CandleRow> ChartCandles = new();
    private JsonElement? SelectedContext;

    private int? HoveredCandleIndex;
    private double? SelectedMarketCap;
    private double? SelectedPeRatio;
    private double? Selected52WeekHigh;
    private double? Selected52WeekLow;
    private double SelectedHistoryVolume;

    private CandleRow? HoveredCandle =>
        HoveredCandleIndex is >= 0 &&
        HoveredCandleIndex < ChartCandles.Count
            ? ChartCandles[HoveredCandleIndex.Value]
            : null;

    private CandleRow? DisplayCandle =>
        HoveredCandle ?? ChartCandles.LastOrDefault();

    private double SelectedVolume =>
        SelectedQuote?.Volume > 0
            ? SelectedQuote.Volume
            : SelectedHistoryVolume > 0
                ? SelectedHistoryVolume
                : ChartCandles.LastOrDefault()?.Volume ?? 0d;


    private readonly List<QuoteRow> Gainers = new();
    private readonly List<QuoteRow> Losers = new();
    private readonly List<QuoteRow> MostActive = new();

    private QuoteRow? SelectedQuote =>
        Watchlist.FirstOrDefault(x =>
            string.Equals(x.Symbol, SelectedSymbol, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<QuoteRow> FilteredWatchlist
    {
        get
        {
            IEnumerable<QuoteRow> rows = Watchlist;

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var search = SearchText.Trim();

                rows = rows.Where(x =>
                    x.Symbol.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    CompanyName(x.Symbol).Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            rows = Segment switch
            {
                "Gainers" => rows.Where(x => !double.IsNaN(x.ChangeValue) && x.ChangeValue >= 0),
                "Losers" => rows.Where(x => !double.IsNaN(x.ChangeValue) && x.ChangeValue < 0),
                _ => rows
            };

            return rows;
        }
    }

    private IEnumerable<QuoteRow> CurrentMovers =>
        MoverTab switch
        {
            "Top Losers" => Losers,
            "Active" => MostActive,
            _ => Gainers
        };

    private IEnumerable<DiscoveryRow> HeatmapItems
    {
        get
        {
            if (string.Equals(
                    HeatmapTab,
                    "Discovery",
                    StringComparison.OrdinalIgnoreCase))
            {
                // Discovery is backed by the real /api/discover response.
                // It is currently available for the Stocks universe.
                if (ActiveAsset == "Stocks")
                    return Discovery.Take(12);

                return Enumerable.Empty<DiscoveryRow>();
            }

            // Market always shows the current live quote universe.
            return Watchlist
                .Take(8)
                .Select(x =>
                    new DiscoveryRow(
                        x.Symbol,
                        x.Change,
                        x.ChangeValue,
                        "Live quote"));
        }
    }

    private string ChartToneClass =>
        ChartPoints.Count < 2 || ChartPoints[^1] >= ChartPoints[0]
            ? "ptm-positive"
            : "ptm-negative";

    private string ChartPolylinePoints =>
        BuildPolyline(ChartPoints, 1000d, 300d, 18d);

    private string ChartAreaPath
    {
        get
        {
            if (ChartPoints.Count < 2)
                return string.Empty;

            var points = BuildPolyline(ChartPoints, 1000d, 300d, 18d);
            return $"M {points.Replace(" ", " L ")} L 1000 300 L 0 300 Z";
        }
    }

    private double HitRectWidth =>
        ChartCandles.Count <= 1
            ? 1000d
            : 1000d / ChartCandles.Count;

    private double HitRectX(int index) =>
        Math.Max(
            0d,
            (1000d * index / Math.Max(ChartCandles.Count - 1d, 1d)) -
            HitRectWidth / 2d);

    private double HoverX =>
        HoveredCandleIndex.HasValue && ChartCandles.Count > 1
            ? 18d +
              ((1000d - 36d) *
               HoveredCandleIndex.Value /
               (ChartCandles.Count - 1d))
            : 18d;

    private double HoverY
    {
        get
        {
            if (HoveredCandle is null || ChartPoints.Count == 0)
                return 150d;

            var min = ChartPoints.Min();
            var max = ChartPoints.Max();
            var span = Math.Max(max - min, 0.000001d);
            var normalized = (HoveredCandle.Close - min) / span;

            return 18d + (300d - 36d) * (1d - normalized);
        }
    }

