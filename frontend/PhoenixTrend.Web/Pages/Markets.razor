    private async Task LoadChart()
    {
        ChartPoints.Clear();
        ChartCandles.Clear();
        HoveredCandleIndex = null;

        // IMPORTANT:
        // The FastAPI endpoint accepts "range" and "timeframe".
        // It does NOT accept "limit".
        //
        // Yahoo interval/range combinations must also be valid:
        // 5m cannot be requested against a 3M range.
        var configuration = SelectedTimeframe switch
        {
            "1D" => ("1D", "5M"),
            "1W" => ("5D", "15M"),
            "1M" => ("1M", "60M"),
            "3M" => ("3M", "1D"),
            "1Y" => ("1Y", "1D"),
            "5Y" => ("5Y", "1D"),
            _ => ("3M", "1D")
        };

        var root = await Api.ChartRange(
            SelectedSymbol,
            configuration.Item1,
            configuration.Item2);

        if (root is null)
            return;

        var array = FindArray(
            root.Value,
            "value",
            "candles",
            "bars",
            "history",
            "results",
            "items",
            "data");

        if (!array.HasValue)
            return;

        foreach (var item in array.Value.EnumerateArray())
        {
            if (item.ValueKind == JsonValueKind.Number &&
                item.TryGetDouble(out var number))
            {
                ChartPoints.Add(number);
                continue;
            }

            if (item.ValueKind != JsonValueKind.Object)
                continue;

            var close = FirstNumber(
                item,
                "close",
                "c",
                "price");

            if (!close.HasValue)
                continue;

            var open =
                FirstNumber(item, "open", "o") ??
                close.Value;

            var high =
                FirstNumber(item, "high", "h") ??
                close.Value;

            var low =
                FirstNumber(item, "low", "l") ??
                close.Value;

            var volume =
                FirstNumber(item, "volume", "v") ??
                0d;

            var time =
                FirstNumber(item, "time", "t") ??
                0d;

            ChartCandles.Add(
                new CandleRow(
                    time,
                    open,
                    high,
                    low,
                    close.Value,
                    volume));

            ChartPoints.Add(close.Value);
        }
    }

    private async Task LoadContext()
    {
        SelectedContext = await Api.Context(SelectedSymbol);

        SelectedMarketCap = FirstNumberDeep(
