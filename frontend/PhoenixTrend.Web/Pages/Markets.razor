    private async Task ChangeAsset(string asset)
    {
        if (string.Equals(
                ActiveAsset,
                asset,
                StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        ActiveAsset = asset;

        if (ActiveAsset != "Stocks" &&
            string.Equals(
                HeatmapTab,
                "Discovery",
                StringComparison.OrdinalIgnoreCase))
        {
            HeatmapTab = "Market";
        }

        SearchText = string.Empty;
        Segment = "All Segments";
        SelectedTimeframe = "1D";

        Watchlist.Clear();
        Discovery.Clear();
        NewsItems.Clear();
        ChartPoints.Clear();
        ChartCandles.Clear();
        HoveredCandleIndex = null;

        var firstSymbol = CurrentSymbols.FirstOrDefault();

        if (!string.IsNullOrWhiteSpace(firstSymbol))
            SelectedSymbol = firstSymbol;

        Loading = true;
        ErrorMessage = string.Empty;

        try
        {
            await LoadWatchlist();

            if (ActiveAsset == "Stocks")
                await LoadDiscovery();

            BuildMovers();

            if (!Watchlist.Any(x =>
                    string.Equals(
                        x.Symbol,
                        SelectedSymbol,
                        StringComparison.OrdinalIgnoreCase)))
            {
                SelectedSymbol =
                    Watchlist.FirstOrDefault()?.Symbol ??
                    firstSymbol ??
                    "AAPL";
            }

            await Task.WhenAll(
                LoadChart(),
                LoadNews(),
                LoadContext(),
                LoadStatisticsHistory());
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            ErrorMessage =
                $"Some {ActiveAsset} market data could not be loaded.";
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task LoadAll()
    {
        if (Loading)
            return;

        Loading = true;
        ErrorMessage = string.Empty;

        try
        {
            await Task.WhenAll(
                LoadWatchlist(),
                LoadIndices());

            if (ActiveAsset == "Stocks")
                await LoadDiscovery();

            BuildMovers();

            if (!Watchlist.Any(x => x.Symbol == SelectedSymbol))
                SelectedSymbol = Watchlist.FirstOrDefault()?.Symbol ?? "AAPL";

            await Task.WhenAll(
                LoadChart(),
                LoadNews(),
                LoadContext(),
                LoadStatisticsHistory());
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            ErrorMessage = "Some market data could not be loaded.";
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task LoadWatchlist()
    {
        var tasks = CurrentSymbols.Select(async symbol =>
        {
            var quote = await Api.Quote(symbol);

            return quote is null
                ? new QuoteRow(symbol, "—", "—", double.NaN, double.NaN, 0, null)
                : BuildQuote(symbol, quote);
        });

        var rows = await Task.WhenAll(tasks);

        Watchlist.Clear();
        Watchlist.AddRange(rows);
    }

    private QuoteRow BuildQuote(string symbol, JsonElement? root)
    {
        var price = FirstNumber(root, "price", "last", "last_price");
        var previousClose = FirstNumber(root, "previous_close", "previousClose");
        var changeAmount = FirstNumber(root, "change", "price_change");
        var changePercent = FirstNumber(
            root,
            "change_percent",
            "changePercent",
            "change_pct",
            "percent_change");

        var volume = FirstNumber(root, "volume", "regularMarketVolume") ?? 0;

        if (!changeAmount.HasValue &&
            price.HasValue &&
            previousClose.HasValue)
        {
            changeAmount = price.Value - previousClose.Value;
        }

        if (!changePercent.HasValue &&
            changeAmount.HasValue &&
            previousClose is > 0)
        {
            changePercent =
                changeAmount.Value /
                previousClose.Value *
                100d;
        }

        return new QuoteRow(
            symbol,
            price.HasValue
                ? price.Value.ToString("$#,##0.00", CultureInfo.InvariantCulture)
                : "—",
            changePercent.HasValue
                ? FormatPercent(changePercent.Value)
                : "—",
            changePercent ?? double.NaN,
            changeAmount ?? double.NaN,
            volume,
            previousClose);
    }

    private async Task LoadIndices()
    {
        var definitions = new[]
        {
            new IndexDefinition("S&P 500", "^GSPC"),
            new IndexDefinition("NASDAQ", "^IXIC"),
            new IndexDefinition("DOW JONES", "^DJI"),
            new IndexDefinition("RUSSELL 2000", "^RUT"),
            new IndexDefinition("VIX", "^VIX")
        };

        var tasks = definitions.Select(async definition =>
        {
            var quote = await Api.Quote(definition.Symbol);

            if (quote is null)
            {
                return new IndexRow(
                    definition.Name,
                    definition.Symbol,
                    "—",
                    "—",
                    double.NaN,
                    double.NaN);
            }

            var price = FirstNumber(quote, "price", "last", "last_price");
            var previousClose = FirstNumber(quote, "previous_close", "previousClose");
            var changeAmount = FirstNumber(quote, "change", "price_change");
            var changePercent = FirstNumber(
                quote,
                "change_percent",
                "changePercent",
                "change_pct",
                "percent_change");

            if (!changeAmount.HasValue &&
                price.HasValue &&
                previousClose.HasValue)
            {
                changeAmount = price.Value - previousClose.Value;
            }

            if (!changePercent.HasValue &&
                changeAmount.HasValue &&
                previousClose is > 0)
            {
                changePercent =
                    changeAmount.Value /
                    previousClose.Value *
                    100d;
            }

            return new IndexRow(
                definition.Name,
                definition.Symbol,
                price.HasValue
                    ? price.Value.ToString("#,##0.00", CultureInfo.InvariantCulture)
                    : "—",
                changePercent.HasValue
                    ? FormatPercent(changePercent.Value)
                    : "—",
                changePercent ?? double.NaN,
                changeAmount ?? double.NaN);
        });

        var result = await Task.WhenAll(tasks);

        Indices.Clear();
        Indices.AddRange(result);
    }

    private async Task LoadDiscovery()
    {
        Discovery.Clear();

        var root = await Api.Discover();

        if (root is null)
            return;

        var array = FindArray(
            root.Value,
            "opportunities",
            "results",
            "items",
            "data",
            "discover");

        if (!array.HasValue)
            return;

        foreach (var item in array.Value.EnumerateArray())
        {
            if (item.ValueKind != JsonValueKind.Object)
                continue;

            var symbol = FirstString(item, "symbol", "ticker");

            if (string.IsNullOrWhiteSpace(symbol))
                continue;

            var change = FirstNumber(
                item,
                "change_percent",
                "changePercent",
                "change_pct",
                "percent_change");

            var signal = FirstString(
                item,
                "signal",
                "status",
                "recommendation");

            if (string.IsNullOrWhiteSpace(signal))
                signal = "Watching";

            Discovery.Add(new DiscoveryRow(
                symbol.ToUpperInvariant(),
                change.HasValue
                    ? FormatPercent(change.Value)
                    : "—",
                change ?? double.NaN,
                signal));
        }
    }

    private void BuildMovers()
    {
        Gainers.Clear();
        Losers.Clear();
        MostActive.Clear();

        Gainers.AddRange(
            Watchlist
                .Where(x =>
                    !double.IsNaN(x.ChangeValue) &&
                    x.ChangeValue >= 0)
                .OrderByDescending(x => x.ChangeValue)
                .Take(10));

        Losers.AddRange(
            Watchlist
                .Where(x =>
                    !double.IsNaN(x.ChangeValue) &&
                    x.ChangeValue < 0)
                .OrderBy(x => x.ChangeValue)
                .Take(10));

        MostActive.AddRange(
            Watchlist
                .OrderByDescending(x => x.Volume)
                .Take(10));
    }

    private async Task SelectSymbol(string symbol)
    {
        SelectedSymbol = symbol.Trim().ToUpperInvariant();
        HoveredCandleIndex = null;
        ResetSelectedStatistics();

        if (!Watchlist.Any(x =>
                string.Equals(
                    x.Symbol,
                    SelectedSymbol,
                    StringComparison.OrdinalIgnoreCase)))
        {
            var quote = await Api.Quote(SelectedSymbol);

            if (quote is not null)
            {
                Watchlist.Insert(
                    0,
                    BuildQuote(SelectedSymbol, quote));

                BuildMovers();
            }
        }

        await Task.WhenAll(
            LoadChart(),
            LoadNews(),
            LoadContext());
    }

