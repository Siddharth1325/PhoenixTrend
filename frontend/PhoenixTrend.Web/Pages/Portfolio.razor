@page "/portfolio"

@inject PhoenixApi Api

<PageTitle>PhoenixTrend | Portfolio</PageTitle>

<div class="pt-portfolio">


<section class="pt-market-hero">
    <div class="pt-market-hero-copy">
        <h1>Portfolio</h1>
        <p>Track your holdings, P&L, performance and account health.</p>
    </div>
    <button class="pt-market-refresh" type="button" @onclick="Load" disabled="@Loading">
        <i class="ph ph-arrows-clockwise"></i>
        @(Loading ? "Refreshing" : "Refresh")
    </button>
</section>


<div class="tabbar">

    @foreach (var tab in Tabs)
    {
        <button
            class="@(ActiveTab == tab ? "active" : "")"
            @onclick="() => SelectTab(tab)">

            <i class="ph-duotone @GetTabIcon(tab)"></i>
            <span>@tab</span>

        </button>
    }

</div>


@if (Loading)
{
    <div class="connect-message">
        Loading portfolio...
    </div>
}


@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="connect-message">
        @ErrorMessage
    </div>
}


<!-- =========================================================
     TOP METRICS
     ========================================================= -->

<div class="metric-grid four">

    <MetricCard
        Icon="ph ph-wallet"
        Label="Total Portfolio Value"
        Value="@PortfolioValue"
        Detail="@PortfolioDetail" />

    <MetricCard
        Icon="ph ph-chart-line-up"
        Label="Day P&L"
        Value="@DayPnl"
        Detail="@DayPnlPercent" />

    <MetricCard
        Icon="ph ph-trend-up"
        Label="Total P&L"
        Value="@TotalPnl"
        Detail="@TotalPnlPercent" />

    <MetricCard
        Icon="ph ph-coins"
        Label="Buying Power"
        Value="@BuyingPower"
        Detail="@($"Cash {CashBalance}")"
        Tone="orange" />

</div>


<!-- =========================================================
     OVERVIEW
     ========================================================= -->

@if (ActiveTab == "Overview")
{
    <div class="portfolio-layout">

        <Panel
            Title="Portfolio Performance"
            Class="span-2">

            <div class="hero-chart">

                <div class="chart-grid"></div>

                @if (EquityPoints.Count > 1)
                {
                    <svg viewBox="0 0 900 260" preserveAspectRatio="none">
                        <polyline class="line" fill="none" points="@BuildPolyline(EquityPoints, 900, 260)" />
                    </svg>
                }
                else
                {
                    <div class="portfolio-chart-empty">
                        Historical equity-series data is not currently available.
                    </div>
                }

            </div>


            <div class="performance-kpis">

                <span>
                    <b>
                        @TotalPnlPercent
                    </b>

                    Total Return
                </span>


                <span>
                    <b>
                        @TotalPnl
                    </b>

                    Total P&amp;L
                </span>


                <span>
                    <b>
                        @WinRate
                    </b>

                    Win Rate
                </span>


                <span>
                    <b>
                        @ProfitFactor
                    </b>

                    Profit Factor
                </span>


                <span>

                    <b class="red">
                        @MaxDrawdown
                    </b>

                    Max Drawdown

                </span>

            </div>

        </Panel>


        <Panel Title="Asset Allocation">

            @if (AllocationRows.Count > 0)
            {
                <div class="donut">
                    <div>
                        <b>@PortfolioValueShort</b>
                        <small>Total Value</small>
                    </div>
                </div>
            }
            else
            {
                <div class="allocation-empty">
                    <i class="ph ph-chart-donut"></i>
                    <strong>No open-position allocation</strong>
                    <small>Allocation will appear when the connected broker has positions.</small>
                </div>
            }


            <div class="legend">

                @if (AllocationRows.Count == 0)
                {
                    <span>
                        <i class="c1"></i>
                        No allocation data
                        <b>—</b>
                    </span>
                }
                else
                {
                    @for (var i = 0; i < AllocationRows.Count; i++)
                    {
                        var row = AllocationRows[i];

                        <span>

                            <i class="@GetLegendClass(i)">
                            </i>

                            @row.Name

                            <b>
                                @row.Percent
                            </b>

                        </span>
                    }
                }

            </div>

        </Panel>


        <Panel
            Title="Top Holdings"
            Class="span-2">

            <table class="data-table">
    <thead>
        <tr>
            <th>Symbol</th>
            <th>Name</th>
            <th>Qty</th>
            <th>Avg Price</th>
            <th>Current</th>
            <th>Market Value</th>
            <th>P&amp;L</th>
            <th>P&amp;L %</th>
        </tr>
    </thead>
    <tbody>
        @if (Positions.Count == 0)
        {
            <tr>
                <td colspan="8">No positions available.</td>
            </tr>
        }
        else
        {
            @foreach (var position in Positions)
            {
                <tr>
                    <td><strong>@position.Symbol</strong></td>
                    <td>@position.Name</td>
                    <td>@position.Quantity</td>
                    <td>@position.AvgPrice</td>
                    <td>@position.CurrentPrice</td>
                    <td>@position.MarketValue</td>
                    <td class="@GetValueClass(position.Pnl)">@position.Pnl</td>
                    <td class="@GetValueClass(position.PnlPercent)">@position.PnlPercent</td>
                </tr>
            }
        }
    </tbody>
</table>

        </Panel>


        <Panel Title="Sector Allocation">

            <div class="bar-list">

                @if (SectorRows.Count == 0)
                {
                    <div>
                        <span>No sector data</span>
                        <i style="--w:0%"></i>
                        <b>—</b>
                    </div>
                }
                else
                {
                    @foreach (var sector in SectorRows)
                    {
                        <div>

                            <span>
                                @sector.Name
                            </span>

                            <i style="@($"--w:{sector.Width}%")">
                            </i>

                            <b>
                                @sector.Percent
                            </b>

                        </div>
                    }
                }

            </div>

        </Panel>

    </div>
}


