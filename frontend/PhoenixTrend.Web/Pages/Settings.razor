    // BROKER ACTIONS
    // =========================================================

    private void OpenBrokerConnection()
    {
        Navigation.NavigateTo(
            "/connect"
        );
    }


    private async Task DisconnectBroker()
    {
        if (BrokerActionRunning)
        {
            return;
        }


        try
        {
            BrokerActionRunning = true;

            StatusMessage =
                "Disconnecting broker...";


            var result =
                await Api.DisconnectBroker();


            if (result is null)
            {
                StatusMessage =
                    "Broker disconnect request failed.";

                return;
            }


            StatusMessage =
                "Broker disconnected.";


            await LoadAfterBrokerAction();
        }
        finally
        {
            BrokerActionRunning = false;
        }
    }


    private async Task LoadAfterBrokerAction()
    {
        var broker =
            await Api.BrokerStatus();


        ParseBrokerStatus(
            broker
        );


        if (!_brokerConnected)
        {
            BrokerAccountId = "—";

            PortfolioValue = "—";

            BuyingPower = "—";

            PositionCount = "0";
        }
    }


