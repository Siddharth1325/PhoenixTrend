    }


    private async Task SaveEditor()
    {
        if (EditorStrategy is null ||
            EditorValues.Count == 0)
        {
            return;
        }


        var values =
            new Dictionary<string, object>(
                StringComparer.OrdinalIgnoreCase
            );


        foreach (var item in
                 EditorValues)
        {
            if (double.TryParse(
                    item.Value,
                    NumberStyles.Float,
                    CultureInfo.InvariantCulture,
                    out var number))
            {
                values[
                    item.Key
                ] =
                    number;

                continue;
            }


            if (bool.TryParse(
                    item.Value,
                    out var boolean))
            {
                values[
                    item.Key
                ] =
                    boolean;

                continue;
            }


            values[
                item.Key
            ] =
                item.Value;
        }


        var result =
            await Api.ConfigureStrategy(
                EditorStrategy.Name,
                values
            );


        if (result is null)
        {
            ErrorMessage =
                "Strategy configuration could not be saved.";

            return;
        }


        EditorOpen =
            false;

        EditorStrategy =
            null;

        await LoadStrategies();
    }


