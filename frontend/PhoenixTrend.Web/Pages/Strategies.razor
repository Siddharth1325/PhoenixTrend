    private static string DisplayStatus(
        StrategyView strategy)
    {
        if (strategy.Running == true)
        {
            return
                "Running";
        }


        if (strategy.Enabled == true)
        {
            return
                "Enabled";
        }


        if (strategy.Enabled == false)
        {
            return
                "Disabled";
        }


        if (!string.IsNullOrWhiteSpace(
                strategy.Status))
        {
            return
                Humanize(
                    strategy.Status
                );
        }


        return
            "Unavailable";
    }


    private static string StatusClass(
        StrategyView strategy)
    {
        var status =
            DisplayStatus(
                strategy
            );


        if (Contains(
                status,
                "running") ||
            Contains(
                status,
                "enabled") ||
            Contains(
                status,
                "active"))
        {
            return
                "green";
        }


        if (Contains(
                status,
                "error") ||
            Contains(
                status,
                "failed") ||
            Contains(
                status,
                "rejected"))
        {
            return
                "red";
        }


        return
            "muted";
    }


    private static bool IsActive(
        StrategyView strategy)
    {
        if (strategy.Enabled.HasValue)
        {
            return
                strategy.Enabled.Value;
        }


        var status =
            DisplayStatus(
                strategy
            );


        return
            Contains(
                status,
                "active"
            ) ||
            Contains(
                status,
                "running"
            ) ||
            Contains(
                status,
                "enabled"
            );
    }


    private static bool IsRunning(
        StrategyView strategy)
    {
        if (strategy.Running.HasValue)
        {
            return
                strategy.Running.Value;
        }


        return
            Contains(
                DisplayStatus(
                    strategy
                ),
                "running"
            );
    }


    private static string ValueClass(
        decimal? value)
    {
        if (!value.HasValue)
        {
            return
                string.Empty;
        }


        if (value.Value > 0)
        {
            return
                "green";
        }


        if (value.Value < 0)
        {
            return
                "red";
        }


        return
            string.Empty;
    }


    private static string FormatPercent(
        decimal? value)
    {
        if (!value.HasValue)
        {
            return
                "—";
        }


        var number =
            value.Value;


        if (Math.Abs(
                number) <= 1m)
        {
            number *=
                100m;
        }


        return
            $"{number:0.##}%";
    }


    private static string FormatMoney(
        decimal? value)
    {
        if (!value.HasValue)
        {
            return
                "—";
        }


        if (value.Value > 0)
        {
            return
                $"+${value.Value:N2}";
        }


        if (value.Value < 0)
        {
            return
                $"-${Math.Abs(value.Value):N2}";
        }


        return
            "$0.00";
    }


    private static string FormatNumber(
        decimal? value)
    {
        return
            value.HasValue
                ? value.Value.ToString(
                    "0.##",
                    CultureInfo.InvariantCulture
                )
                : "—";
    }


    private static string DisplayText(
        string? value)
    {
        return
            string.IsNullOrWhiteSpace(
                value)
                ? "—"
                : value;
    }


