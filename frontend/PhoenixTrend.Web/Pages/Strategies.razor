    protected override async Task OnInitializedAsync()
    {
        await LoadStrategies();
    }


    private async Task LoadStrategies()
    {
        if (Loading)
        {
            return;
        }

        Loading = true;

        ErrorMessage =
            string.Empty;

        try
        {
            var strategiesTask =
                Api.Strategies();

            var engineTask =
                Api.EngineStatus();

            await Task.WhenAll(
                strategiesTask,
                engineTask
            );

            ParseStrategies(
                await strategiesTask
            );

            ParseEngineStatus(
                await engineTask
            );

            if (SelectedStrategy is null &&
                StrategyItems.Count > 0)
            {
                SelectedStrategy =
                    StrategyItems[0];
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                ex
            );

            ErrorMessage =
                "PhoenixTrend could not load strategy data from the backend.";
        }
        finally
        {
            Loading = false;
        }
    }


    private void ParseStrategies(
        JsonElement? response)
    {
        StrategyItems.Clear();

        if (response is null)
        {
            return;
        }

        if (!TryGetStrategyArray(
                response.Value,
                out var array))
        {
            return;
        }

        foreach (var element in
                 array.EnumerateArray())
        {
            if (element.ValueKind !=
                JsonValueKind.Object)
            {
                continue;
            }


            var name =
                ReadString(
                    element,
                    "name",
                    "strategy_name",
                    "strategy",
                    "id"
                );

            if (string.IsNullOrWhiteSpace(
                    name))
            {
                continue;
            }


            var category =
                ReadString(
                    element,
                    "category",
                    "type",
                    "strategy_type"
                );

            if (string.IsNullOrWhiteSpace(
                    category))
            {
                category =
                    InferCategory(
                        name
                    );
            }


            var id =
                ReadString(
                    element,
                    "id",
                    "strategy_id"
                );

            if (string.IsNullOrWhiteSpace(
                    id))
            {
                id =
                    NormalizeId(
                        name
                    );
            }


            var status =
                ReadString(
                    element,
                    "status",
                    "state"
                );


            var enabled =
                ReadBoolean(
                    element,
                    "enabled",
                    "active"
                );


            var running =
                ReadBoolean(
                    element,
                    "running"
                );


            JsonElement performance =
                default;

            var hasPerformance =
                element.TryGetProperty(
                    "performance",
                    out performance
                ) &&
                performance.ValueKind ==
                JsonValueKind.Object;


            var totalReturn =
                ReadDecimal(
                    element,
                    "total_return",
                    "return",
                    "return_pct",
                    "return_percent"
                );


            if (!totalReturn.HasValue &&
                hasPerformance)
            {
                totalReturn =
                    ReadDecimal(
                        performance,
                        "total_return",
                        "return",
                        "return_pct",
                        "return_percent"
                    );
            }


            decimal? winRate =
                null;

            decimal? profitFactor =
                null;

            decimal? totalPnl =
                null;

            var totalTrades =
                0;


            if (hasPerformance)
            {
                winRate =
                    ReadDecimal(
                        performance,
                        "win_rate"
                    );

                profitFactor =
                    ReadDecimal(
                        performance,
                        "profit_factor"
                    );

                totalPnl =
                    ReadDecimal(
                        performance,
                        "realized_pnl",
                        "total_pnl",
                        "pnl"
                    );

                totalTrades =
                    ReadInt(
                        performance,
                        "trades",
                        "total_trades",
                        "trade_count"
                    );
            }


            var timeframe =
                ReadString(
                    element,
                    "timeframe"
                );


            var markets =
                ReadStringOrArray(
                    element,
                    "markets",
                    "market",
                    "symbols"
                );


            var indicators =
                ReadStringOrArray(
                    element,
                    "indicators"
                );


            var riskPerTrade =
                ReadDecimal(
                    element,
                    "risk_per_trade",
                    "risk_pct",
                    "risk_percent"
                );


            var description =
                ReadString(
                    element,
                    "description",
                    "summary"
                );


            var editingSupported =
                ReadBoolean(
                    element,
                    "editing_supported",
                    "editable",
                    "configuration_editable"
                ) ?? false;


            var defaults =
                ReadConfiguration(
                    element,
                    "default_configuration"
                );


            var configured =
                ReadConfiguration(
                    element,
                    "configuration"
                );


            var custom =
                ReadBoolean(
                    element,
                    "custom"
                ) ?? false;


            StrategyItems.Add(
                new StrategyView
                {
                    Id =
                        id,

                    Name =
                        name,

                    Category =
                        category,

                    Status =
                        status,

                    Enabled =
                        enabled,

                    Running =
                        running,

                    TotalReturn =
                        totalReturn,

                    WinRate =
                        winRate,

                    ProfitFactor =
                        profitFactor,

                    TotalPnl =
                        totalPnl,

                    TotalTrades =
                        totalTrades,

                    Timeframe =
                        timeframe,

                    Markets =
                        markets,

                    Indicators =
                        indicators,

                    RiskPerTrade =
                        riskPerTrade,

                    Description =
                        description,

                    EditingSupported =
                        editingSupported,

                    DefaultConfiguration =
                        defaults,

                    Configuration =
                        configured,

                    Custom =
                        custom
                }
            );
        }


        if (SelectedStrategy is not null)
        {
            SelectedStrategy =
                StrategyItems.FirstOrDefault(
                    strategy =>
                        string.Equals(
                            strategy.Id,
                            SelectedStrategy.Id,
                            StringComparison.OrdinalIgnoreCase
                        )
                );
        }
    }


    private void ParseEngineStatus(
        JsonElement? response)
    {
        if (response is null)
        {
            EngineStatusText =
                "Engine status unavailable";

            return;
        }


        var state =
            ReadString(
                response.Value,
                "state",
                "status",
                "mode"
            );


        if (!string.IsNullOrWhiteSpace(
                state))
        {
            EngineStatusText =
                Humanize(
                    state
                );

            return;
        }


        var running =
            ReadBoolean(
                response.Value,
                "running"
            );


        EngineStatusText =
            running switch
            {
                true =>
                    "Engine Running",

                false =>
                    "Engine Stopped",

                _ =>
                    "Engine Available"
            };
    }


    private void SelectCategory(
        string category)
    {
        ActiveTab =
