    private static bool MatchesCategory(
        StrategyView strategy,
        string category)
    {
        if (Contains(
                strategy.Category,
                category))
        {
            return true;
        }


        return category switch
        {
            "Momentum" =>
                Contains(
                    strategy.Name,
                    "momentum"
                ),

            "Breakout" =>
                Contains(
                    strategy.Name,
                    "breakout"
                ),

            "Swing" =>
                Contains(
                    strategy.Name,
                    "swing"
                ),

            "Mean Reversion" =>
                Contains(
                    strategy.Name,
                    "mean"
                ) ||
                Contains(
                    strategy.Name,
                    "reversion"
                ),

            "Options" =>
                Contains(
                    strategy.Name,
                    "option"
                ),

            "Scalping" =>
                Contains(
                    strategy.Name,
                    "scalp"
                ),

            "Trend Following" =>
                Contains(
                    strategy.Name,
                    "trend"
                ),

            "Custom" =>
                strategy.Custom,

            _ =>
                false
        };
    }


