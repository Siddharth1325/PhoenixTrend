    private void ConfigureStrategy(
        StrategyView strategy)
    {
        SelectedStrategy =
            strategy;

        EditorStrategy =
            strategy;


        EditorValues =
            strategy.DefaultConfiguration
                .ToDictionary(
                    item =>
                        item.Key,

                    item =>
                        strategy.Configuration.TryGetValue(
                            item.Key,
                            out var configuredValue
                        )
                            ? configuredValue
                            : item.Value,

                    StringComparer.OrdinalIgnoreCase
                );


        foreach (var configured in
                 strategy.Configuration)
        {
            if (!EditorValues.ContainsKey(
                    configured.Key))
            {
                EditorValues[
                    configured.Key
                ] =
                    configured.Value;
            }
        }


        EditorOpen =
            true;
    }


