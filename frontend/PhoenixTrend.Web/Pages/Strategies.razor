    private async Task ToggleStrategy(
        StrategyView strategy)
    {
        if (!strategy.Enabled.HasValue)
        {
            ErrorMessage =
                "The backend did not expose an enabled state for this strategy.";

            return;
        }


        JsonElement? result;


        if (strategy.Enabled.Value)
        {
            result =
                await Api.DisableStrategy(
                    strategy.Name
                );
        }
        else
        {
            result =
                await Api.EnableStrategy(
                    strategy.Name
                );
        }


        if (result is null)
        {
            ErrorMessage =
                "Strategy state could not be updated.";

            return;
        }


        await LoadStrategies();
    }


    private async Task CreateCustom()
    {
        if (string.IsNullOrWhiteSpace(
                CustomName) ||
            string.IsNullOrWhiteSpace(
                CustomBase))
        {
            return;
        }


        var result =
            await Api.CreateCustomStrategy(
                CustomName.Trim(),
                CustomBase,
                new Dictionary<string, object>()
            );


        if (result is null)
        {
            ErrorMessage =
                "Custom strategy could not be created. Check the name and try again.";

            return;
        }


        CreateOpen =
            false;


        await LoadStrategies();
    }


    private static Dictionary<string, string> ReadConfiguration(
        JsonElement element,
        string property)
    {
        var result =
            new Dictionary<string, string>(
                StringComparer.OrdinalIgnoreCase
            );


        if (!TryGetPropertyIgnoreCase(
                element,
                property,
                out var config) ||
            config.ValueKind !=
            JsonValueKind.Object)
        {
            return result;
        }


        foreach (var item in
                 config.EnumerateObject())
        {
            result[
                item.Name
            ] =
                item.Value.ToString();
        }


        return result;
    }


