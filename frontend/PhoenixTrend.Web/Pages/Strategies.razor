@page "/strategies"

@using System.Globalization
@using System.Text.Json
@using PhoenixTrend.Web.Services

@inject PhoenixApi Api

<PageTitle>PhoenixTrend | Strategies</PageTitle>

<div class="pt-strategies">

    <section class="strategies-hero">
        <div class="strategies-hero-content">

            <div class="strategies-hero-copy">

                <span class="hero-eyebrow">
                    <i class="ph ph-strategy"></i>
                    PHOENIXTREND STRATEGY ENGINE
                </span>

                <h1>Strategies</h1>

                <p>
                    Build, analyze and deploy systematic trading strategies
                    through the PhoenixTrend execution engine.
                </p>

            </div>

        </div>
    </section>


    <section class="strategy-tabs-shell">

        <div class="strategy-tabs">

            @foreach (var tab in Tabs)
            {
                <button type="button"
                        class="strategy-tab @(ActiveTab == tab.Name ? "active" : "")"
                        @onclick="() => SelectCategory(tab.Name)">

                    <i class="@tab.Icon"></i>

                    <span>
                        @tab.Name
                    </span>

                </button>
            }

        </div>

    </section>


    <section class="strategy-action-bar">

        <div class="strategy-search-box">

            <i class="ph ph-magnifying-glass"></i>

            <input @bind="SearchText"
                   @bind:event="oninput"
                   placeholder="Search strategies" />

        </div>

        <button type="button"
                class="strategy-primary-action"
                @onclick="OpenCreate">

            <i class="ph ph-plus"></i>

            Create Strategy

        </button>

    </section>


    @if (Loading)
    {
        <div class="strategy-message loading">

            <i class="ph ph-spinner-gap spin"></i>

            <div>

                <strong>
                    Loading Strategies
                </strong>

                <span>
                    Connecting to the PhoenixTrend strategy engine...
                </span>

            </div>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="strategy-message error">

            <i class="ph ph-warning-circle"></i>

            <div>

                <strong>
                    Strategy Data Unavailable
                </strong>

                <span>
                    @ErrorMessage
                </span>

            </div>

        </div>
    }


    <section class="strategy-summary-grid">

        <article class="strategy-summary-card">

            <div class="summary-icon cyan">
                <i class="ph ph-stack"></i>
            </div>

            <div class="summary-content">

                <span>
                    Total Strategies
                </span>

                <strong>
                    @StrategyItems.Count
                </strong>

                <small>
                    @ActiveCount Enabled · @InactiveCount Disabled
                </small>

            </div>

        </article>


        <article class="strategy-summary-card">

            <div class="summary-icon green">
                <i class="ph ph-currency-dollar"></i>
            </div>

            <div class="summary-content">

                <span>
                    Strategy P&amp;L
                </span>

                <strong class="@ValueClass(TotalPnl)">
                    @FormatMoney(TotalPnl)
                </strong>

                <small>
                    @(HasPnlData
                        ? "Recorded strategy performance"
                        : "Awaiting strategy performance")
                </small>

            </div>

        </article>


        <article class="strategy-summary-card">

            <div class="summary-icon green">
                <i class="ph ph-chart-line-up"></i>
            </div>

            <div class="summary-content">

                <span>
                    Average Win Rate
                </span>

                <strong>
                    @FormatPercent(AverageWinRate)
                </strong>

                <small>
                    @(HasWinRateData
                        ? "Across strategies with trade history"
                        : "Awaiting strategy performance")
                </small>

            </div>

        </article>


        <article class="strategy-summary-card">

            <div class="summary-icon purple">
                <i class="ph ph-arrows-left-right"></i>
            </div>

            <div class="summary-content">

                <span>
                    Total Trades
                </span>

                <strong>
                    @TotalTrades.ToString("N0")
                </strong>

                <small>
                    Across available strategies
                </small>

            </div>

        </article>


        <article class="strategy-summary-card">

            <div class="summary-icon orange">
                <i class="ph ph-lightning"></i>
            </div>

            <div class="summary-content">

                <span>
                    Running Strategies
                </span>

                <strong class="orange-value">
                    @RunningCount/@StrategyItems.Count
                </strong>

                <small>
                    @EngineStatusText
                </small>

            </div>

        </article>

    </section>


    <section class="strategy-workspace">

        <section class="strategy-library-panel">

            <header class="panel-header">

                <div>

                    <span class="panel-kicker">

                        <i class="ph ph-books"></i>

                        STRATEGY LIBRARY

                    </span>

                    <h2>
                        Strategy Library
                    </h2>

                    <p>
                        Real strategies registered with the PhoenixTrend backend.
                    </p>

                </div>

                <div class="panel-count">

                    <i class="ph ph-stack"></i>

                    <span>
                        @FilteredStrategies.Count
                    </span>

                </div>

            </header>


            @if (!Loading && FilteredStrategies.Count == 0)
            {
                <div class="strategy-empty">

                    <div class="strategy-empty-icon">
                        <i class="ph ph-magnifying-glass"></i>
                    </div>

                    <strong>
                        No Strategies Found
                    </strong>

                    <span>
                        No strategies are available in this category.
                    </span>

                </div>
            }
            else
            {
                <div class="strategy-grid">

                    @foreach (var strategy in FilteredStrategies)
                    {
                        <article class="strategy-card @(IsSelected(strategy) ? "selected" : "")"
                                 @onclick="() => SelectStrategy(strategy)">

                            <div class="strategy-card-accent"></div>


                            @* =====================================================
                               TOP ROW
                               ICON LEFT
                               ENABLE/DISABLE SWITCH RIGHT
                               ===================================================== *@

                            <header class="pt-strategy-card-top">

                                <div class="pt-strategy-card-icon">

                                    <i class="@StrategyIcon(strategy)"></i>

                                </div>


                                @if (strategy.Enabled.HasValue)
                                {
                                    <button type="button"
                                            class="pt-strategy-card-toggle @(strategy.Enabled.Value ? "enabled" : "disabled")"
                                            title="@(strategy.Enabled.Value ? "Disable strategy" : "Enable strategy")"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => ToggleStrategy(strategy)">

                                        <span class="pt-strategy-toggle-state">
                                            @(strategy.Enabled.Value
                                                ? "Enabled"
                                                : "Disabled")
                                        </span>

                                        <span class="pt-strategy-switch @(strategy.Enabled.Value ? "on" : "off")">

                                            <span class="pt-strategy-switch-light"></span>

                                            <span class="pt-strategy-switch-knob"></span>

                                        </span>

                                    </button>
                                }
                                else
                                {
                                    <div class="pt-strategy-card-toggle unavailable">

                                        <span class="pt-strategy-toggle-state">
                                            Unavailable
                                        </span>

                                        <span class="pt-strategy-switch off">

                                            <span class="pt-strategy-switch-light"></span>

                                            <span class="pt-strategy-switch-knob"></span>

                                        </span>

                                    </div>
                                }

                            </header>


                            @* =====================================================
                               TEXT AREA
                               TITLE / CATEGORY / DESCRIPTION ARE SEPARATE
                               ===================================================== *@

                            <div class="pt-strategy-card-copy">

                                <strong class="pt-strategy-card-title">
                                    @strategy.Name
                                </strong>

                                <span class="pt-strategy-card-category">
                                    @strategy.Category
                                </span>

                                <p class="pt-strategy-card-description">
                                    @StrategyDescription(strategy)
                                </p>

                            </div>


                            @* =====================================================
                               PERFORMANCE
                               ===================================================== *@

                            <div class="strategy-visual">

                                <div class="strategy-chart-label">

                                    <div>

                                        <span>
                                            REALIZED P&amp;L
                                        </span>

                                        <small>
                                            Persisted trades
                                        </small>

                                    </div>

                                    <strong class="@ValueClass(strategy.TotalPnl)">
                                        @(strategy.TotalPnl.HasValue
                                            ? FormatMoney(strategy.TotalPnl)
                                            : "Awaiting data")
                                    </strong>

                                </div>


                                @if (strategy.HasPerformance)
                                {
                                    <div class="strategy-visual-value">

                                        <i class="ph ph-chart-line-up"></i>

                                        <div>

                                            <strong class="@ValueClass(strategy.TotalPnl)">
                                                @FormatMoney(strategy.TotalPnl)
                                            </strong>

                                            <span>
                                                @strategy.TotalTrades.ToString("N0")
                                                closed
                                                @(strategy.TotalTrades == 1 ? "trade" : "trades")
                                            </span>

                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <div class="strategy-visual-empty">

                                        <i class="ph ph-chart-line"></i>

                                        <span>
                                            No closed trades recorded
                                        </span>

                                    </div>
                                }

                            </div>


                            @* =====================================================
                               METRICS
                               ===================================================== *@

                            <div class="strategy-card-metrics">

                                <div class="strategy-card-metric">

                                    <span>
                                        Total Return
                                    </span>

                                    <strong class="@ValueClass(strategy.TotalReturn)">
                                        @FormatPercent(strategy.TotalReturn)
                                    </strong>

                                </div>


                                <div class="strategy-card-metric">

                                    <span>
                                        Win Rate
                                    </span>

                                    <strong>
                                        @FormatPercent(strategy.WinRate)
                                    </strong>

                                </div>


                                <div class="strategy-card-metric">

                                    <span>
                                        Profit Factor
                                    </span>

                                    <strong>
                                        @FormatNumber(strategy.ProfitFactor)
                                    </strong>

                                </div>

                            </div>


                            @* =====================================================
                               ACTIONS
                               NO BOTTOM ENABLE/DISABLE BUTTON
                               ===================================================== *@

                            <footer class="strategy-card-actions"
                                    @onclick:stopPropagation="true">

                                <button type="button"
                                        class="strategy-configure-button"
                                        @onclick="() => ConfigureStrategy(strategy)">

                                    <i class="ph ph-sliders-horizontal"></i>

                                    Configure

                                </button>


                                <button type="button"
                                        class="strategy-secondary-action"
                                        @onclick="() => ViewStrategyDetails(strategy)">

                                    <i class="ph ph-eye"></i>

                                    View Details

                                </button>

                            </footer>

                        </article>
                    }

                </div>
            }

        </section>


        @* =========================================================
           INSPECTOR
           ========================================================= *@

        <aside class="strategy-inspector">

            @if (SelectedStrategy is null)
            {
                <div class="inspector-empty">

                    <div class="inspector-empty-icon">
                        <i class="ph ph-cursor-click"></i>
                    </div>

                    <h3>
                        Select a Strategy
                    </h3>

                    <p>
                        Choose a strategy from the library to inspect its
                        configuration and performance.
                    </p>

                </div>
            }
            else
            {
                <header class="inspector-header">

                    <div class="inspector-title-row">

                        <div class="inspector-strategy-icon">

                            <i class="@StrategyIcon(SelectedStrategy)"></i>

                        </div>

                        <div>

                            <span class="inspector-eyebrow">
                                STRATEGY INSPECTOR
                            </span>

                            <h2>
                                @SelectedStrategy.Name
                            </h2>

                            <span class="inspector-category">
                                @SelectedStrategy.Category
                            </span>

                        </div>

                    </div>


                    <span class="strategy-status @StatusClass(SelectedStrategy)">

                        <span class="status-dot"></span>

                        @DisplayStatus(SelectedStrategy)

                    </span>

                </header>


                <div class="inspector-description">

                    <i class="ph ph-info"></i>

                    <p>
                        @StrategyDescription(SelectedStrategy)
                    </p>

                </div>


                <section class="inspector-section">

                    <header class="inspector-section-header">

                        <div>

                            <i class="ph ph-chart-line-up"></i>

                            <span>
                                Performance
                            </span>

                        </div>

                        <small>
                            Persisted trades
                        </small>

                    </header>


                    <div class="inspector-kpis">

                        <div class="inspector-kpi">

                            <span>
                                Total Return
                            </span>

                            <strong class="@ValueClass(SelectedStrategy.TotalReturn)">
                                @FormatPercent(SelectedStrategy.TotalReturn)
                            </strong>

                        </div>


                        <div class="inspector-kpi">

                            <span>
                                Win Rate
                            </span>

                            <strong>
                                @FormatPercent(SelectedStrategy.WinRate)
                            </strong>

                        </div>


                        <div class="inspector-kpi">

                            <span>
                                Profit Factor
                            </span>

                            <strong>
                                @FormatNumber(SelectedStrategy.ProfitFactor)
                            </strong>

                        </div>

                    </div>


                    <div class="inspector-chart">

                        <div class="inspector-chart-header">

                            <div>

                                <span>
                                    Realized P&amp;L
                                </span>

                                <small>
                                    @(SelectedStrategy.HasPerformance
                                        ? "Recorded performance"
                                        : "Performance unavailable")
                                </small>

                            </div>

                        </div>


                        @if (!SelectedStrategy.HasPerformance)
                        {
                            <div class="inspector-performance-empty">

                                <i class="ph ph-chart-line"></i>

                                <strong>
                                    No closed trades recorded
                                </strong>

                                <span>
                                    Performance will appear when real trades close.
                                </span>

                            </div>
                        }
                        else
                        {
                            <div class="inspector-performance-state">

                                <i class="ph ph-chart-line-up"></i>

                                <strong class="@ValueClass(SelectedStrategy.TotalPnl)">
                                    @FormatMoney(SelectedStrategy.TotalPnl)
                                </strong>

                                <span>
                                    @SelectedStrategy.TotalTrades.ToString("N0")
                                    closed
                                    @(SelectedStrategy.TotalTrades == 1 ? "trade" : "trades")
                                </span>

                            </div>
                        }

                    </div>

                </section>


                <section class="inspector-section">

                    <header class="inspector-section-header">

                        <div>

                            <i class="ph ph-sliders-horizontal"></i>

                            <span>
                                Configuration
                            </span>

                        </div>

                    </header>


                    <div class="strategy-detail-list">

                        <div class="strategy-detail-row">

                            <div>

                                <i class="ph ph-pulse"></i>

                                <span>
                                    Status
                                </span>

                            </div>

                            <strong>
                                @DisplayStatus(SelectedStrategy)
                            </strong>

                        </div>


                        <div class="strategy-detail-row">

                            <div>

                                <i class="ph ph-tag"></i>

                                <span>
                                    Category
                                </span>

                            </div>

                            <strong>
                                @SelectedStrategy.Category
                            </strong>

                        </div>


                        <div class="strategy-detail-row">

                            <div>

                                <i class="ph ph-arrows-left-right"></i>

                                <span>
                                    Trades
                                </span>

                            </div>

                            <strong>
                                @SelectedStrategy.TotalTrades.ToString("N0")
                            </strong>

                        </div>


                        <div class="strategy-detail-row">

                            <div>

                                <i class="ph ph-clock"></i>

                                <span>
                                    Timeframe
                                </span>

                            </div>

                            <strong>
                                @DisplayText(SelectedStrategy.Timeframe)
                            </strong>

                        </div>


                        <div class="strategy-detail-row">

                            <div>

                                <i class="ph ph-globe"></i>

                                <span>
                                    Markets
                                </span>

                            </div>

                            <strong>
                                @DisplayText(SelectedStrategy.Markets)
                            </strong>

                        </div>


                        <div class="strategy-detail-row">

                            <div>

                                <i class="ph ph-function"></i>

                                <span>
                                    Indicators
                                </span>

                            </div>

                            <strong>
                                @DisplayText(SelectedStrategy.Indicators)
                            </strong>

                        </div>


                        <div class="strategy-detail-row">

                            <div>

                                <i class="ph ph-shield-check"></i>

                                <span>
                                    Risk per Trade
                                </span>

                            </div>

                            <strong>
                                @FormatPercent(SelectedStrategy.RiskPerTrade)
                            </strong>

                        </div>

                    </div>

                </section>


                @if (!SelectedStrategy.EditingSupported)
                {
                    <div class="strategy-backend-notice">

                        <div class="backend-notice-icon">

                            <i class="ph ph-lock-key"></i>

                        </div>

                        <div>

                            <strong>
                                Configuration Locked
                            </strong>

                            <span>
                                Strategy editing is not exposed by the backend.
                            </span>

                        </div>

                    </div>


                    <button type="button"
                            class="strategy-configure-button inspector-main-action"
                            disabled>

                        <i class="ph ph-sliders-horizontal"></i>

                        Strategy Editing Not Exposed

                    </button>
                }
                else
                {
                    <button type="button"
                            class="strategy-primary-action inspector-main-action"
                            @onclick="() => ConfigureStrategy(SelectedStrategy)">

                        <i class="ph ph-pencil-simple"></i>

                        Edit Strategy

                    </button>
                }


                @if (SelectedStrategy.Enabled.HasValue)
                {
                    <button type="button"
                            class="strategy-configure-button inspector-toggle-action"
                            @onclick="() => ToggleStrategy(SelectedStrategy)">

                        <i class="ph ph-power"></i>

                        @(SelectedStrategy.Enabled.Value
                            ? "Disable Strategy"
                            : "Enable Strategy")

                    </button>
                }

            }

        </aside>

    </section>


    @* =========================================================
       CONFIGURATION MODAL
       ========================================================= *@

    @if (EditorOpen && EditorStrategy is not null)
    {
        <div class="strategy-modal-backdrop"
             @onclick="CloseEditor">

            <section class="strategy-modal"
                     @onclick:stopPropagation="true">

                <div class="strategy-modal-glow"></div>

                <header>

                    <div>

                        <span class="panel-kicker">
                            STRATEGY CONFIGURATION
                        </span>

                        <h2>
                            @EditorStrategy.Name
                        </h2>

                    </div>

                    <button type="button"
                            title="Close"
                            @onclick="CloseEditor">

                        <i class="ph ph-x"></i>

                    </button>

                </header>


                @if (EditorValues.Count == 0)
                {
                    <div class="strategy-backend-notice">

                        <div class="backend-notice-icon">

                            <i class="ph ph-info"></i>

                        </div>

                        <div>

                            <strong>
                                No Editable Parameters
                            </strong>

                            <span>
                                The backend has not returned editable configuration
                                values for this strategy.
                            </span>

                        </div>

                    </div>
                }
                else
                {
                    <div class="strategy-config-grid">

                        @foreach (var key in EditorValues.Keys.ToList())
                        {
                            <label>

                                <span>
                                    @Humanize(key)
                                </span>

                                <input value="@EditorValues[key]"
                                       @oninput="e => EditorValues[key] = e.Value?.ToString() ?? string.Empty" />

                            </label>
                        }

                    </div>
                }


                <footer>

                    <div>

                        <button type="button"
                                class="strategy-configure-button"
                                @onclick="ResetEditor">

                            <i class="ph ph-arrow-counter-clockwise"></i>

                            Reset Defaults

                        </button>


                        @if (EditorStrategy.Custom)
                        {
                            <button type="button"
                                    class="strategy-danger-action"
                                    @onclick="DeleteCustom">

                                <i class="ph ph-trash"></i>

                                Delete Custom

                            </button>
                        }

                    </div>


                    <button type="button"
                            class="strategy-primary-action"
                            disabled="@(EditorValues.Count == 0)"
                            @onclick="SaveEditor">

                        <i class="ph ph-floppy-disk"></i>

                        Save Configuration

                    </button>

                </footer>

            </section>

        </div>
    }


    @* =========================================================
       CREATE STRATEGY MODAL
       ========================================================= *@

    @if (CreateOpen)
    {
        <div class="strategy-modal-backdrop"
             @onclick="CloseCreate">

            <section class="strategy-modal"
                     @onclick:stopPropagation="true">

                <div class="strategy-modal-glow"></div>

                <header>

                    <div>

                        <span class="panel-kicker">
                            CUSTOM STRATEGY
                        </span>

                        <h2>
                            Create Strategy
                        </h2>

                    </div>

                    <button type="button"
                            title="Close"
                            @onclick="CloseCreate">

                        <i class="ph ph-x"></i>

                    </button>

                </header>


                <div class="strategy-config-grid">

                    <label>

                        <span>
                            Name
                        </span>

                        <input @bind="CustomName"
                               placeholder="My Strategy" />

                    </label>


                    <label>

                        <span>
                            Base Strategy
                        </span>

                        <select @bind="CustomBase">

                            @foreach (var item in StrategyItems.Where(x => !x.Custom))
                            {
                                <option value="@item.Name">
                                    @item.Name
                                </option>
                            }

                        </select>

                    </label>

                </div>


                <p class="strategy-modal-note">
                    The custom strategy uses the selected registered strategy
                    implementation and can be configured independently when
                    backend editing support is available.
                </p>


                <footer>

                    <div>

                        <button type="button"
                                class="strategy-secondary-action"
                                @onclick="CloseCreate">

                            Cancel

                        </button>

                    </div>


                    <button type="button"
                            class="strategy-primary-action"
                            disabled="@string.IsNullOrWhiteSpace(CustomName)"
                            @onclick="CreateCustom">

                        <i class="ph ph-plus"></i>

                        Create Strategy

                    </button>

                </footer>

            </section>

        </div>
    }

</div>


@code {

    private bool Loading;

    private string ErrorMessage = string.Empty;

    private string ActiveTab = "All Strategies";

    private string EngineStatusText =
        "Engine status unavailable";

    private string SearchText =
        string.Empty;

    private bool EditorOpen;

    private bool CreateOpen;

    private StrategyView? EditorStrategy;

    private StrategyView? SelectedStrategy;

    private Dictionary<string, string> EditorValues =
        new();

    private string CustomName =
        string.Empty;

    private string CustomBase =
        "Momentum";


    /*
     * The component class is named Strategies.
     * Do not name this collection "Strategies" because that
     * causes CS0542.
     */
    private readonly List<StrategyView> StrategyItems =
        new();


    private readonly StrategyTab[] Tabs =
    {
        new(
            "All Strategies",
            "ph ph-stack"
        ),

        new(
            "Momentum",
            "ph ph-trend-up"
        ),

        new(
            "Breakout",
            "ph ph-arrow-square-out"
        ),

        new(
            "Swing",
            "ph ph-wave-sine"
        ),

        new(
            "Mean Reversion",
            "ph ph-arrows-left-right"
        ),

        new(
            "Options",
            "ph ph-chart-donut"
        ),

        new(
            "Scalping",
            "ph ph-lightning"
        ),

        new(
            "Trend Following",
            "ph ph-chart-line-up"
        ),

        new(
            "Custom",
            "ph ph-sliders-horizontal"
        )
    };


    private List<StrategyView> FilteredStrategies
    {
        get
        {
            var items =
                StrategyItems.AsEnumerable();

            if (ActiveTab !=
                "All Strategies")
            {
                items =
                    ActiveTab == "Custom"
                        ? items.Where(
                            strategy =>
                                strategy.Custom
                        )
                        : items.Where(
                            strategy =>
                                MatchesCategory(
                                    strategy,
                                    ActiveTab
                                )
                        );
            }

            if (!string.IsNullOrWhiteSpace(
                    SearchText))
            {
                items =
                    items.Where(
                        strategy =>
                            strategy.Name.Contains(
                                SearchText,
                                StringComparison.OrdinalIgnoreCase
                            ) ||
                            strategy.Category.Contains(
                                SearchText,
                                StringComparison.OrdinalIgnoreCase
                            )
                    );
            }

            return items.ToList();
        }
    }


    private int ActiveCount =>
        StrategyItems.Count(
            strategy =>
                IsActive(strategy)
        );


    private int InactiveCount =>
        Math.Max(
            0,
            StrategyItems.Count -
            ActiveCount
        );


    private int RunningCount =>
        StrategyItems.Count(
            strategy =>
                IsRunning(strategy)
        );


    private int TotalTrades =>
        StrategyItems.Sum(
            strategy =>
                strategy.TotalTrades
        );


    private bool HasPnlData =>
        StrategyItems.Any(
            strategy =>
                strategy.TotalPnl.HasValue
        );


    private decimal? TotalPnl
    {
        get
        {
            var values =
                StrategyItems
                    .Where(
                        strategy =>
                            strategy.TotalPnl.HasValue
                    )
                    .Select(
                        strategy =>
                            strategy.TotalPnl!.Value
                    )
                    .ToList();

            return values.Count == 0
                ? null
                : values.Sum();
